{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datarelay.link/schemas/release-manifest.schema.json",
  "title": "Data Relay Link Release Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "project_version",
    "frp_version",
    "channel",
    "git_ref",
    "source_head",
    "features",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project_version": {
      "type": "string",
      "description": "Data Relay Link product version (SemVer core MAJOR.MINOR.PATCH).",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "frp_version": {
      "type": "string",
      "description": "Independently pinned upstream fatedier/frp (Relay Engine) version.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "channel": {
      "type": "string",
      "enum": ["development", "preview", "stable"]
    },
    "git_ref": {
      "type": "string",
      "description": "Immutable source ref used for release-line identity (SHA, tag, or explicit main tip).",
      "minLength": 1
    },
    "source_head": {
      "type": "string",
      "description": "Exact 40-character Git SHA of the qualified source tree.",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "immutable_source_ref": {
      "type": "string",
      "description": "Optional explicit immutable tag or SHA when distinct from git_ref."
    },
    "features": {
      "type": "object",
      "required": ["mcp_included"],
      "additionalProperties": true,
      "properties": {
        "mcp_included": {
          "type": "boolean",
          "description": "Whether MCP runtime/commands are included in this release line."
        }
      }
    },
    "qualification": {
      "type": "object",
      "description": "Stable-release qualification evidence pointers (required conceptually for stable).",
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "url_path": { "type": "string" },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "owner": { "type": "string" },
    "repo": { "type": "string" },
    "https_raw_base": { "type": "string" },
    "signing": { "type": "boolean" },
    "integrity": { "type": "object" },
    "sbom": { "type": "object" },
    "provenance": { "type": "object" },
    "checksum_file": { "type": "string" },
    "supported_frp_versions": { "type": "object" },
    "supply_chain": { "type": "object" },
    "note": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "channel": { "const": "stable" } },
        "required": ["channel"]
      },
      "then": {
        "required": ["qualification"],
        "properties": {
          "git_ref": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "qualification": {
            "type": "object",
            "additionalProperties": true,
            "required": ["status", "pass1_head", "pass2_head", "final_qualified_head"],
            "not": {
              "properties": { "real_e2e": { "const": "pending" } },
              "required": ["real_e2e"]
            },
            "properties": {
              "status": { "const": "PASS" },
              "pass1_head": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$"
              },
              "pass2_head": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$"
              },
              "final_qualified_head": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$"
              }
            }
          }
        }
      }
    }
  ]
}
