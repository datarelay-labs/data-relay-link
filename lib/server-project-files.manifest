# Canonical server project-file manifest.
# Columns: class dest mode source validate
# class:
#   project          replaceable management software (install + project-update + snapshot)
#   optional         same, installed only when the source exists
#   unit             systemd unit (always installed; updated by project-update)
#   unit-single443   systemd unit only for single443 deployments
#   generated        persisted generated configuration (snapshot/install rollback only)
#   binary           pinned FRP runtime binary (not a project-update target)
#   version          version metadata (written after a verified success)
#   protected        persistent protected state (never replaced by project-update)
#   protected-prefix persistent protected directory prefix
# validate: python | bash | none
#
# Lock order for operations that take multiple locks:
#   1. server-lifecycle.lock
#   2. control-state.lock
#   3. registry.lock

project usr/local/lib/drlink/frp-port-allocator.py 0700 server/frp-port-allocator.py python
project usr/local/lib/drlink/frp-access-plugin.py 0700 server/frp-access-plugin.py python
