def resolve_zero_touch_ssh(ssh_user, ssh_port, port_explicit, user_explicit=False):
    ssh_user = normalize_ssh_user(ssh_user)
    if user_explicit or ssh_user or not is_interactive_stdin():
        # An explicit --ssh-user, including blank, was already collected.
        # Non-interactive empty ssh_user stays optional (<username> examples).
        return ssh_user, ssh_port
    return prompt_zero_touch_ssh('', ssh_port, port_explicit)


def _allocator_hostname(cfg):
    if not isinstance(cfg, dict):
        return ''
    try:
        return (urlparse(str(cfg.get('allocator_public_url') or '')).hostname or '').lower().rstrip('.')
    except Exception:
        return ''


def _short_url_needs_embedded_ca(cfg):
    """True when the short URL host is this server's private-CA identity.

    A distinct bootstrap_hostname is an operator public-TLS edge and keeps
    stock curl. The enrollment hostname itself presents the project private CA.
    """
    boot = str((cfg or {}).get('bootstrap_hostname') or '').strip().lower().rstrip('.')
    if not boot:
        return True
    alloc_host = _allocator_hostname(cfg)
    return bool(alloc_host) and boot == alloc_host


def _public_ca_pem(cfg):
    """Return the public allocator CA PEM, never a private key."""
    if not isinstance(cfg, dict):
        return ''
    raw = str(cfg.get('tls_ca_cert') or '').strip()
    if not raw:
        return ''
    path = remap(raw)
    try:
        text = path.read_text(encoding='utf-8')
    except OSError:
        return ''
    if 'PRIVATE KEY' in text or 'BEGIN CERTIFICATE' not in text:
        return ''
    return text.strip() + '\n'


