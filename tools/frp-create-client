    )



def _is_official_raw_installer_url(url, windows=False):
    suffix = 'bootstrap-client.ps1' if windows else 'bootstrap-client.sh'
    prefix = (
        'https://raw.githubusercontent.com/datarelay-labs/data-relay-link/'
    )
    if not str(url or '').startswith(prefix):
        return False
    return str(url).endswith('/dist/' + suffix)


def resolve_configured_installer_url(cfg, *, windows=False):
    """Prefer exact SOURCE_REF for official GitHub raw defaults.

    Explicit non-default overrides are preserved. Premature vPROJECT_VERSION
    URLs on an exact-SHA install are rewritten to the installed SOURCE_REF.
    """
    key = 'windows_client_installer_url' if windows else 'client_installer_url'
    configured = str(cfg.get(key, '') or '').strip()
    default_fn = (
        default_windows_client_installer_url if windows else default_client_installer_url
    )
    default = default_fn()
    if not configured:
        return default
    ref = installed_source_ref()
    ver = installed_project_version()
    premature = '/v%s/' % ver
    if (
        ref
        and len(ref) >= 40
        and all(c in '0123456789abcdefABCDEF' for c in ref)
        and _is_official_raw_installer_url(configured, windows=windows)
        and premature in configured
    ):
        return default
    return configured


def preflight_installer_url(url, *, label='Client installer'):
    """Bounded read-only preflight. Confirmed 404 blocks; uncertain does not."""
    import ssl
    import urllib.error
    import urllib.request

    url = str(url or '').strip()
    if not url:
        return
    req = urllib.request.Request(url, method='HEAD')
    req.add_header('User-Agent', 'DataRelayLink-InstallerPreflight/2.4')
    ctx = ssl.create_default_context()
    try:
        with urllib.request.urlopen(req, timeout=5, context=ctx) as resp:
            code = getattr(resp, 'status', None) or resp.getcode()
            if int(code) == 404:
                raise SystemExit(
                    '%s is unavailable:\n\n'
                    '  %s\n\n'
                    'HTTP status: 404\n\n'
                    'Fix:\n'
                    '  set server installer-url <URL>\n'
                    '  set server windows-installer-url <URL>\n\n'
                    'No enrollment ticket was created.' % (label, url)
                )
            return
    except urllib.error.HTTPError as exc:
        if int(getattr(exc, 'code', 0) or 0) == 404:
            raise SystemExit(
                '%s is unavailable:\n\n'
                '  %s\n\n'
                'HTTP status: 404\n\n'
                'Fix:\n'
                '  set server installer-url <URL>\n\n'
                'No enrollment ticket was created.' % (label, url)
            ) from None
        # Non-404 HTTP: inconclusive for destroyer semantics.
        return
    except Exception:
        # Network/TLS/timeout: do not block ticket issuance.
        return


