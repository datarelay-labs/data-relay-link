def installed_project_version():
    """Authoritative project version for installer URL guidance.

    Never invent a version. Missing env and version files fail closed.
    """
    env = str(os.environ.get('PROJECT_VERSION') or '').strip()
    if env:
        return env
    for candidate in (
        remap('/etc/drlink/version'),
        Path(__file__).resolve().parent.parent / 'VERSION',
    ):
        try:
            text = Path(candidate).read_text(encoding='utf-8')
        except OSError:
            continue
        for line in text.splitlines():
            if line.startswith('PROJECT_VERSION='):
                value = line.split('=', 1)[1].strip()
                if value:
                    return value
    raise SystemExit('installed project version unavailable')


def installed_release_channel():
    env = str(os.environ.get('FRP_RELEASE_CHANNEL') or '').strip().lower()
    if env in ('development', 'dev', 'main'):
        return 'development'
    if env in ('preview', 'rc', 'candidate', 'prerelease'):
        return 'preview'
    if env == 'stable':
        return 'stable'
    for candidate in (
        remap('/etc/drlink/version'),
        Path(__file__).resolve().parent.parent / 'VERSION',
    ):
        try:
            text = Path(candidate).read_text(encoding='utf-8')
        except OSError:
            continue
        for line in text.splitlines():
            if line.startswith('RELEASE_CHANNEL='):
                value = line.split('=', 1)[1].strip().lower()
                if value in ('development', 'dev', 'main'):
                    return 'development'
                if value in ('preview', 'rc', 'candidate', 'prerelease'):
                    return 'preview'
                if value == 'stable':
                    return 'stable'
    return ''


def installed_source_ref():
    """Install provenance ref (commit SHA or release tag), never PROJECT_VERSION."""
    env = str(os.environ.get('FRP_EXPECTED_SOURCE_REF') or '').strip()
    if env:
        return env
    for candidate in (
        remap('/etc/drlink/version'),
    ):
        try:
            text = Path(candidate).read_text(encoding='utf-8')
        except OSError:
            continue
        for line in text.splitlines():
            if line.startswith('SOURCE_REF='):
                value = line.split('=', 1)[1].strip()
                if value:
                    return value
    return ''


