    scfg = load_server_config()
    if scfg is not None and isinstance(cfg, dict):
        try:
            host = scfg.short_url_hostname(cfg)
        except Exception:
            host = ''
        if host:
            return str(host).strip().lower()
        return ''
    return str(bootstrap_hostname or public_hostname or '').strip().lower()


