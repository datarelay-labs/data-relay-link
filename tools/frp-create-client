def print_one_line(ticket, ttl, note, public_host, control_public, allocator, ca_fp, installer, ssh_user, ssh_port, client_name='', management_only=False, ticket_id='', legacy_env=False, bootstrap_hostname='', public_hostname='', cfg=None, short_handle=''):
    tracking_id = str(ticket_id or '').strip()
    if not tracking_id and ticket:
        zt_id = _zt()
        if zt_id is not None:
            tracking_id = zt_id.bootstrap_record_id(ticket)

    # DNS public_url_host still uses /i/<ticket>, but that host presents the
    # project private CA. Embed the public CA in the one-liner and verify TLS.
    # A distinct bootstrap_hostname is the operator public-TLS edge and keeps
    # stock curl. Never fall through to curl --insecure for this path.
    command = ''
    bootstrap_host = short_url_host_for_cfg(
        cfg, bootstrap_hostname=bootstrap_hostname, public_hostname=public_hostname
    )
    if bootstrap_host and not legacy_env:
        try:
            zt = _zt()
            if zt is None:
                raise ValueError('zero-touch helper is unavailable')
            if _short_url_needs_embedded_ca(cfg):
                pem = _public_ca_pem(cfg)
                if not pem:
                    fail(
                        'allocator CA certificate is not available; '
                        'cannot generate a fresh-client Zero-Touch command'
                    )
                command = zt.private_ca_fresh_client_command(
                    bootstrap_host, short_handle or ticket, pem
                )
            else:
                command = zt.short_url_command(bootstrap_host, short_handle or ticket)
        except ValueError:
            if _short_url_needs_embedded_ca(cfg):
                fail(
                    'cannot generate a fresh-client Zero-Touch command '
                    'without disabling TLS verification'
                )
            command = ''

    if not command:
        try:
            package = encode_zero_touch_package(allocator, ca_fp, ticket)
            zt_mod = _zt()
            if zt_mod is not None:
                command = zt_mod.pinned_ca_linux_command(
                    installer, allocator, ca_fp, package
                )
            else:
                command = 'curl -fsSL %s | sudo bash -s -- %s' % (
                    shell_quote(installer),
                    shell_quote(package),
                )
        except ValueError:
            legacy_env = True

    if legacy_env or not command:
        env_parts = [
            'FRP_ALLOCATOR_URL=%s' % shell_quote(allocator),
            'FRP_ALLOCATOR_CA_SHA256=%s' % shell_quote(ca_fp),
            'FRP_BOOTSTRAP_TICKET=%s' % shell_quote(ticket),
            'FRP_ZERO_TOUCH=1',
        ]
        if ssh_user:
            env_parts.append('FRP_SSH_USER=%s' % shell_quote(ssh_user))
        if ssh_port and int(ssh_port) != 22:
            env_parts.append('FRP_SSH_PORT=%s' % shell_quote(str(int(ssh_port))))
        if management_only:
            env_parts.append('FRP_MANAGEMENT_ONLY=1')
        command = 'curl -fsSL %s | sudo env %s bash' % (
            shell_quote(installer),
            ' '.join(env_parts),
        )

    print()
    print('Zero-touch client command')
    print('=========================')
    print()
    print('This command contains a short-lived one-time bootstrap ticket.')
    print('Treat the command as sensitive until it expires or is used.')
    print('This credential will not be shown again.')
    print()
    if tracking_id:
        print('Enrollment ID: %s' % tracking_id)
        print()
    print(command)
    print()
    print('Expires: %s (%s seconds)' % (iso(int(time.time()) + ttl), ttl))
    if client_name:
        print('Managed Host name: %s' % client_name)
    if note:
        print('Note: %s' % note)
    if public_host and control_public:
        print('Data Relay Link Server: %s:%s' % (public_host, control_public))
    if bootstrap_host and '/i/' in command:
        print('Bootstrap host: %s' % bootstrap_host)
    print()
    print('Send that single line to the remote user. They paste it and press Enter.')
    print('No Enrollment Code prompt or extra configuration is required.')
    if management_only:
        print('This enrolls management identity only; no service or public port is created.')
    print()
    print('The ticket is not the FRP token. It cannot manage the client after enrollment.')
    print('It cannot be reused by another machine once bound.')
    if tracking_id:
        print()
        for line in _enrollment_track_hints(tracking_id):
            print(line)
    print()


def main(argv=None):
    a = parse_args(argv)
    zero_touch = bool(a.one_line)
    ttl_raw = a.ttl
    if ttl_raw is None or str(ttl_raw).strip() == '':
        ttl_raw = ZERO_TOUCH_DEFAULT_TTL if zero_touch else '600'
    try:
        ttl = parse_enrollment_ttl(ttl_raw, zero_touch=zero_touch)
    except ValueError as exc:
        fail(str(exc))

    if a.ssh_user and not a.ssh:
        fail('--ssh-user requires --ssh')
    if a.ssh_port is not None and not a.ssh:
        fail('--ssh-port requires --ssh')
    if a.rdp_port is not None and not a.rdp:
        fail('--rdp-port requires --rdp')
    if sum(bool(v) for v in (a.ssh, a.rdp, a.services_file)) > 1:
        fail('use only one of --ssh, --rdp, or --services-file')
    if (a.ssh or a.rdp or a.services_file) and not a.one_line:
        fail('--ssh, --rdp, and --services-file require --one-line')
    platform = str(a.platform or 'linux').strip().lower()
    if platform == 'windows' and not a.one_line:
        fail('--platform windows requires --one-line')
    if a.rdp and platform != 'windows':
        fail('--rdp requires --platform windows')

    ssh_port = 22
    port_explicit = a.ssh_port is not None
    if port_explicit:
        ssh_port = coerce_port(a.ssh_port)
        if ssh_port is None:
            fail('invalid --ssh-port; must be an integer 1-65535')
    ssh_user_explicit = a.ssh_user is not None
    ssh_user = normalize_ssh_user(a.ssh_user)
    rdp_port = 3389
    if a.rdp_port is not None:
        rdp_port = coerce_port(a.rdp_port)
        if rdp_port is None:
            fail('invalid --rdp-port; must be an integer 1-65535')

    cfg = json.loads(Path(CONFIG).read_text())
    require_onboarding_config(cfg)
    enroll_dir = remap(cfg['enrollments_dir'])
    enroll_dir.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(str(enroll_dir), 0o700)
    except OSError:
        pass

    public_host = cfg_public_host(cfg)
    control_public = cfg_frp_control_public_port(cfg)
    allocator = str(cfg.get('allocator_public_url', '') or '').strip()
    ca_path = remap(str(cfg.get('tls_ca_cert') or '/etc/drlink/pki/ca.crt'))
    ca_fp = fingerprint_from_cert(ca_path) if ca_path.is_file() else ''
    if platform == 'windows':
        installer = resolve_configured_installer_url(cfg, windows=True)
        installer_label = 'Windows client installer URL'
    else:
        installer = resolve_configured_installer_url(cfg, windows=False)
        installer_label = 'client installer URL'

    reject_control_chars('--note', a.note)
    reject_control_chars('--client-name', a.client_name)
    reject_control_chars('allocator public URL', allocator)
    reject_control_chars(installer_label, installer)
    reject_control_chars('--ssh-user', ssh_user)
    client_name = str(a.client_name or '').strip()
    note = str(a.note or '')
    if client_name:
        client_name, err = validate_prompt_label(client_name)
        if err:
            fail(err)
    if len(note) > 1024:
        fail('note must be at most 1024 characters')

    if not a.one_line:
        enrollment_id = secrets.token_hex(8)
        secret = secrets.token_hex(32)
        record, _path = write_enrollment(
            enroll_dir, enrollment_id, secret, ttl, note, label=client_name
        )
        run_enrollment_retention_cleanup(cfg)
        print_manual(cfg, record, ttl, public_host, control_public, allocator, ca_fp, installer)
        try:
            here = Path(__file__).resolve()
            for path in (
                here.parent.parent / 'lib' / 'frp_audit.py',
                Path('/usr/local/lib/drlink/frp_audit.py'),
            ):
                if path.is_file():
                    spec = importlib.util.spec_from_file_location('frp_audit', str(path))
                    audit = importlib.util.module_from_spec(spec)
                    spec.loader.exec_module(audit)
                    audit.try_emit(
                        'enrollment.created',
                        details={'mode': 'manual', 'label': client_name, 'enrollment_id': enrollment_id},
                    )
                    break
        except Exception:
            pass
        return 0

    if a.ssh and not ssh_user and not is_interactive_stdin():
        # Optional connection-example metadata; enrollment proceeds without it.
        ssh_user = ''

    if not installer:
        if platform == 'windows':
            fail(
                'Windows client installer URL is not configured; '
                'set windows-installer-url <URL> before creating a Windows Zero-Touch client'
            )
        fail(
            'client installer URL is not configured; '
            'run: set installer-url <URL>'
        )
    if not allocator:
        fail('allocator public URL is not configured; cannot generate a zero-touch command')
    if not allocator.lower().startswith('https://'):
        fail('allocator public URL must be HTTPS')
    if not ca_fp:
        fail('allocator CA SHA256 fingerprint is not available; cannot generate a secure command')

    alloc_mod = load_allocator()
    if alloc_mod is None:
        fail('allocator module is missing')

    # Identification is collected once. When --client-name was already supplied
    # (guided wrapper), accept a blank --note without a second prompt.
    if is_interactive_stdin() and not client_name:
        client_name, note = prompt_client_identification(None, None)
        reject_control_chars('--client-name', client_name)
        reject_control_chars('--note', note)

    rdp_local = None
    if a.ssh:
        ssh_user, ssh_port = resolve_zero_touch_ssh(
            ssh_user, ssh_port, port_explicit, user_explicit=ssh_user_explicit
        )
        if ssh_user:
            reject_control_chars('--ssh-user', ssh_user)
        raw_services = [ssh_service(ssh_user, ssh_port)]
    elif a.rdp:
        raw_services = [rdp_service(rdp_port)]
        rdp_local = rdp_port
    else:
        raw_services = load_services_file(a.services_file) if a.services_file else []

    try:
        services = alloc_mod.normalize_services(raw_services)
    except alloc_mod.ServiceValidationError as exc:
        fail(str(exc))

    ssh_user, ssh_pre_port = first_ssh_preflight(services)
    print_client_configuration(client_name, note, services=services, ssh_user=ssh_user, ssh_port=ssh_pre_port)
    if not confirm_client_setup():
        return 0

    installer_label = 'Windows client installer' if platform == 'windows' else 'Client installer'
    preflight_installer_url(installer, label=installer_label)

    bootstrap_cfg = str(cfg.get('bootstrap_dir') or '').strip()
    if bootstrap_cfg:
        bootstrap_dir = remap(bootstrap_cfg)
    else:
        bootstrap_dir = enroll_dir.parent / 'bootstrap'

    try:
        ticket, _enroll_record, ticket_record = alloc_mod.issue_bootstrap_ticket(
            enroll_dir,
            bootstrap_dir,
            services,
            ttl,
            note,
            label=client_name,
            cfg=remapped_server_cfg(cfg),
        )
    except Exception as exc:
        if type(exc).__name__ == 'ZeroTouchCapacityError' or 'MAX_ISSUABLE' in str(exc):
            fail(str(exc))
        fail('failed to issue bootstrap ticket: %s' % exc)

    ticket_id = str((ticket_record or {}).get('id') or '')
    short_handle = ''
    stage1_sha256 = ''
    if isinstance(ticket_record, dict):
        short_handle = str(ticket_record.pop('_short_handle', '') or '')
        renderer = ticket_record.get('windows_renderer') or {}
        if isinstance(renderer, dict):
            stage1_sha256 = str(renderer.get('stage1_sha256') or '')
    bootstrap_hostname = str(cfg.get('bootstrap_hostname') or '').strip()
    public_hostname = str(cfg.get('public_hostname') or '').strip()
    if platform == 'windows':
        print_one_line_windows(
            ticket,
            ttl,
            note,
            public_host,
            control_public,
            allocator,
            ca_fp,
            installer,
            rdp_port=rdp_local,
            client_name=client_name,
            management_only=not services,
            ticket_id=ticket_id,
            bootstrap_hostname=bootstrap_hostname,
            public_hostname=public_hostname,
            cfg=cfg,
            short_handle=short_handle,
            stage1_sha256=stage1_sha256,
        )
    else:
        print_one_line(
            ticket,
            ttl,
            note,
            public_host,
            control_public,
            allocator,
            ca_fp,
            installer,
            ssh_user,
            ssh_pre_port,
            client_name=client_name,
            management_only=not services,
            ticket_id=ticket_id,
            bootstrap_hostname=bootstrap_hostname,
            public_hostname=public_hostname,
            cfg=cfg,
            short_handle=short_handle,
        )
    try:
        here = Path(__file__).resolve()
        for path in (
            here.parent.parent / 'lib' / 'frp_audit.py',
            Path('/usr/local/lib/drlink/frp_audit.py'),
        ):
            if path.is_file():
                spec = importlib.util.spec_from_file_location('frp_audit', str(path))
                audit = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(audit)
                audit.try_emit('enrollment.created', details={'label': client_name})
                break
    except Exception:
        pass
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
