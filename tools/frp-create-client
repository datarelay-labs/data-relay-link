def installed_project_version():
    """Authoritative project version for installer URL guidance (never hard-code)."""
    env = str(os.environ.get('PROJECT_VERSION') or '').strip()
    if env:
        return env
    for candidate in (
        remap('/etc/drlink/version'),
        Path(__file__).resolve().parent.parent / 'VERSION',
    ):
        try:
            text = Path(candidate).read_text(encoding='utf-8')
        except OSError:
            continue
        for line in text.splitlines():
            if line.startswith('PROJECT_VERSION='):
                value = line.split('=', 1)[1].strip()
                if value:
                    return value
    return '2.3.1'


def installed_source_ref():
    """Install provenance ref (commit SHA or release tag), never PROJECT_VERSION."""
    env = str(os.environ.get('FRP_EXPECTED_SOURCE_REF') or '').strip()
    if env:
        return env
    for candidate in (
        remap('/etc/drlink/version'),
    ):
        try:
            text = Path(candidate).read_text(encoding='utf-8')
        except OSError:
            continue
        for line in text.splitlines():
            if line.startswith('SOURCE_REF='):
                value = line.split('=', 1)[1].strip()
                if value:
                    return value
    return ''


def default_client_installer_url():
    ref = installed_source_ref()
    if not ref:
        ref = 'v%s' % installed_project_version()
    return (
        'https://raw.githubusercontent.com/datarelay-labs/data-relay-link/'
        '%s/dist/bootstrap-client.sh' % ref
    )


def default_windows_client_installer_url():
    ref = installed_source_ref()
    if not ref:
        ref = 'v%s' % installed_project_version()
    return (
        'https://raw.githubusercontent.com/datarelay-labs/data-relay-link/'
