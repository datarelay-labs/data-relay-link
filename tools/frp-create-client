def parse_args(argv=None):
    p = argparse.ArgumentParser(
        description='Create a short-lived Data Relay Link client enrollment code',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            'examples:\n'
            '  sudo drlink create enrollment\n'
            '  sudo drlink create enrollment --one-line --ssh --note client-01\n'
            '  sudo drlink create enrollment --one-line --ssh --ssh-user aella --note customer-01\n'
            '  sudo drlink create enrollment --one-line --ssh --client-name seoul-groupware --note "Seoul office"\n'
            '  sudo drlink create enrollment --one-line --client-name inventory-only\n'
        ),
    )
    p.add_argument('--ttl', type=int, default=600, help='TTL in seconds (default 600)')
    p.add_argument('--note', default='')
    p.add_argument(
        '--client-name',
        '--label',
        dest='client_name',
        default='',
        metavar='NAME',
        help='administrator label seeded at enrollment (does not replace hostname)',
    )
    p.add_argument(
        '--one-line',
        action='store_true',
        help='Print a one-line zero-touch client install command',
    )
    p.add_argument(
        '--ssh',
        action='store_true',
        help='SSH convenience service template (127.0.0.1:22)',
    )
    p.add_argument(
        '--ssh-user',
        default='',
        metavar='USER',
        help=(
            'SSH login account that already exists on the client '
            '(required when stdin is not a TTY; no distro default)'
        ),
    )
    p.add_argument(
        '--ssh-port',
        default=None,
        metavar='PORT',
        help='Local SSH listen port (default 22)',
    )
    p.add_argument(
        '--services-file',
        default='',
        metavar='PATH',
        help='JSON list of services (same schema as FRP_SERVICES_JSON)',
    )
    p.add_argument(
        '--platform',
        choices=('linux', 'windows'),
        default='linux',
        help='Client platform for the one-line command (default: linux)',
    )
    p.add_argument(
        '--rdp',
        action='store_true',
        help='Windows RDP convenience service (custom TCP to 127.0.0.1:3389)',
    )
    p.add_argument(
        '--rdp-port',
        default=None,
        metavar='PORT',
        help='Local RDP listen port (default 3389)',
    )
    return p.parse_args(argv)


