def test_input_lines():
    global _TEST_INPUT_LINES
    if _TEST_INPUT_LINES is None:
        raw = os.environ.get('FRP_CREATE_CLIENT_TEST_INPUT')
        if raw is None:
            _TEST_INPUT_LINES = False
        else:
