def _is_forbidden_public_installer_url(url):
    """Former official DataRelay/fatedier public artifact URLs are forbidden."""
    qa = load_qualified_artifacts()
    if qa is not None and hasattr(qa, 'is_forbidden_public_installer_url'):
        return bool(qa.is_forbidden_public_installer_url(url))
    text = str(url or '').strip().lower()
    if not text:
        return False
    return (
        'raw.githubusercontent.com' in text
        or 'github.com/datarelay-labs' in text
        or 'github.com/fatedier' in text
    )


def _installer_unavailable_message(platform='linux'):
    qa = load_qualified_artifacts()
    plat = 'windows' if str(platform or '').strip().lower() == 'windows' else 'linux'
    arch = 'amd64' if plat == 'windows' else 'any'
    if qa is not None:
        return qa.missing_artifact_error(plat, arch)
    return (
        'ERROR:\n'
        'Required qualified Agent artifact is not available from this DRLink Server.\n'
        '\n'
        'Run:\n'
        '  system diagnostics\n'
        '\n'
        'Reinstall or update the DRLink Server package containing\n'
        'the required qualified artifacts.\n'
        '\n'
        'No changes were applied.\n'
    )


def fail_closed_installer(platform='linux'):
    msg = _installer_unavailable_message(platform)
    sys.stderr.write(msg if str(msg).endswith('\n') else '%s\n' % msg)
    raise SystemExit(2)


def server_local_installer_url(cfg, *, windows=False):
    """Derive the canonical Server-local Agent installer URL. Never public."""
    platform = 'windows' if windows else 'linux'
    qa = load_qualified_artifacts()
    if qa is None:
        fail_closed_installer(platform)
    allocator = str((cfg or {}).get('allocator_public_url') or '').strip()
    try:
        url = qa.agent_installer_url(allocator, platform)
    except Exception:
        fail_closed_installer(platform)
    if not url or _is_forbidden_public_installer_url(url):
        fail_closed_installer(platform)
    return url


def default_client_installer_url(cfg=None):
    """Canonical Server-local Linux Agent installer URL, or empty.

    Never returns a public GitHub/DataRelay/fatedier fallback. Callers that
    must fail closed should use resolve_configured_installer_url().
    """
    if not cfg:
        return ''
    try:
        return server_local_installer_url(cfg, windows=False)
    except SystemExit:
        return ''


def default_windows_client_installer_url(cfg=None):
    """Canonical Server-local Windows Agent installer URL, or empty."""
    if not cfg:
        return ''
    try:
        return server_local_installer_url(cfg, windows=True)
    except SystemExit:
        return ''


def resolve_configured_installer_url(cfg, *, windows=False):
    """Resolve Managed Host installer URL from Server-local artifacts only.

    Configured Server-local and unrelated administrator URLs are preserved.
    Missing URLs and former official public DataRelay/fatedier URLs are
    derived from allocator_public_url. Fail closed if that is impossible.
    """
    platform = 'windows' if windows else 'linux'
    if not isinstance(cfg, dict):
        fail_closed_installer(platform)
    key = 'windows_client_installer_url' if windows else 'client_installer_url'
    configured = str(cfg.get(key, '') or '').strip()
    if configured and not _is_forbidden_public_installer_url(configured):
        return configured
    return server_local_installer_url(cfg, windows=windows)


def preflight_installer_url(url, *, label='Client installer'):
    """Bounded read-only preflight. Confirmed 404 blocks; uncertain does not."""
    import ssl
    import urllib.error
    import urllib.request

    url = str(url or '').strip()
    if not url:
        return
    req = urllib.request.Request(url, method='HEAD')
    req.add_header('User-Agent', 'DataRelayLink-InstallerPreflight/2.4')
    ctx = ssl.create_default_context()
    try:
        with urllib.request.urlopen(req, timeout=5, context=ctx) as resp:
            code = getattr(resp, 'status', None) or resp.getcode()
            if int(code) == 404:
                raise SystemExit(
                    '%s is unavailable:\n\n'
                    '  %s\n\n'
                    'HTTP status: 404\n\n'
                    'Fix:\n'
                    '  set server installer-url <URL>\n'
                    '  set server windows-installer-url <URL>\n'
                    '  set installer-url <URL>\n'
                    '  set windows-installer-url <URL>\n\n'
                    'No enrollment ticket was created.' % (label, url)
                )
            return
    except urllib.error.HTTPError as exc:
        if int(getattr(exc, 'code', 0) or 0) == 404:
                raise SystemExit(
                    '%s is unavailable:\n\n'
                    '  %s\n\n'
                    'HTTP status: 404\n\n'
                    'Fix:\n'
                    '  set server installer-url <URL>\n'
                    '  set server windows-installer-url <URL>\n'
                    '  set installer-url <URL>\n'
                    '  set windows-installer-url <URL>\n\n'
                    'No enrollment ticket was created.' % (label, url)
                ) from None
        # Non-404 HTTP: inconclusive for destroyer semantics.
        return
    except Exception:
        # Network/TLS/timeout: do not block ticket issuance.
        return


