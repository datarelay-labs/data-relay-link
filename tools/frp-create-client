def read_prompt(prompt):
    lines = test_input_lines()
    if lines is not False:
        sys.stdout.write(prompt)
        sys.stdout.flush()
        try:
            value = next(lines)
        except StopIteration:
            fail('required interactive input was not completed')
        sys.stdout.write(value + '\n')
        sys.stdout.flush()
        return value
    try:
        stderr_tty = sys.stderr.isatty()
        stdout_tty = sys.stdout.isatty()
    except Exception:
        stderr_tty = False
        stdout_tty = False
    try:
        # GNU readline writes input() prompts to stderr. When a parent (the
        # REPL via frpctl_run) captures stderr for sanitizing, that prompt is
        # dumped after the child exits and glues onto the next `drlink>` line.
        # Force the prompt onto the live stdout TTY in that case.
        if stdout_tty and not stderr_tty:
            sys.stdout.write(prompt)
            sys.stdout.flush()
            return input()
        # Always pass the prompt to input()/readline so Backspace cannot walk
        # into a separately written prompt prefix.
        return input(prompt)
    except EOFError:
        fail('required interactive input was not completed')


def normalize_ssh_user(raw):
    if raw is None:
        return ''
    return str(raw).strip()


def validate_prompt_ssh_user(raw):
    user = normalize_ssh_user(raw)
    if not user:
        return '', 'SSH username cannot be blank.'
    if any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in user):
        return '', 'SSH username must not contain control characters or newlines'
    if not SSH_USER_RE.fullmatch(user):
        return '', 'invalid ssh_user'
    return user, ''


def validate_prompt_label(raw):
    text = '' if raw is None else str(raw).strip()
    if not text:
        return '', 'Managed Host name cannot be blank.'
    if any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in text):
        return '', 'Managed Host name must not contain control characters or newlines'
    if len(text) > 64:
        return '', 'Managed Host name must be at most 64 characters'
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._ -]{0,63}', text):
        return '', 'invalid Managed Host name'
    return text, ''


def prompt_client_identification(existing_name, existing_note):
    print()
    print('Managed Host details')
    print('====================')
    print()
    print('Enter a name that will help you identify this machine later.')
    print()

    name = '' if existing_name is None else str(existing_name).strip()
    if not name:
        while True:
            entered = read_prompt('Managed Host name: ')
            name, err = validate_prompt_label(entered)
            if name:
                break
            sys.stderr.write('ERROR: %s\n' % err)

    # None means "not collected yet"; empty string means "explicitly blank".
    if existing_note is None:
        entered = read_prompt('Description [optional]: ')
        note = '' if entered is None else str(entered).strip()
        if any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in note):
            fail('Description must not contain control characters or newlines')
        if len(note) > 1024:
            fail('Description must be at most 1024 characters')
    else:
        note = str(existing_note)
    return name, note


def _enrollment_track_hints(tracking_id=''):
    """Canonical enrollment guidance; REPL vs shell-aware."""
    repl = str(os.environ.get('FRP_CTL_REPL') or '').strip() == '1'
    tid = str(tracking_id or '<ID>').strip() or '<ID>'
    prefix = '' if repl else 'sudo drlink '
    lines = [
        'Enrollment lifecycle:',
        '  %sshow enrollments' % prefix,
        '  %sunset enrollment %s' % (prefix, tid),
        '',
        'Active enrollment:',
        '  unset revokes it.',
        '',
        'Completed, expired or revoked enrollment:',
        '  unset removes the retained record.',
    ]
    return lines


def prompt_zero_touch_ssh(existing_user, existing_port, port_explicit):
    print()
    print('SSH service setup')
    print('=================')
    print()
    print('SSH username is optional connection-example metadata.')
    print('It is not required for Agent installation or enrollment.')
    print('Leave blank to show <username> in connection examples.')
    print()

    user = normalize_ssh_user(existing_user)
    if not user:
        while True:
            entered = read_prompt('SSH username [optional]: ')
            if not str(entered or '').strip():
                user = ''
                break
            user, err = validate_prompt_ssh_user(entered)
            if user:
                break
            sys.stderr.write('ERROR: %s\n' % err)

    port = existing_port
    if not port_explicit:
        while True:
            entered = normalize_ssh_user(read_prompt('SSH port [22]: '))
            if not entered:
                port = 22
                break
            port = coerce_port(entered)
            if port is not None:
