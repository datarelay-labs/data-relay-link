TTL_DURATION_RE = re.compile(r'^(\d+)([smhd])$', re.I)

# An enrollment credential is a short-lived hand-off, not long-term access.
# Zero-Touch tickets: default 1h, maximum 24h (must match server allocator).
ZERO_TOUCH_DEFAULT_TTL = '1h'
ZERO_TOUCH_MAX_TTL_SEC = 24 * 3600
ZERO_TOUCH_MAX_TTL_TEXT = '24h'
# Manual Enrollment Codes retain a longer operational ceiling (30d).
MAX_ENROLLMENT_TTL_SEC = 30 * 86400
MAX_ENROLLMENT_TTL_TEXT = '30d'
TTL_TOO_LARGE_ERROR = (
    'TTL must be at most %s (%s seconds); enrollment credentials are short-lived'
    % (MAX_ENROLLMENT_TTL_TEXT, MAX_ENROLLMENT_TTL_SEC)
)
ZERO_TOUCH_TTL_TOO_LARGE_ERROR = (
    'Zero-Touch TTL must be at most %s (%s seconds)'
    % (ZERO_TOUCH_MAX_TTL_TEXT, ZERO_TOUCH_MAX_TTL_SEC)
)


def parse_enrollment_ttl(raw, *, zero_touch=False):
    text = str(raw or '').strip()
    if not text:
        raise ValueError('TTL is required')
    max_sec = ZERO_TOUCH_MAX_TTL_SEC if zero_touch else MAX_ENROLLMENT_TTL_SEC
    too_large = ZERO_TOUCH_TTL_TOO_LARGE_ERROR if zero_touch else TTL_TOO_LARGE_ERROR
    if text.isdigit():
        seconds = int(text)
        if seconds <= 0:
            raise ValueError('TTL must be a positive integer')
        if seconds > max_sec:
            raise ValueError(too_large)
        return seconds
    match = TTL_DURATION_RE.match(text.lower())
    if not match:
        raise ValueError('invalid TTL (use 30m|1h|4h|1d or raw seconds, e.g. 600)')
    amount = int(match.group(1))
    unit = match.group(2).lower()
    if amount <= 0:
        raise ValueError('TTL must be positive')
    multipliers = {'s': 1, 'm': 60, 'h': 3600, 'd': 86400}
    seconds = amount * multipliers[unit]
    if seconds > max_sec:
        raise ValueError(too_large)
    return seconds


def atomic_write_json(path, data, mode=0o600):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + '.', suffix='.tmp', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as fh:
            json.dump(data, fh, indent=2, sort_keys=True)
            fh.write('\n')
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            try:
                os.unlink(tmp)
            except OSError:
                pass
    try:
        path.chmod(mode)
    except OSError:
        pass


def write_enrollment(enroll_dir, enrollment_id, secret, ttl, note, label=''):
    now = int(time.time())
    record = {
        'id': enrollment_id,
        'secret': secret,
        'created_at': iso(now),
        'expires_at': now + ttl,
        'expires_at_iso': iso(now + ttl),
        'bound_machine_id': None,
        'used_at': None,
        'note': note,
        'label': label,
    }
    path = enroll_dir / (enrollment_id + '.json')
    atomic_write_json(path, record, 0o600)
    return record, path


