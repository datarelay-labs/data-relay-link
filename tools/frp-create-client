def short_url_host_for_cfg(cfg, bootstrap_hostname='', public_hostname=''):
    """Resolve Zero-Touch short URL hostname from install-time public identity.

    Prefer frp_server_config.short_url_hostname(cfg): advanced bootstrap_hostname
    override, else DNS public_url_host. IP-selected public identity does not
    invent a short URL from a separate public_hostname alias.
