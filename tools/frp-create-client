def remapped_server_cfg(cfg):
    """Server cfg with state paths remapped into the active tree.

    Returns the whole cfg, never a synthesized subset: retention, lock, and
    path policy must all come from the administrator's configuration.
    """
    require_onboarding_config(cfg)
    out = dict(cfg)
    out['enrollments_dir'] = str(remap(cfg['enrollments_dir']))
    out['bootstrap_dir'] = str(
        remap(cfg.get('bootstrap_dir') or str(Path(cfg['enrollments_dir']).parent / 'bootstrap'))
    )
    out['registry_file'] = str(
        remap(cfg.get('registry_file') or str(Path(cfg['enrollments_dir']).parent / 'registry.json'))
    )
    return out


def require_onboarding_config(cfg):
    """Fail with a product-owned error when enrollment config is incomplete."""
    if not isinstance(cfg, dict):
        fail(
            "Client onboarding cannot continue because the server configuration is incomplete.\n"
            "\n"
            "Missing setting:\n"
            "  enrollments_dir\n"
            "\n"
            "Run:\n"
            "  system diagnostics"
        )
    value = cfg.get('enrollments_dir')
    if value is None or not str(value).strip():
        fail(
            "Client onboarding cannot continue because the server configuration is incomplete.\n"
            "\n"
            "Missing setting:\n"
            "  enrollments_dir\n"
            "\n"
            "Run:\n"
            "  system diagnostics"
        )


