def cmd_remove_destination(cfg, args):
    confirmed_pid, confirmed_profile = confirm_enabled_profile_mutation(
        cfg, args.selector, yes=bool(getattr(args, "yes", False))
    )
    confirmed_dest_id = _resolve_destination_id(
        confirmed_profile,
        args.destination,
        protocol=getattr(args, "protocol", None),
    )
    try:
        def mut(state):
            _pid, profile = _require_confirmed_profile(state, confirmed_pid)
            if not any(
                (d or {}).get("id") == confirmed_dest_id
                for d in (profile.get("destinations") or [])
            ):
                raise EG.EgressError(
                    "Target changed while waiting for confirmation; rerun the command"
                )
            return EG.remove_destination(state, confirmed_pid, confirmed_dest_id)

        pid, profile, entry = EG.mutate_egress_state(mut, cfg=cfg)
    except EG.EgressError as exc:
        fail(str(exc))
    if pid != confirmed_pid or entry.get("id") != confirmed_dest_id:
        fail("Target changed while waiting for confirmation; rerun the command")
    print(
        "Removed destination %s:%s from %s"
        % (entry.get("host"), entry.get("port"), profile.get("name"))
    )
    audit(
        "egress.destination.removed",
        profile_id=pid,
        profile_name=profile.get("name"),
        details={"host": entry.get("host"), "port": entry.get("port"), "id": entry.get("id")},
    )


