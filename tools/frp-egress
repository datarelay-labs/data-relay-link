from pathlib import Path

ROOT = os.environ.get("FRP_DEPLOY_TEST_ROOT", "")


def load_mod(name: str, rel: str):
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / "lib" / rel,
        Path("/usr/local/lib/drlink") / rel,
    ]
    if ROOT:
        candidates.insert(1, Path(ROOT) / "usr/local/lib/drlink" / rel)
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location(name, str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise SystemExit("ERROR: missing %s" % rel)


EG = load_mod("frp_egress_control", "frp_egress_control.py")


def load_cfg():
    path = Path(ROOT + "/etc/drlink/config.json")
    if not path.is_file():
        raise SystemExit("ERROR: missing /etc/drlink/config.json")
    return json.loads(path.read_text(encoding="utf-8"))


def audit(event, **fields):
    try:
        module = load_mod("frp_audit", "frp_audit.py")
    except SystemExit:
        return
    try:
        module.emit(event, **fields)
    except Exception:
        pass


def fail(message):
    raise SystemExit("ERROR: %s" % message)


def confirm_enabled_profile_mutation(cfg, selector, *, yes: bool = False):
    """Resolve profile by selector, optionally confirm, return immutable PROFILE_ID.

    Callers must mutate by the returned PROFILE_ID (never re-resolve by name)
    so rename / name-reuse during confirmation cannot redirect the mutation.
    """
    state = EG.load_egress_state(cfg=cfg)
    try:
        pid, profile = EG.resolve_profile(state, selector)
    except EG.EgressError as exc:
        fail(str(exc))
    if not profile.get("enabled"):
        return pid, profile
    name = profile.get("name") or selector
    if yes:
        return pid, profile
    if not sys.stdin.isatty():
        fail(
            'Profile "%s" is ENABLED; this change takes effect immediately. '
            "Re-run with --yes to confirm non-interactively." % name
        )
    print('Profile "%s" is ENABLED.' % name)
    print("Profile ID    : %s" % pid)
    print("This change takes effect immediately.")
    answer = input("Continue? [y/N]: ").strip().lower()
    if answer not in ("y", "yes"):
        raise SystemExit("Cancelled")
    return pid, profile


def _require_confirmed_profile(state, confirmed_pid: str):
    profiles = state.get("egress_profiles") or {}
    profile = profiles.get(confirmed_pid)
    if not isinstance(profile, dict):
        raise EG.EgressError(
            "Target changed while waiting for confirmation; rerun the command"
        )
    return confirmed_pid, profile


def _resolve_source_id(profile, source_selector: str) -> str:
    needle = str(source_selector or "").strip()
    if not needle:
        fail("source selector is required")
    sources = profile.get("sources") or []
    matches = []
    for entry in sources:
        if entry.get("id") == needle:
            matches.append(entry)
            continue
        try:
            if EG.canonicalize_cidr(entry.get("cidr") or "") == EG.canonicalize_cidr(needle):
                matches.append(entry)
                continue
        except EG.EgressError:
            pass
        if str(entry.get("name") or "") == needle:
            matches.append(entry)
    if not matches:
        fail("source not found: %s" % source_selector)
    if len(matches) > 1:
        fail("ambiguous source selector: %s" % source_selector)
    return matches[0]["id"]


def _resolve_destination_id(profile, dest_selector: str, protocol: str | None = None) -> str:
    needle = str(dest_selector or "").strip()
    if not needle:
        fail("destination selector is required")
    want_proto = str(protocol or "").strip().lower() or None
    if want_proto and want_proto not in ("http", "https", "tcp"):
        fail("invalid protocol: %s" % protocol)
    destinations = profile.get("destinations") or []
    matches = []
    host_part = needle
    port_part = None
    if ":" in needle and not needle.startswith("*."):
        try:
            maybe_host, maybe_port = needle.rsplit(":", 1)
            if maybe_port.isdigit():
                host_part = maybe_host
                port_part = int(maybe_port)
        except ValueError:
            pass
    for entry in destinations:
        entry_proto = str(entry.get("protocol") or "").lower()
        if want_proto and entry_proto and entry_proto != want_proto:
            continue
        if entry.get("id") == needle:
            matches.append(entry)
            continue
        entry_host = str(entry.get("host") or "")
        entry_port = int(entry.get("port"))
        if port_part is not None:
            try:
                canon, _mode = EG.canonicalize_hostname(host_part, allow_wildcard=True)
            except EG.EgressError:
                continue
            if entry_host == canon and entry_port == port_part:
                matches.append(entry)
        else:
            if entry_host == needle.lower().rstrip(".") or entry.get("id") == needle:
                matches.append(entry)
    # Unique by id
    by_id = {m["id"]: m for m in matches}
    if not by_id:
        fail("destination not found: %s" % dest_selector)
    if len(by_id) > 1:
        fail("ambiguous destination selector: %s" % dest_selector)
    return next(iter(by_id))

def print_profile(pid, profile):
    print("Profile ID    : %s" % pid)
    print("Name          : %s" % (profile.get("name") or "-"))
    print("Description   : %s" % (profile.get("description") or "-"))
    print("Enabled       : %s" % ("yes" if profile.get("enabled") else "no"))
    print("Created       : %s" % (profile.get("created_at") or "-"))
    print("Updated       : %s" % (profile.get("updated_at") or "-"))
    sources = profile.get("sources") or []
    print("Sources (%d):" % len(sources))
    if not sources:
        print("  (none)")
    else:
        for src in sources:
            label = src.get("name") or "-"
            print("  - %s  %s  (%s)" % (src.get("cidr"), label, src.get("id")))
    destinations = profile.get("destinations") or []
    print("Destinations (%d):" % len(destinations))
    if not destinations:
        print("  (none)")
    else:
        for dest in destinations:
            print(
                "  - %s:%s/%s  match=%s  (%s)"
                % (
                    dest.get("host"),
                    dest.get("port"),
                    dest.get("protocol") or "?",
                    dest.get("match"),
                    dest.get("id"),
                )
            )
    print("Default       : DENY")


