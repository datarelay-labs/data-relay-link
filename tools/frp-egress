def cmd_test(cfg, args):
    state = EG.load_egress_state(cfg=cfg)
    protocol = args.protocol
    if not protocol:
        # Infer only for operator convenience in test; policy still requires explicit protocol.
        if args.port == 80:
            protocol = "http"
        elif args.port == 443:
            protocol = "https"
        else:
            fail("--protocol is required for non-80/443 test ports")
    decision = EG.authorize_request(
        state,
        source_ip=args.source_ip,
        hostname=args.host,
        port=args.port,
        protocol=protocol,
        method="CONNECT" if protocol == "https" else "GET",
    )
    policy = decision.get("decision")
    print("Policy       : %s" % policy)
    print("Reason       : %s" % decision.get("reason"))
    print("Source IP    : %s" % decision.get("source_ip"))
    print("Hostname     : %s" % decision.get("hostname"))
    print("Port         : %s" % decision.get("port"))
    print("Protocol     : %s" % (decision.get("protocol") or protocol))
    print("Profile ID   : %s" % (decision.get("profile_id") or "-"))
    print("Profile Name : %s" % (decision.get("profile_name") or "-"))
    if policy != EG.DECISION_ALLOW:
        print("DNS          : skipped (policy deny)")
        print("Resolved IPs : -")
        print("Live connect : NOT TESTED")
        raise SystemExit(2)

    try:
        results = socket.getaddrinfo(args.host, None, type=socket.SOCK_STREAM)
        seen = set()
        raw = []
        for _family, _type, _proto, _canon, sockaddr in results:
            ip = sockaddr[0]
            if ip in seen:
                continue
            seen.add(ip)
            raw.append(ip)
        print("DNS          : ALLOW (%d address(es))" % len(raw))
        validated = EG.validate_resolved_addresses(raw)
        print("Resolved IPs : %s" % (", ".join(validated) if validated else "-"))
        print("Live connect : NOT TESTED")
    except EG.EgressError as exc:
        print("DNS          : DENY (%s)" % exc)
        print("Resolved IPs : -")
        print("Live connect : NOT TESTED")
        raise SystemExit(2) from None
    except OSError as exc:
        print("DNS          : DENY (%s)" % exc)
        print("Resolved IPs : -")
        print("Live connect : NOT TESTED")
        raise SystemExit(2) from None


def cmd_export(cfg, args):
    state = EG.load_egress_state(cfg=cfg)
    try:
        doc = EG.export_profile(state, args.selector)
    except EG.EgressError as exc:
        fail(str(exc))
    text = json.dumps(doc, indent=2, sort_keys=True) + "\n"
    if args.output:
        Path(args.output).write_text(text, encoding="utf-8")
        print("Exported %s to %s" % (args.selector, args.output))
    else:
        sys.stdout.write(text)


def cmd_diff(cfg, args):
    state = EG.load_egress_state(cfg=cfg)
    try:
        _pid, current = EG.resolve_profile(state, args.selector)
        raw = json.loads(Path(args.file).read_text(encoding="utf-8"))
        candidate = EG.parse_import_document(raw)
        diff = EG.diff_profiles(current, candidate)
    except (EG.EgressError, OSError, UnicodeError, json.JSONDecodeError) as exc:
        fail(str(exc))
    print(json.dumps(diff, indent=2, sort_keys=True))


def cmd_import(cfg, args):
    try:
        raw = json.loads(Path(args.file).read_text(encoding="utf-8"))
        candidate = EG.parse_import_document(raw)

        def mut(state):
            return EG.import_profile_into_state(
                state,
                candidate,
                target_selector=args.selector or None,
            )

        pid, profile, diff = EG.mutate_egress_state(mut, cfg=cfg)
    except (EG.EgressError, OSError, UnicodeError, json.JSONDecodeError) as exc:
        fail(str(exc))
    print("Imported into %s (%s) — left DISABLED" % (pid, profile.get("name")))
    print(json.dumps(diff, indent=2, sort_keys=True))
    audit(
        "egress.profile.imported",
        profile_id=pid,
        profile_name=profile.get("name"),
        details={"diff": diff},
    )


def cmd_status(cfg, _args):
    path = EG.egress_control_path(cfg)
    print("Egress control file : %s" % path)
    print("Exists              : %s" % ("yes" if path.is_file() else "no"))
    try:
        host, port = EG.listen_bind(cfg)
        print("Listen              : %s:%s" % (host, port))
    except EG.EgressError as exc:
        print("Listen              : ERROR %s" % exc)
    try:
        state = EG.load_egress_state(cfg=cfg)
        rows = EG.list_profiles(state)
        enabled = sum(1 for _pid, p in rows if p.get("enabled"))
        print("Profiles            : %d (%d enabled)" % (len(rows), enabled))
        print("Default             : DENY")
        for issue in EG.doctor_issues(state):
            print("Doctor %-5s        : %s" % (issue.get("severity"), issue.get("message")))
    except EG.EgressError as exc:
        print("Policy              : FAIL-CLOSED (%s)" % exc)


def build_parser():
    parser = argparse.ArgumentParser(prog="frp-egress", description="Controlled Egress profile management")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("list", help="List egress profiles")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("show", help="Show one egress profile")
    p.add_argument("selector")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("create", help="Create a DISABLED egress profile")
    p.add_argument("name")
    p.add_argument("--description", default="")
    p.add_argument(
        "--enable",
        action="store_true",
        help="Rejected for new profiles (create is always disabled; add source/destination, then enable)",
    )
    p.add_argument(
        "--disabled",
        action="store_true",
        help=argparse.SUPPRESS,  # compatibility no-op; create is already disabled
    )
    p.set_defaults(func=cmd_create)

    p = sub.add_parser("set", help="Update egress profile metadata")
    p.add_argument("selector")
    p.add_argument(
        "property",
        nargs="?",
        choices=["name", "description"],
        default=None,
        help="Canonical property form: name|description",
    )
    p.add_argument("value", nargs="?", default=None, help="New property value")
    p.add_argument("--name", default=None, help=argparse.SUPPRESS)
    p.add_argument("--description", default=None, help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_set)

    p = sub.add_parser("enable", help="Enable an egress profile")
    p.add_argument("selector")
    p.set_defaults(func=cmd_enable)

    p = sub.add_parser("disable", help="Disable an egress profile")
    p.add_argument("selector")
    p.set_defaults(func=cmd_disable)

    p = sub.add_parser("delete", help="Delete an egress profile")
    p.add_argument("selector")
    p.set_defaults(func=cmd_delete)

    p = sub.add_parser("add-destination", help="Add FQDN:port destination with protocol")
    p.add_argument("selector")
    p.add_argument("host")
    p.add_argument("port", type=int)
    p.add_argument(
        "--protocol",
        required=True,
        choices=["http", "https"],
        help="Destination protocol (http absolute-form or https CONNECT+SNI)",
    )
    p.set_defaults(func=cmd_add_destination)

    p = sub.add_parser("remove-destination", help="Remove a destination")
    p.add_argument("selector")
    p.add_argument("destination")
    p.set_defaults(func=cmd_remove_destination)

    p = sub.add_parser("add-source", help="Add source CIDR")
    p.add_argument("selector")
    p.add_argument("cidr")
    p.add_argument("--name", default="")
    p.set_defaults(func=cmd_add_source)

    p = sub.add_parser("remove-source", help="Remove a source")
    p.add_argument("selector")
    p.add_argument("source")
    p.set_defaults(func=cmd_remove_source)

    p = sub.add_parser("test", help="Test authorize(source, host, port, protocol) without connecting")
    p.add_argument("source_ip")
    p.add_argument("host")
    p.add_argument("port", type=int)
    p.add_argument("--protocol", choices=["http", "https"], default=None)
    p.set_defaults(func=cmd_test)

    p = sub.add_parser("export", help="Export one egress profile to JSON")
    p.add_argument("selector")
    p.add_argument("--output", "-o", default=None)
    p.set_defaults(func=cmd_export)

    p = sub.add_parser("diff", help="Diff a profile against an import candidate file")
    p.add_argument("selector")
    p.add_argument("file")
    p.set_defaults(func=cmd_diff)

    p = sub.add_parser("import", help="Import profile JSON (always DISABLED; never auto-enable)")
    p.add_argument("file")
    p.add_argument(
        "selector",
        nargs="?",
        default=None,
        help="Optional existing profile to replace destinations/sources into",
    )
    p.set_defaults(func=cmd_import)

    p = sub.add_parser("status", help="Show egress control status")
    p.set_defaults(func=cmd_status)

    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    cfg = load_cfg()
    args.func(cfg, args)


if __name__ == "__main__":
    main()
