    )


def cmd_test(cfg, args):
    """Hidden/compat alias for explain (policy + DNS only; no mutation)."""
    return cmd_explain(cfg, args)


def cmd_explain(cfg, args):
    state = EG.load_egress_state(cfg=cfg)
    protocol = getattr(args, "protocol", None)
    if not protocol:
        # Infer only for operator convenience; policy still requires explicit protocol.
        if args.port == 80:
            protocol = "http"
        elif args.port == 443:
            protocol = "https"
        else:
            fail("--protocol is required for non-80/443 explain ports (http|https|tcp)")
    method = None
    if protocol == "https":
        method = "CONNECT"
    elif protocol == "http":
        method = "GET"
    decision = EG.authorize_request(
        state,
        source_ip=args.source_ip,
        hostname=args.host,
        port=args.port,
        protocol=protocol,
        method=method,
        preview=True,
    )
    policy = decision.get("decision")
    profile_state = "-"
    profile_id = decision.get("profile_id")
    if profile_id:
        profile = (state.get("egress_profiles") or {}).get(profile_id)
        if isinstance(profile, dict):
            profile_state = "ENABLED" if profile.get("enabled") else "DISABLED"
    print("Profile state: %s" % profile_state)
    print("Mode: PREVIEW")
    print("Policy decision: %s" % policy)
    print("Reason: %s" % decision.get("reason"))
    print("Source IP: %s" % decision.get("source_ip"))
    print("Hostname: %s" % decision.get("hostname"))
    print("Port: %s" % decision.get("port"))
    print("Protocol: %s" % (decision.get("protocol") or protocol))
    print("Profile ID: %s" % (profile_id or "-"))
    print("Profile Name: %s" % (decision.get("profile_name") or "-"))
    if policy != EG.DECISION_ALLOW:
        print("DNS safety: skipped (policy deny)")
        print("Resolved IPs: -")
        print("Live connect: NOT TESTED")
        print("No live policy was changed.")
        raise SystemExit(2)

    try:
        results = socket.getaddrinfo(args.host, None, type=socket.SOCK_STREAM)
        seen = set()
        raw = []
        for _family, _type, _proto, _canon, sockaddr in results:
            ip = sockaddr[0]
            if ip in seen:
                continue
            seen.add(ip)
            raw.append(ip)
        validated = EG.validate_resolved_addresses(raw)
        print("DNS safety: ALLOW (%d address(es))" % len(raw))
        print("Resolved IPs: %s" % (", ".join(validated) if validated else "-"))
        print("Live connect: NOT TESTED")
        print("No live policy was changed.")
    except EG.EgressError as exc:
        print("DNS safety: DENY (%s)" % exc)
        print("Resolved IPs: -")
        print("Live connect: NOT TESTED")
        print("No live policy was changed.")
        raise SystemExit(2) from None
    except OSError as exc:
        print("DNS safety: DENY (%s)" % exc)
        print("Resolved IPs: -")
        print("Live connect: NOT TESTED")
        print("No live policy was changed.")
        raise SystemExit(2) from None


def _print_relay(rid, relay, state=None):
    print("Relay ID      : %s" % rid)
    print("Name          : %s" % (relay.get("name") or "-"))
    print("Enabled       : %s" % ("yes" if relay.get("enabled") else "no"))
    print("Listen        : %s:%s" % (relay.get("listen_addr"), relay.get("listen_port")))
    print("Profile ID    : %s" % (relay.get("profile_id") or "-"))
    print("Destination ID: %s" % (relay.get("destination_id") or "-"))
    if state is not None:
        profile = (state.get("egress_profiles") or {}).get(relay.get("profile_id") or "")
        if isinstance(profile, dict):
            print("Profile Name  : %s" % (profile.get("name") or "-"))
            print("Profile Enabled: %s" % ("yes" if profile.get("enabled") else "no"))
            for dest in profile.get("destinations") or []:
                if dest.get("id") == relay.get("destination_id"):
                    print(
                        "Destination   : %s:%s/%s match=%s"
                        % (dest.get("host"), dest.get("port"), dest.get("protocol"), dest.get("match"))
                    )
                    break
    print("Created       : %s" % (relay.get("created_at") or "-"))
    print("Updated       : %s" % (relay.get("updated_at") or "-"))


