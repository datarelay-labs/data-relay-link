def cmd_delete(cfg, args):
    confirmed_pid, confirmed_profile = confirm_enabled_profile_mutation(
        cfg, args.selector, yes=bool(getattr(args, "yes", False))
    )
    try:
        def mut(state):
            _require_confirmed_profile(state, confirmed_pid)
            return EG.delete_profile(state, confirmed_pid)

        pid, profile = EG.mutate_egress_state(mut, cfg=cfg)
    except EG.EgressError as exc:
        fail(str(exc))
    if pid != confirmed_pid:
        fail("Target changed while waiting for confirmation; rerun the command")
    print("Deleted egress profile %s (%s)" % (pid, profile.get("name")))
    audit("egress.profile.deleted", profile_id=pid, profile_name=profile.get("name"))


