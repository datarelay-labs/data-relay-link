#!/usr/bin/env python3
"""Manage Data Relay Controlled Egress profiles (agentless outbound policy)."""
from __future__ import annotations

import argparse
import importlib.util
import json
import os
import sys
from pathlib import Path

ROOT = os.environ.get("FRP_DEPLOY_TEST_ROOT", "")


def load_mod(name: str, rel: str):
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / "lib" / rel,
        Path("/usr/local/lib/drlink") / rel,
    ]
    if ROOT:
        candidates.insert(1, Path(ROOT) / "usr/local/lib/drlink" / rel)
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location(name, str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise SystemExit("ERROR: missing %s" % rel)


EG = load_mod("frp_egress_control", "frp_egress_control.py")


def load_cfg():
    path = Path(ROOT + "/etc/drlink/config.json")
    if not path.is_file():
        raise SystemExit("ERROR: missing /etc/drlink/config.json")
    return json.loads(path.read_text(encoding="utf-8"))


def audit(event, **fields):
    try:
        module = load_mod("frp_audit", "frp_audit.py")
    except SystemExit:
        return
    try:
        module.emit(event, **fields)
    except Exception:
        pass


def fail(message):
    raise SystemExit("ERROR: %s" % message)


def print_profile(pid, profile):
    print("Profile ID    : %s" % pid)
    print("Name          : %s" % (profile.get("name") or "-"))
    print("Description   : %s" % (profile.get("description") or "-"))
    print("Enabled       : %s" % ("yes" if profile.get("enabled") else "no"))
    print("Created       : %s" % (profile.get("created_at") or "-"))
    print("Updated       : %s" % (profile.get("updated_at") or "-"))
    sources = profile.get("sources") or []
    print("Sources (%d):" % len(sources))
    if not sources:
        print("  (none)")
    else:
        for src in sources:
            label = src.get("name") or "-"
            print("  - %s  %s  (%s)" % (src.get("cidr"), label, src.get("id")))
    destinations = profile.get("destinations") or []
    print("Destinations (%d):" % len(destinations))
    if not destinations:
        print("  (none)")
    else:
        for dest in destinations:
            print(
                "  - %s:%s  match=%s  (%s)"
                % (dest.get("host"), dest.get("port"), dest.get("match"), dest.get("id"))
            )
    print("Default       : DENY")


def cmd_list(cfg, _args):
    state = EG.load_egress_state(cfg=cfg)
    print("%-18s %-24s %-8s %-8s %-8s %s" % ("PROFILE ID", "NAME", "ENABLED", "SOURCES", "DESTS", "DESCRIPTION"))
    print("-" * 90)
    rows = EG.list_profiles(state)
    if not rows:
        print("(none)")
        return
    for pid, profile in rows:
        print(
            "%-18s %-24s %-8s %-8s %-8s %s"
            % (
                pid,
                (profile.get("name") or "-")[:24],
                "yes" if profile.get("enabled") else "no",
                str(len(profile.get("sources") or [])),
                str(len(profile.get("destinations") or [])),
                (profile.get("description") or "-")[:32],
            )
        )


def cmd_show(cfg, args):
    state = EG.load_egress_state(cfg=cfg)
    try:
        pid, profile = EG.resolve_profile(state, args.selector)
    except EG.EgressError as exc:
        fail(str(exc))
    print_profile(pid, profile)


def cmd_create(cfg, args):
    try:
        def mut(state):
            # Safe default: create DISABLED. Explicit --enable is the only way to
            # start active; incomplete policies must never widen egress.
            enabled = bool(getattr(args, "enable", False))
            return EG.create_profile(
                state,
                args.name,
                description=args.description or "",
                enabled=enabled,
            )

        pid, record = EG.mutate_egress_state(mut, cfg=cfg)
    except EG.EgressError as exc:
        fail(str(exc))
    print("Created egress profile %s" % pid)
    print("Name     : %s" % record["name"])
    print("Enabled  : %s" % ("yes" if record["enabled"] else "no"))
    if not record["enabled"]:
        print("")
        print("The profile is disabled. Default egress policy stays DENY.")
        print("Next steps:")
        print("  egress add-source %s <CIDR>" % record["name"])
        print("  egress add-destination %s <FQDN> <PORT>" % record["name"])
        print("  egress show %s" % record["name"])
        print("  egress enable %s" % record["name"])
    audit(
        "egress.profile.created",
        profile_id=pid,
        profile_name=record.get("name"),
        details={"enabled": record.get("enabled")},
    )


def cmd_set(cfg, args):
    try:
        def mut(state):
            kwargs = {}
            if args.name is not None:
                kwargs["name"] = args.name
            if args.description is not None:
                kwargs["description"] = args.description
            if not kwargs:
                raise EG.EgressError("nothing to update (use --name and/or --description)")
            return EG.set_profile_metadata(state, args.selector, **kwargs)

        pid, profile = EG.mutate_egress_state(mut, cfg=cfg)
    except EG.EgressError as exc:
        fail(str(exc))
    print("Updated egress profile %s" % pid)
    print_profile(pid, profile)
    audit(
        "egress.profile.updated",
        profile_id=pid,
        profile_name=profile.get("name"),
        details={"name": args.name, "description": args.description},
    )


def cmd_enable(cfg, args):
    try:
        def mut(state):
            return EG.set_profile_enabled(state, args.selector, True)

        pid, profile = EG.mutate_egress_state(mut, cfg=cfg)
    except EG.EgressError as exc:
        fail(str(exc))
    print("Enabled egress profile %s (%s)" % (pid, profile.get("name")))
    audit("egress.profile.enabled", profile_id=pid, profile_name=profile.get("name"))


def cmd_disable(cfg, args):
    try:
        def mut(state):
            return EG.set_profile_enabled(state, args.selector, False)

        pid, profile = EG.mutate_egress_state(mut, cfg=cfg)
    except EG.EgressError as exc:
        fail(str(exc))
    print("Disabled egress profile %s (%s)" % (pid, profile.get("name")))
    audit("egress.profile.disabled", profile_id=pid, profile_name=profile.get("name"))


def cmd_delete(cfg, args):
    try:
        def mut(state):
            return EG.delete_profile(state, args.selector)

        pid, profile = EG.mutate_egress_state(mut, cfg=cfg)
    except EG.EgressError as exc:
        fail(str(exc))
    print("Deleted egress profile %s (%s)" % (pid, profile.get("name")))
    audit("egress.profile.deleted", profile_id=pid, profile_name=profile.get("name"))


def cmd_add_destination(cfg, args):
    try:
        def mut(state):
            return EG.add_destination(state, args.selector, args.host, args.port)

        pid, profile, entry = EG.mutate_egress_state(mut, cfg=cfg)
    except EG.EgressError as exc:
        fail(str(exc))
    print(
        "Added destination %s:%s (match=%s) to %s"
        % (entry.get("host"), entry.get("port"), entry.get("match"), profile.get("name"))
    )
    audit(
        "egress.destination.added",
        profile_id=pid,
        profile_name=profile.get("name"),
        details={"host": entry.get("host"), "port": entry.get("port"), "match": entry.get("match")},
    )


def cmd_remove_destination(cfg, args):
    try:
        def mut(state):
            return EG.remove_destination(state, args.selector, args.destination)

        pid, profile, entry = EG.mutate_egress_state(mut, cfg=cfg)
    except EG.EgressError as exc:
        fail(str(exc))
    print(
        "Removed destination %s:%s from %s"
        % (entry.get("host"), entry.get("port"), profile.get("name"))
    )
    audit(
        "egress.destination.removed",
        profile_id=pid,
        profile_name=profile.get("name"),
        details={"host": entry.get("host"), "port": entry.get("port")},
    )


def cmd_add_source(cfg, args):
    try:
        def mut(state):
            return EG.add_source(state, args.selector, args.cidr, name=args.name or "")

        pid, profile, entry = EG.mutate_egress_state(mut, cfg=cfg)
    except EG.EgressError as exc:
        fail(str(exc))
    print("Added source %s to %s" % (entry.get("cidr"), profile.get("name")))
    audit(
        "egress.source.added",
        profile_id=pid,
        profile_name=profile.get("name"),
        details={"cidr": entry.get("cidr")},
    )


