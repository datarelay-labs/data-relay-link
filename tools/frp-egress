def cmd_tcp_delete(cfg, args):
    state = EG.load_egress_state(cfg=cfg)
    try:
        rid, relay = EG.resolve_tcp_relay(state, args.selector)
    except EG.EgressError as exc:
        fail(str(exc))
    if relay.get("enabled") and not getattr(args, "yes", False):
        if not sys.stdin.isatty():
            fail(
                'Relay "%s" is ENABLED; re-run with --yes to confirm.'
                % (relay.get("name") or rid)
            )
        print('Relay "%s" is ENABLED.' % (relay.get("name") or rid))
        answer = input("Continue? [y/N]: ").strip().lower()
        if answer not in ("y", "yes"):
            raise SystemExit("Cancelled")
    try:
        def mut(state):
            return EG.delete_tcp_relay(state, rid)

        deleted_id, deleted = EG.mutate_egress_state(mut, cfg=cfg)
    except EG.EgressError as exc:
        fail(str(exc))
    print("Deleted tcp relay %s (%s)" % (deleted_id, deleted.get("name")))
    audit("egress.tcp_relay.deleted", details={"relay_id": deleted_id, "relay_name": deleted.get("name")})


def cmd_tcp_explain(cfg, args):
    state = EG.load_egress_state(cfg=cfg)
    decision = EG.authorize_tcp_relay(
        state,
        relay_selector=args.selector,
        source_ip=args.source_ip,
        preview=True,
    )
    print("Mode: PREVIEW")
    print("Relay ID: %s" % (decision.get("relay_id") or "-"))
    print("Relay Name: %s" % (decision.get("relay_name") or "-"))
    print("Policy decision: %s" % decision.get("decision"))
    print("Reason: %s" % decision.get("reason"))
    print("Source IP: %s" % decision.get("source_ip"))
    print("Hostname: %s" % (decision.get("hostname") or "-"))
    print("Port: %s" % (decision.get("port") or "-"))
    print("Protocol: tcp")
    print("Profile ID: %s" % (decision.get("profile_id") or "-"))
    print("No live policy was changed.")
    if decision.get("decision") != EG.DECISION_ALLOW:
        raise SystemExit(2)
    host = decision.get("hostname")
    if not host:
        raise SystemExit(2)
    try:
        results = socket.getaddrinfo(host, None, type=socket.SOCK_STREAM)
        seen = set()
        raw = []
        for _family, _type, _proto, _canon, sockaddr in results:
            ip = sockaddr[0]
            if ip in seen:
                continue
            seen.add(ip)
            raw.append(ip)
        validated = EG.validate_resolved_addresses(raw)
        print("DNS safety: ALLOW (%d address(es))" % len(raw))
        print("Resolved IPs: %s" % (", ".join(validated) if validated else "-"))
        print("Live connect: NOT TESTED")
    except (EG.EgressError, OSError) as exc:
        print("DNS safety: DENY (%s)" % exc)
        print("Resolved IPs: -")
        print("Live connect: NOT TESTED")
        raise SystemExit(2) from None


def cmd_recipe_list(cfg, _args):
    del cfg
    rows = EG.list_recipes()
    print("%-16s %-24s %s" % ("ID", "NAME", "DESCRIPTION"))
    print("-" * 72)
    if not rows:
        print("(none)")
        return
    for row in rows:
        print(
            "%-16s %-24s %s"
            % (row.get("id"), (row.get("name") or "-")[:24], (row.get("description") or "-")[:40])
        )


def cmd_recipe_show(cfg, args):
    del cfg
    try:
        recipe = EG.load_recipe(args.selector)
    except EG.EgressError as exc:
        fail(str(exc))
    print(json.dumps(recipe, indent=2, sort_keys=True))


def cmd_recipe_apply(cfg, args):
    try:
        def mut(state):
            return EG.apply_recipe(
                state,
                args.selector,
                profile_name=args.name or None,
                source_cidr=args.source or None,
                cfg=cfg,
            )

        result = EG.mutate_egress_state(mut, cfg=cfg)
    except EG.EgressError as exc:
        fail(str(exc))
    print("Applied recipe %s (left DISABLED)" % args.selector)
    print("Profile ID  : %s" % result.get("profile_id"))
    print("Profile Name: %s" % result.get("profile_name"))
    if result.get("relay_id"):
        print("Relay ID    : %s" % result.get("relay_id"))
        print("Relay Name  : %s" % result.get("relay_name"))
    print("Enabled     : no")
    print("No profile or relay was auto-enabled.")
    audit("egress.recipe.applied", details=result)


def cmd_export(cfg, args):
    state = EG.load_egress_state(cfg=cfg)
    try:
        doc = EG.export_profile(state, args.selector)
    except EG.EgressError as exc:
        fail(str(exc))
    text = json.dumps(doc, indent=2, sort_keys=True) + "\n"
    if args.output:
        Path(args.output).write_text(text, encoding="utf-8")
        print("Exported %s to %s" % (args.selector, args.output))
    else:
        sys.stdout.write(text)


def cmd_diff(cfg, args):
    state = EG.load_egress_state(cfg=cfg)
    try:
        _pid, current = EG.resolve_profile(state, args.selector)
        raw = json.loads(Path(args.file).read_text(encoding="utf-8"))
        candidate = EG.parse_import_document(raw)
        diff = EG.diff_profiles(current, candidate)
    except (EG.EgressError, OSError, UnicodeError, json.JSONDecodeError) as exc:
        fail(str(exc))
    print(json.dumps(diff, indent=2, sort_keys=True))


def cmd_import(cfg, args):
    try:
        raw = json.loads(Path(args.file).read_text(encoding="utf-8"))
        candidate = EG.parse_import_document(raw)

        def mut(state):
            return EG.import_profile_into_state(
                state,
                candidate,
                target_selector=args.selector or None,
            )

        pid, profile, diff = EG.mutate_egress_state(mut, cfg=cfg)
    except (EG.EgressError, OSError, UnicodeError, json.JSONDecodeError) as exc:
        fail(str(exc))
    print("Imported into %s (%s) — left DISABLED" % (pid, profile.get("name")))
    print(json.dumps(diff, indent=2, sort_keys=True))
    audit(
        "egress.profile.imported",
        profile_id=pid,
        profile_name=profile.get("name"),
        details={"diff": diff},
    )


def cmd_status(cfg, _args):
    path = EG.egress_control_path(cfg)
    print("Egress control file : %s" % path)
    print("Exists              : %s" % ("yes" if path.is_file() else "no"))
    try:
        host, port = EG.listen_bind(cfg)
        print("Listen              : %s:%s" % (host, port))
    except EG.EgressError as exc:
        print("Listen              : ERROR %s" % exc)
    try:
        state = EG.load_egress_state(cfg=cfg)
        rows = EG.list_profiles(state)
        enabled = sum(1 for _pid, p in rows if p.get("enabled"))
        print("Profiles            : %d (%d enabled)" % (len(rows), enabled))
        print("Default             : DENY")
        for issue in EG.doctor_issues(state):
            print("Doctor %-5s        : %s" % (issue.get("severity"), issue.get("message")))
    except EG.EgressError as exc:
        print("Policy              : FAIL-CLOSED (%s)" % exc)


def build_parser():
    parser = argparse.ArgumentParser(prog="frp-egress", description="Controlled Egress profile management")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("list", help="List egress profiles")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("show", help="Show one egress profile")
    p.add_argument("selector")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("create", help="Create a DISABLED egress profile")
    p.add_argument("name")
    p.add_argument("--description", default="")
    p.add_argument(
        "--enable",
        action="store_true",
        help="Rejected: new profiles are always created disabled; use egress enable after configure+test",
    )
    p.add_argument(
        "--disabled",
        action="store_true",
        help=argparse.SUPPRESS,  # compatibility no-op; create is already disabled
    )
    p.set_defaults(func=cmd_create)

    p = sub.add_parser("set", help="Update egress profile metadata")
    p.add_argument("selector")
    p.add_argument(
        "property",
        nargs="?",
        choices=["name", "description"],
        default=None,
        help="Canonical property form: name|description",
    )
    p.add_argument("value", nargs="?", default=None, help="New property value")
    p.add_argument("--name", default=None, help=argparse.SUPPRESS)
    p.add_argument("--description", default=None, help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_set)

    p = sub.add_parser("enable", help="Enable an egress profile")
    p.add_argument("selector")
    p.set_defaults(func=cmd_enable)

    p = sub.add_parser("disable", help="Disable an egress profile")
    p.add_argument("selector")
    p.set_defaults(func=cmd_disable)

    p = sub.add_parser("delete", help="Delete an egress profile")
    p.add_argument("selector")
    p.add_argument(
        "--yes",
        action="store_true",
        help="Confirm mutation of an ENABLED profile without a prompt",
    )
    p.set_defaults(func=cmd_delete)

    p = sub.add_parser("add-destination", help="Add FQDN:port destination with protocol")
    p.add_argument("selector")
    p.add_argument("host")
    p.add_argument("port", type=int)
    p.add_argument(
        "--protocol",
        required=True,
        choices=["http", "https", "tcp"],
        help="Destination protocol (http|https|tcp)",
    )
    p.set_defaults(func=cmd_add_destination)

    p = sub.add_parser("remove-destination", help="Remove a destination")
    p.add_argument("selector")
    p.add_argument("destination")
    p.add_argument(
        "--protocol",
        choices=["http", "https", "tcp"],
        help="Disambiguate when host:port matches multiple destinations",
    )
    p.add_argument(
        "--yes",
        action="store_true",
        help="Confirm mutation of an ENABLED profile without a prompt",
    )
    p.set_defaults(func=cmd_remove_destination)

    p = sub.add_parser("add-source", help="Add source CIDR")
    p.add_argument("selector")
    p.add_argument("cidr")
    p.add_argument("--name", default="")
    p.set_defaults(func=cmd_add_source)

    p = sub.add_parser("remove-source", help="Remove a source")
    p.add_argument("selector")
    p.add_argument("source")
    p.add_argument(
        "--yes",
        action="store_true",
        help="Confirm mutation of an ENABLED profile without a prompt",
    )
    p.set_defaults(func=cmd_remove_source)

    p = sub.add_parser(
        "explain",
        help="Explain authorize(source, host, port) — policy + DNS only (no mutation)",
    )
    p.add_argument("source_ip")
    p.add_argument("host")
    p.add_argument("port", type=int)
    p.add_argument("--protocol", choices=["http", "https", "tcp"], default=None)
    p.set_defaults(func=cmd_explain)

    # Compat: "test" is rewritten to "explain" in main() so it stays hidden
    # (Python 3.12 still renders help=argparse.SUPPRESS for subparsers).

    p = sub.add_parser("export", help="Export one egress profile to JSON")
    p.add_argument("selector")
    p.add_argument("--output", "-o", default=None)
    p.set_defaults(func=cmd_export)

    p = sub.add_parser("diff", help="Diff a profile against an import candidate file")
    p.add_argument("selector")
    p.add_argument("file")
    p.set_defaults(func=cmd_diff)

    p = sub.add_parser("import", help="Import profile JSON (always DISABLED; never auto-enable)")
    p.add_argument("file")
    p.add_argument(
        "selector",
        nargs="?",
        default=None,
        help="Optional existing profile to replace destinations/sources into",
    )
    p.set_defaults(func=cmd_import)

    p = sub.add_parser("status", help="Show egress control status")
    p.set_defaults(func=cmd_status)

    # Fixed TCP Egress
    tcp = sub.add_parser("tcp", help="Fixed TCP Egress relays")
    tcp_sub = tcp.add_subparsers(dest="tcp_command", required=True)

    p = tcp_sub.add_parser("list", help="List Fixed TCP Egress relays")
    p.set_defaults(func=cmd_tcp_list)

    p = tcp_sub.add_parser("show", help="Show one Fixed TCP Egress relay")
    p.add_argument("selector")
    p.set_defaults(func=cmd_tcp_show)

    p = tcp_sub.add_parser("create", help="Create a DISABLED Fixed TCP Egress relay")
    p.add_argument("name")
    p.add_argument("--profile", required=True)
    p.add_argument("--destination", required=True)
    p.add_argument("--listen-port", type=int, default=None)
    p.add_argument("--listen-addr", default="0.0.0.0")
    p.set_defaults(func=cmd_tcp_create)

    p = tcp_sub.add_parser("enable", help="Enable a Fixed TCP Egress relay")
    p.add_argument("selector")
    p.set_defaults(func=cmd_tcp_enable)

    p = tcp_sub.add_parser("disable", help="Disable a Fixed TCP Egress relay")
    p.add_argument("selector")
    p.set_defaults(func=cmd_tcp_disable)

    p = tcp_sub.add_parser("delete", help="Delete a Fixed TCP Egress relay")
    p.add_argument("selector")
    p.add_argument("--yes", action="store_true")
    p.set_defaults(func=cmd_tcp_delete)

    p = tcp_sub.add_parser("explain", help="Explain Fixed TCP Egress authorize for a source IP")
    p.add_argument("selector")
    p.add_argument("source_ip")
    p.set_defaults(func=cmd_tcp_explain)

    recipe = sub.add_parser("recipe", help="Egress recipe templates")
    recipe_sub = recipe.add_subparsers(dest="recipe_command", required=True)

    p = recipe_sub.add_parser("list", help="List egress recipes")
    p.set_defaults(func=cmd_recipe_list)

    p = recipe_sub.add_parser("show", help="Show one egress recipe")
    p.add_argument("selector")
    p.set_defaults(func=cmd_recipe_show)

    p = recipe_sub.add_parser("apply", help="Apply a recipe (always DISABLED; never auto-enable)")
    p.add_argument("selector")
    p.add_argument("--name", default=None, help="Override profile name")
    p.add_argument("--source", default=None, help="Optional source CIDR to add")
    p.set_defaults(func=cmd_recipe_apply)

    return parser


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    # Hidden compat: egress test → explain (no mutation; catalog keeps hidden alias).
    if argv and argv[0] == "test":
        argv[0] = "explain"
    parser = build_parser()
    args = parser.parse_args(argv)
    cfg = load_cfg()
    args.func(cfg, args)


if __name__ == "__main__":
    main()
