import importlib.util, sys
spec = importlib.util.spec_from_file_location("frp_service_id", sys.argv[1])
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
print(mod.pending_change_footer(sys.argv[2], added=True))
PY
}

frp_client_print_pending_saved() {
  echo "Pending change saved."
  echo
  echo "Apply:"
  echo "  service apply"
  echo
  echo "Discard:"
  echo "  service discard"
}

frp_client_print_target_host_help() {
  local py
  py="$(frp_client_service_id_py)" || {
    cat <<'EOF'
Target host is the service machine as seen from this FRP client.

Use:
  127.0.0.1       service runs on this FRP client
