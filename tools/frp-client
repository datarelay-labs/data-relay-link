#!/usr/bin/env bash
set -euo pipefail

frp_client_source_lib() {
  local here cand
  if [[ -n "${FRP_CLIENT_LIB:-}" && -f "${FRP_CLIENT_LIB}" ]]; then
    # shellcheck source=lib/frp-client-common.sh
    . "${FRP_CLIENT_LIB}"
    return 0
  fi
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  for cand in \
    "$here/lib/frp-client-common.sh" \
    "$here/../lib/frp-client-common.sh" \
    /usr/local/lib/frp-auto-deploy/frp-client-common.sh \
    '/Library/Application Support/frp-auto-deploy/lib/frp-client-common.sh'
  do
    if [[ -f "$cand" ]]; then
      # shellcheck source=lib/frp-client-common.sh
      . "$cand"
      return 0
    fi
  done
  echo "ERROR: missing frp-client-common.sh" >&2
  exit 1
}

frp_client_source_lib

frp_state_add_payload() {
  python3 - "$CANDIDATE_FILE" "$1" "$(frp_health_check_py)" <<'PY'
import importlib.util, json, re, sys
from pathlib import Path
path = Path(sys.argv[1])
raw = json.loads(sys.argv[2])
spec = importlib.util.spec_from_file_location('frp_health_check', sys.argv[3])
HC = importlib.util.module_from_spec(spec)
spec.loader.exec_module(HC)
state = json.loads(path.read_text(encoding='utf-8'))
services = state.setdefault('services', {})
sid = str(raw.get('id', '')).strip().lower()
if not re.fullmatch(r'[a-z0-9][a-z0-9._-]{0,31}', sid or ''):
    raise SystemExit('ERROR: invalid service id; use [a-z0-9][a-z0-9._-]{0,31}')
if sid in services:
    raise SystemExit(
        f'ERROR: duplicate service id: {sid}\n\n'
        'A service with this ID already exists.\n'
        'Service IDs are lowercase and case-insensitive.'
    )
protocol = str(raw.get('protocol', 'tcp') or 'tcp').strip().lower()
if protocol != 'tcp':
    raise SystemExit('ERROR: only tcp services are supported')
preset = str(raw.get('preset', 'custom') or 'custom').strip().lower()
if preset not in ('ssh', 'http', 'https', 'custom'):
    raise SystemExit('ERROR: invalid service preset')
name = str(raw.get('name', '') or sid).strip() or sid
if len(name) > 64 or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in name):
    raise SystemExit('ERROR: invalid service display name')
local_ip = str(raw.get('local_ip', '')).strip()
if (not local_ip or len(local_ip) > 253
        or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in local_ip)
        or any(c in local_ip for c in ' /\\;|&$`\'"<>')):
    raise SystemExit('ERROR: invalid target host')
try:
    local_port = int(str(raw.get('local_port', '')).strip())
except Exception:
    raise SystemExit('ERROR: invalid local_port; must be an integer 1-65535')
if local_port < 1 or local_port > 65535:
    raise SystemExit('ERROR: invalid local_port; must be an integer 1-65535')
if len(services) >= 32:
    raise SystemExit('ERROR: too many services')
item = {
    'id': sid,
    'name': name,
    'protocol': 'tcp',
    'local_ip': local_ip,
    'local_port': local_port,
    'preset': preset,
    'enabled': True,
}
if preset == 'ssh':
    ssh_user = str(raw.get('ssh_user', '') or '').strip()
    if not ssh_user:
        raise SystemExit('ERROR: ssh_user is required for ssh services')
    if not re.fullmatch(r'[A-Za-z0-9._@-]{1,32}', ssh_user):
        raise SystemExit('ERROR: invalid ssh_user')
    item['ssh_user'] = ssh_user
try:
    HC.copy_health_check(raw, item)
except HC.HealthCheckError as exc:
    raise SystemExit('ERROR: %s' % exc)
services[sid] = item
path.write_text(json.dumps(state, indent=2, sort_keys=True) + '\n', encoding='utf-8')
PY
}

frp_require_root() {
  if [[ ${EUID} -ne 0 && -z "${FRP_CLIENT_TEST_ROOT:-}" ]]; then
    echo "ERROR: run as root, e.g. sudo frp-client" >&2
    exit 1
  fi
}

frp_client_update_cmd() {
  local source="${FRP_CLIENT_UPDATE_SOURCE:-}"
  local check_only=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --source)
        if [[ $# -lt 2 || "$2" == --* ]]; then
          echo "ERROR: --source requires a directory" >&2
          return 2
        fi
        source="$2"
        shift 2
        ;;
      --check|--dry-run)
        check_only=1
        shift
        ;;
      -h|--help)
        cat <<'EOF'
Usage: frp-client update [--source DIR] [--check]

Upgrade this client's frp-auto-deploy management tools.

  --source DIR   use a local source tree instead of downloading the bundle
  --check        report installed/target versions without changing files

This updates project tools only. It does not require an Enrollment Code,
does not regenerate management identity, and does not rewrite client
state, frpc.toml, or public port assignments. The official frpc binary
is left unchanged when it is already the tested version.

The recommended command is: sudo frpctl update
EOF
        return 0
        ;;
      *)
        echo "ERROR: unknown option: $1" >&2
        echo "Usage: frp-client update [--source DIR] [--check]" >&2
        return 2
        ;;
    esac
  done
  frp_client_fetch_and_upgrade "$source" "$check_only"
}

frp_copy_state() {
  python3 - "$1" "$2" <<'PY'
import json, sys
from pathlib import Path
src, dest = Path(sys.argv[1]), Path(sys.argv[2])
data = json.loads(src.read_text(encoding='utf-8'))
dest.write_text(json.dumps(data, indent=2, sort_keys=True) + '\n', encoding='utf-8')
PY
}

frp_client_status() {
  local path
  path="$(frp_client_state_path)"
  # status is read-only: do not contact the allocator or mutate local state.
  # Use `frp-client sync` (or apply) to reconcile released services.
  frp_load_client_state "$path"
  python3 - "$path" "$(frp_client_installed_frp_version)" "${FRP_CLIENT_TEST_ROOT:-}" "${FRP_SKIP_SYSTEMD:-}" "$(frp_identity_label)" "$(frp_client_installed_project_version)" "$(frp_client_installed_release_channel)" "$(frp_client_installed_source_ref)" "$(frp_client_installed_bundle_sha256)" "$(frp_client_service_status)" "$(frp_health_check_py)" "$(frp_client_lifecycle_label)" "$(frp_client_autostart_label)" <<'PY'
import importlib.util, json, sys
from pathlib import Path
data = json.loads(Path(sys.argv[1]).read_text(encoding='utf-8'))
tested = sys.argv[2]
test_root = sys.argv[3]
skip_systemd = sys.argv[4]
project_version = sys.argv[6]
release_channel = sys.argv[7]
source_ref = sys.argv[8]
bundle_sha256 = sys.argv[9]
services = data.get('services') or {}
enabled = sum(1 for s in services.values() if s.get('enabled', True) is not False)
disabled = len(services) - enabled
active = sys.argv[10]
spec = importlib.util.spec_from_file_location('frp_health_check', sys.argv[11])
HC = importlib.util.module_from_spec(spec)
spec.loader.exec_module(HC)
client_label = HC.client_status_label(active)
lifecycle = sys.argv[12]
autostart = sys.argv[13]
allocator = 'configured' if data.get('allocator_url') else 'missing'
print('FRP Client')
print('==========')
print()
print(f"Role            : Client")
print(f"Project version : {project_version}")
print(f"Release channel : {release_channel}")
print(f"Source ref      : {source_ref}")
print(f"Hostname        : {data.get('hostname', '')}")
print(f"FRP server      : {data.get('frp_server', '')}:{data.get('frp_server_port', '')}")
print(f"Allocator       : {allocator}")
print(f"Management identity : {sys.argv[5]}")
print(f"FRP version     : {tested}")
print(f"Bundle SHA256   : {bundle_sha256}")
print(f"Client state    : {lifecycle}")
print(f"frpc            : {active}")
print(f"Autostart       : {autostart}")
print()
print(f"Services        : {enabled} enabled / {disabled} disabled")
print()
for sid, item in services.items():
    state = 'enabled' if item.get('enabled', True) is not False else 'disabled'
    print(item.get('id') or sid)
    if item.get('local_ip') is not None:
        print(f"  target        : {item.get('local_ip')}:{item.get('local_port')}")
    if item.get('remote_port') is not None:
        print(f"  public port   : {item.get('remote_port')}")
    print(f"  state         : {state}")
    print(f"  health        : {HC.format_health_config(item.get('health_check'))}")
    print(f"  CLIENT        : {client_label}")
    print(f"  TUNNEL        : {HC.tunnel_status_label(item)}")
    print(f"  TARGET        : {HC.target_status_label(item)}")
    print()
PY
  frp_lifecycle_report
  pending="$(frp_client_pending_path)"
  if [[ -f "$pending" ]]; then
    python3 - "$pending" <<'PY'
import json, sys
from pathlib import Path
try:
    data = json.loads(Path(sys.argv[1]).read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(0)
fail = data.get('failure_class') or data.get('FAILURE_CLASS') or ''
if fail:
    print(f"Last failure      : {fail}")
    print("Recovery required : yes")
PY
  fi
  frp_client_print_draft_pending_notice
}

frp_client_print_draft_pending_notice() {
  if [[ -f "$(frp_client_draft_path)" ]]; then
    echo "Pending service changes exist."
    echo "Run:"
    echo "  service apply"
    echo "or:"
    echo "  service discard"
  fi
}

frp_client_list() {
  local path
  path="$(frp_client_state_path)"
  # list is read-only: do not contact the allocator or mutate local state.
  # Use `frp-client sync` (or apply) to reconcile released services.
  frp_load_client_state "$path"
  frp_print_state_services "$path"
  frp_client_print_draft_pending_notice
}

frp_client_info() {
  local path tmp server
  path="$(frp_client_state_path)"
  if [[ ! -f "$path" ]]; then
    echo "ERROR: This client predates local management state." >&2
    echo "Re-enroll once with the current bootstrap installer to initialize frp-client management." >&2
    return 1
  fi
  frp_load_client_state "$path"
  tmp="$(mktemp)"
  server="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("frp_server",""))' "$path")"
  if ! render_access_info "$tmp" "$server" "$path"; then
    rm -f "$tmp"
    return 1
  fi
  cat "$tmp"
  rm -f "$tmp"
}

frp_client_sync() {
  # Explicit mutation: reconcile local services and management metadata.
  frp_load_client_state "$(frp_client_state_path)"
  frp_acquire_client_lock || return 1
  trap 'frp_release_client_lock' EXIT
  if ! frp_client_reconcile_released_services 1; then
    return 1
  fi
  echo "Client sync complete."
}

frp_select_service_id() {
  python3 - "$CANDIDATE_FILE" "$1" <<'PY'
import json, sys
from pathlib import Path
state = json.loads(Path(sys.argv[1]).read_text(encoding='utf-8'))
services = list((state.get('services') or {}).items())
try:
    idx = int(sys.argv[2])
except Exception:
    raise SystemExit('ERROR: invalid service number')
if idx < 1 or idx > len(services):
    raise SystemExit('ERROR: service number out of range')
print(services[idx-1][0])
PY
}

menu_add_service() {
  local payload=""
  frp_ux_prompt_new_service payload
  if [[ -z "$payload" ]]; then
    return 0
  fi
  if ! frp_state_add_payload "$payload"; then
    return 0
  fi
}

