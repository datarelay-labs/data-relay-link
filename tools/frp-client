frp_client_set_service_field() {
  local sid="$1" prop="$2" value="$3"
  frp_client_ensure_pending
  python3 - "$CANDIDATE_FILE" "$sid" "$prop" "$value" "$(frp_health_check_py)" <<'PY'
import importlib.util, json, re, sys
from pathlib import Path
path = Path(sys.argv[1])
sid, prop, value = sys.argv[2:5]
spec = importlib.util.spec_from_file_location('frp_health_check', sys.argv[5])
HC = importlib.util.module_from_spec(spec)
spec.loader.exec_module(HC)
state = json.loads(path.read_text(encoding='utf-8'))
item = (state.get('services') or {}).get(sid)
if not isinstance(item, dict):
    raise SystemExit('ERROR: unknown service: %s' % sid)
if prop == 'name':
    if len(value) > 64 or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in value):
        raise SystemExit('ERROR: invalid service display name')
    item['name'] = value.strip() or sid
elif prop == 'target-host':
    if (not value or len(value) > 253
            or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in value)
            or any(c in value for c in ' /\\;|&$`\'"<>')):
        raise SystemExit('ERROR: invalid target host')
    item['local_ip'] = value
elif prop == 'target-port':
    try:
        port = int(value)
    except Exception:
        raise SystemExit('ERROR: invalid local_port; must be an integer 1-65535')
    if port < 1 or port > 65535:
        raise SystemExit('ERROR: invalid local_port; must be an integer 1-65535')
    item['local_port'] = port
elif prop == 'ssh-user':
    if item.get('preset') != 'ssh':
        raise SystemExit('ERROR: ssh-user is only valid for ssh services')
    if not re.fullmatch(r'[A-Za-z0-9._@-]{1,32}', value or ''):
        raise SystemExit('ERROR: invalid ssh_user')
    item['ssh_user'] = value
elif prop in HC.SERVICE_HEALTH_PROPS:
    try:
        HC.apply_health_property(item, prop, value)
    except HC.HealthCheckError as exc:
        raise SystemExit('ERROR: %s' % exc)
else:
    raise SystemExit('ERROR: unknown service property')
path.write_text(json.dumps(state, indent=2, sort_keys=True) + '\n', encoding='utf-8')
print('Pending change saved.')
print()
print('Apply:')
print('  service apply')
print()
print('Discard:')
print('  service discard')
PY
}

