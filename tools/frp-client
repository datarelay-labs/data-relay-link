frp_client_add_service_wizard() {
  local choice
  echo
  echo "Add service"
  echo "==========="
  echo
  echo "1) SSH"
  echo "2) HTTP"
  echo "3) HTTPS"
  echo "4) Custom TCP"
  echo "5) Server profile"
  echo "6) Cancel"
  echo
  choice="$(frp_client_read_prompt "Select: " "")" || return 1
  case "$choice" in
    1) frp_client_add_service_interactive ssh ;;
    2) frp_client_add_service_interactive http ;;
    3) frp_client_add_service_interactive https ;;
    4) frp_client_add_service_interactive custom ;;
    5) frp_client_add_service_interactive profile ;;
    6|"")
      echo "Cancelled."
      return 0
      ;;
    *)
      echo "ERROR: select 1-6" >&2
      return 2
      ;;
  esac
}

frp_client_read_prompt() {
  local prompt="$1" default="${2:-}" value=""
  if [[ -n "${FRP_CTL_TEST_INPUT:-}" ]]; then
    # Prefer frpctl test harness when nested under guided menus.
    if declare -F frpctl_read >/dev/null 2>&1; then
      frpctl_read "$prompt" "$default"
      return $?
    fi
  fi
  if [[ -t 0 ]]; then
    if ! IFS= read -r -p "$prompt" value; then
      return 1
    fi
  elif [[ -n "${FRP_CLIENT_TEST_INPUT:-}" ]]; then
    if [[ -z "${_FRP_CLIENT_INPUT_READY:-}" ]]; then
      _FRP_CLIENT_INPUT_FILE="$(mktemp)"
      printf '%s' "${FRP_CLIENT_TEST_INPUT}" >"$_FRP_CLIENT_INPUT_FILE"
      if [[ "${FRP_CLIENT_TEST_INPUT}" != *$'\n' ]]; then
        printf '\n' >>"$_FRP_CLIENT_INPUT_FILE"
      fi
      exec 8<"$_FRP_CLIENT_INPUT_FILE"
      _FRP_CLIENT_INPUT_READY=1
    fi
    if ! IFS= read -r value <&8; then
      return 1
    fi
  else
    return 1
  fi
  if [[ -z "$value" ]]; then
    value="$default"
  fi
  printf '%s' "$value"
}

frp_client_add_service_interactive() {
  local preset="$1"
  local host="127.0.0.1" port="" user="" name="" sid="" profile=""
  local default_port="" default_name="" title=""
  case "$preset" in
    ssh)
      title="Add SSH service"
      default_port=22
      default_name="SSH"
      ;;
    http)
      title="Add HTTP service"
      default_port=80
      default_name="HTTP"
      ;;
    https)
      title="Add HTTPS service"
      default_port=443
      default_name="HTTPS"
      ;;
    custom)
      title="Add custom TCP service"
      default_name=""
      ;;
    profile)
      profile="$(frp_client_read_prompt "Profile name: " "")" || return 1
      profile="${profile#"${profile%%[![:space:]]*}"}"
      profile="${profile%"${profile##*[![:space:]]}"}"
      if [[ -z "$profile" ]]; then
        echo "Missing profile." >&2
        echo >&2
        echo "Use:" >&2
        echo "  service add profile <PROFILE>" >&2
        return 2
      fi
      frp_client_add_service_from_profile "$profile" "" ""
      return $?
      ;;
    *)
      echo "ERROR: unknown service type: $preset" >&2
      return 2
      ;;
  esac
  echo
  echo "$title"
  echo "==============="
  echo
  frp_client_print_target_host_help
  echo
  host="$(frp_client_read_prompt "Target host [127.0.0.1]: " "127.0.0.1")" || return 1
  host="${host#"${host%%[![:space:]]*}"}"
  host="${host%"${host##*[![:space:]]}"}"
  [[ -n "$host" ]] || host="127.0.0.1"
  if [[ -n "$default_port" ]]; then
    port="$(frp_client_read_prompt "Target port [${default_port}]: " "$default_port")" || return 1
  else
    port="$(frp_client_read_prompt "Target port: " "")" || return 1
  fi
  port="${port#"${port%%[![:space:]]*}"}"
  port="${port%"${port##*[![:space:]]}"}"
  if [[ ! "$port" =~ ^[0-9]+$ ]] || ((port < 1 || port > 65535)); then
    echo "ERROR: invalid target port; must be an integer 1-65535" >&2
    return 2
  fi
  if [[ "$preset" == "ssh" ]]; then
    echo
    echo "SSH user"
    echo "  Login username shown in the generated SSH connection command."
    echo
    while true; do
      user="$(frp_client_read_prompt "SSH user: " "")" || return 1
      user="${user#"${user%%[![:space:]]*}"}"
      user="${user%"${user##*[![:space:]]}"}"
      [[ -n "$user" ]] && break
      echo "ERROR: SSH user is required." >&2
    done
  fi
  if [[ "$preset" == "custom" ]]; then
    default_name="TCP ${port}"
  fi
  name="$(frp_client_read_prompt "Display name [${default_name}]: " "$default_name")" || return 1
  name="${name#"${name%%[![:space:]]*}"}"
  name="${name%"${name##*[![:space:]]}"}"
  [[ -n "$name" ]] || name="$default_name"
  sid="$(frp_client_suggest_service_id "$preset" "$port")" || return 1
  echo
  echo "Service ID : ${sid} (automatic)"
  echo
  frp_client_add_service_core "$preset" "$sid" "$name" "$host" "$port" "$user"
}

frp_client_add_service_core() {
  local preset="$1" sid="$2" name="$3" host="$4" port="$5" user="${6:-}"
  local payload
  frp_client_ensure_pending
  payload="$(python3 -c 'import json,sys; print(json.dumps({
    "id": sys.argv[1], "name": sys.argv[2], "preset": sys.argv[3],
    "protocol": "tcp", "local_ip": sys.argv[4], "local_port": int(sys.argv[5]),
    "ssh_user": sys.argv[6],
  }))' "$sid" "$name" "$preset" "$host" "$port" "$user")"
  frp_state_add_payload "$payload"
  frp_client_print_pending_added "$sid"
}

frp_client_add_service_from_profile() {
  local selector="$1" sid="$2" name="$3"
  local profile_json payload
  export FRP_SOURCE_ROOT="${FRP_SOURCE_ROOT:-}"
  if [[ -z "${FRP_SOURCE_ROOT}" ]]; then
    local here
    here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -f "$here/../lib/frp_service_profiles.py" ]]; then
      export FRP_SOURCE_ROOT="$(cd "$here/.." && pwd)"
    fi
  fi
  profile_json="$(frp_client_resolve_profile_json "$selector")" || return $?
  frp_client_ensure_pending
  # Auto-generate Service ID from profile preset when not overridden.
  if [[ -z "$sid" ]]; then
    local preset_hint port_hint
    preset_hint="$(PROFILE_JSON="$profile_json" python3 - <<'PY'
import json, os
p = json.loads(os.environ["PROFILE_JSON"])
print(str(p.get("preset") or "custom").strip().lower() or "custom")
PY
)"
    port_hint="$(PROFILE_JSON="$profile_json" python3 - <<'PY'
import json, os
p = json.loads(os.environ["PROFILE_JSON"])
print(p.get("target_port") or p.get("local_port") or "")
PY
)"
    sid="$(frp_client_suggest_service_id "$preset_hint" "${port_hint:-}")" || return 1
  fi
  payload="$(PROFILE_JSON="$profile_json" FRP_SOURCE_ROOT="${FRP_SOURCE_ROOT:-}" python3 - "$sid" "$name" <<'PY'
import importlib.util
import json
import os
import sys
from pathlib import Path

def load_prof():
    candidates = []
    src = os.environ.get("FRP_SOURCE_ROOT", "")
    if src:
        candidates.append(Path(src) / "lib" / "frp_service_profiles.py")
    lib = os.environ.get("FRP_CLIENT_LIB", "")
    if lib:
        base = Path(lib).resolve().parent
        candidates.append(base / "frp_service_profiles.py")
        candidates.append(base.parent / "lib" / "frp_service_profiles.py")
    root = os.environ.get("FRP_DEPLOY_TEST_ROOT", "") or os.environ.get("FRP_CLIENT_TEST_ROOT", "")
    if root:
        candidates.append(Path(root) / "usr/local/lib/frp-auto-deploy/frp_service_profiles.py")
    candidates.append(Path("/usr/local/lib/frp-auto-deploy/frp_service_profiles.py"))
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location("frp_service_profiles", str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise SystemExit("ERROR: missing frp_service_profiles.py")

PROF = load_prof()
profile = json.loads(os.environ["PROFILE_JSON"])
payload = PROF.profile_to_service_payload(profile, service_id=sys.argv[1] or None, name=sys.argv[2] or None)
print(json.dumps(payload))
PY
)" || return $?
  frp_state_add_payload "$payload"
  sid="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["id"])' "$payload")"
  python3 - "$payload" "$selector" <<'PY' 2>/dev/null || true
import importlib.util, json, os, sys
from pathlib import Path
payload = json.loads(sys.argv[1])
selector = sys.argv[2]
candidates = []
src = os.environ.get("FRP_SOURCE_ROOT", "")
if src:
    candidates.append(Path(src) / "lib" / "frp_audit.py")
root = os.environ.get("FRP_DEPLOY_TEST_ROOT", "")
if root:
    candidates.append(Path(root) / "usr/local/lib/frp-auto-deploy/frp_audit.py")
candidates.append(Path("/usr/local/lib/frp-auto-deploy/frp_audit.py"))
for path in candidates:
    if path.is_file():
        spec = importlib.util.spec_from_file_location("frp_audit", str(path))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        mod.try_emit(
            "profile.applied_to_draft",
            profile_id=selector,
            details={"service_id": payload.get("id"), "preset": payload.get("preset")},
        )
        break
PY
  echo "Pending service '${sid}' added from profile ${selector}."
  echo
  echo "Apply:"
  echo "  service apply"
  echo
  echo "Discard:"
  echo "  service discard"
}

frp_client_add_service_cli() {
  local preset="" sid="" name="" host="127.0.0.1" port="" user="" profile=""
  local positional="" host_set=0

  # Bare invocation → guided wizard (TTY) or concise usage (non-TTY).
  if [[ $# -eq 0 ]]; then
    if [[ -t 0 || -n "${FRP_CTL_TEST_INPUT:-}" || -n "${FRP_CLIENT_TEST_INPUT:-}" ]]; then
      frp_client_add_service_wizard
      return $?
    fi
    frp_client_print_add_usage
    return 2
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        [[ $# -ge 2 ]] || { echo "ERROR: --profile requires a value" >&2; return 2; }
        profile="$2"; shift 2
        ;;
      --preset)
        [[ $# -ge 2 ]] || { echo "ERROR: --preset requires a value" >&2; return 2; }
        preset="$2"; shift 2
        ;;
      --id)
        [[ $# -ge 2 ]] || { echo "ERROR: --id requires a value" >&2; return 2; }
        sid="$2"; shift 2
        ;;
      --name)
        [[ $# -ge 2 ]] || { echo "ERROR: --name requires a value" >&2; return 2; }
        name="$2"; shift 2
        ;;
      --target-host)
        [[ $# -ge 2 ]] || { echo "ERROR: --target-host requires a value" >&2; return 2; }
        host="$2"; host_set=1; shift 2
        ;;
      --target-port)
        [[ $# -ge 2 ]] || { echo "ERROR: --target-port requires a value" >&2; return 2; }
        port="$2"; shift 2
        ;;
      --ssh-user)
        [[ $# -ge 2 ]] || { echo "ERROR: --ssh-user requires a value" >&2; return 2; }
        user="$2"; shift 2
        ;;
      -h|--help|help|\?)
        local py
        py="$(frp_client_service_id_py)" && python3 "$py" add-help && return 0
        frp_client_print_add_usage
        return 0
        ;;
      --*)
        echo "ERROR: unknown add service option: $1" >&2
        return 2
        ;;
      ssh|http|https|custom|profile)
        if [[ -n "$positional" ]]; then
          if [[ "$positional" == "profile" && -z "$profile" ]]; then
            profile="$1"; shift
            continue
          fi
          echo "ERROR: unexpected argument: $1" >&2
          return 2
        fi
        positional="$1"
        shift
        if [[ "$positional" == "profile" && $# -gt 0 && "$1" != --* ]]; then
          profile="$1"
          shift
        fi
        ;;
      *)
        echo "ERROR: unknown add service argument: $1" >&2
        echo >&2
        frp_client_print_add_usage
        return 2
        ;;
    esac
  done

  if [[ -n "$positional" ]]; then
    if [[ "$positional" == "profile" ]]; then
      profile="${profile}"
    else
      preset="$positional"
    fi
  fi

  if [[ "$positional" == "profile" || -n "$profile" ]]; then
    if [[ -n "$preset" && "$preset" != "custom" ]]; then
      echo "ERROR: when using a profile, do not also set a preset type" >&2
      return 2
    fi
    if [[ -n "$port" || -n "$user" ]]; then
      echo "ERROR: when using a profile, do not also set --target-port/--ssh-user" >&2
      return 2
    fi
    if [[ -z "$profile" ]]; then
      if [[ -t 0 || -n "${FRP_CTL_TEST_INPUT:-}" || -n "${FRP_CLIENT_TEST_INPUT:-}" ]]; then
        frp_client_add_service_interactive profile
        return $?
      fi
      echo "Missing profile." >&2
      echo >&2
      echo "Use:" >&2
      echo "  service add profile <PROFILE>" >&2
      return 2
    fi
    frp_client_add_service_from_profile "$profile" "$sid" "$name"
    return $?
  fi

  if [[ -z "$preset" ]]; then
    if [[ -t 0 || -n "${FRP_CTL_TEST_INPUT:-}" || -n "${FRP_CLIENT_TEST_INPUT:-}" ]]; then
      frp_client_add_service_wizard
      return $?
    fi
    frp_client_print_add_usage
    return 2
  fi

  # Interactive type with no required flags → guided prompts for missing fields.
  case "$preset" in
    ssh)
      if [[ -z "$user" ]]; then
        if [[ -t 0 || -n "${FRP_CTL_TEST_INPUT:-}" || -n "${FRP_CLIENT_TEST_INPUT:-}" ]]; then
          # Keep any explicit flags; prompt only for remaining fields.
          if [[ -z "$port" && "$host" == "127.0.0.1" && "$host_set" -eq 0 && -z "$name" && -z "$sid" ]]; then
            frp_client_add_service_interactive ssh
            return $?
          fi
        fi
        cat <<'EOF' >&2
SSH user is required.

Example:
  service add ssh --ssh-user aella

For a LAN host:
  service add ssh --target-host 192.168.10.20 --ssh-user root
EOF
        return 2
      fi
      name="${name:-SSH}"
      port="${port:-22}"
      ;;
    http)
      name="${name:-HTTP}"
      port="${port:-80}"
      ;;
    https)
      name="${name:-HTTPS}"
      port="${port:-443}"
      ;;
    custom)
      if [[ -z "$port" ]]; then
        if [[ -t 0 || -n "${FRP_CTL_TEST_INPUT:-}" || -n "${FRP_CLIENT_TEST_INPUT:-}" ]]; then
          frp_client_add_service_interactive custom
          return $?
        fi
        echo "Target port is required." >&2
        echo >&2
        echo "Example:" >&2
        echo "  service add custom --target-port 3389" >&2
        return 2
      fi
      name="${name:-TCP ${port}}"
      ;;
    *)
      echo "ERROR: service type must be ssh, http, https, custom, or profile" >&2
      return 2
      ;;
  esac

  if [[ -z "$sid" ]]; then
    sid="$(frp_client_suggest_service_id "$preset" "$port")" || return 1
  fi
  frp_client_add_service_core "$preset" "$sid" "$name" "$host" "$port" "$user"
}

frp_client_apply_pending() {
  local pending
  pending="$(frp_client_draft_path)"
  if [[ ! -f "$pending" ]]; then
    echo "No pending service changes."
    return 0
  fi
  CANDIDATE_FILE="$pending"
  export FRP_CLIENT_CANDIDATE="$pending"
  current="$(frp_client_state_path)"
  frp_load_client_state "$current"
  frp_acquire_client_lock || return 1
  trap 'unset FRP_ENROLLMENT_CODE FRP_CLIENT_OPERATION_ID; frp_release_client_lock' EXIT
  frp_apply_candidate
  rm -f "$pending"
}

frp_client_discard_pending() {
  local pending
  pending="$(frp_client_draft_path)"
  frp_acquire_client_lock || return 1
  trap 'frp_release_client_lock' EXIT
  rm -f "$pending"
  echo "Pending service changes discarded."
}

frp_client_cmd_main() {
  local cmd="${1:-}"
  case "$cmd" in
    '' )
      frp_require_root
      frp_client_interactive
      ;;
    status)
      frp_require_root
      frp_client_status
      ;;
    info)
      frp_require_root
      frp_client_info
      ;;
    list)
      frp_require_root
      frp_client_list
      ;;
    sync|reconcile)
      frp_require_root
      frp_client_sync
      ;;
    apply)
      frp_require_root
      current="$(frp_client_state_path)"
      frp_load_client_state "$current"
      CANDIDATE_FILE="${FRP_CLIENT_CANDIDATE:-}"
      if [[ -z "$CANDIDATE_FILE" || ! -f "$CANDIDATE_FILE" ]]; then
        echo "ERROR: FRP_CLIENT_CANDIDATE must point at a candidate state file" >&2
        exit 1
      fi
      frp_acquire_client_lock || exit 1
      trap 'unset FRP_ENROLLMENT_CODE FRP_CLIENT_OPERATION_ID; frp_release_client_lock' EXIT
      trap 'exit 130' INT TERM
      frp_apply_candidate
      ;;
    update)
      frp_require_root
      shift
      frp_client_update_cmd "$@"
      ;;
    add-service)
      frp_require_root
      shift
      frp_acquire_client_lock || exit 1
      trap 'frp_release_client_lock' EXIT
      frp_load_client_state "$(frp_client_state_path)"
      frp_client_add_service_cli "$@"
      ;;
    set-service)
      frp_require_root
      shift
      [[ $# -ge 3 ]] || { echo "ERROR: usage: frp-client set-service <id> <property> <value>" >&2; exit 2; }
      frp_acquire_client_lock || exit 1
      trap 'frp_release_client_lock' EXIT
      frp_load_client_state "$(frp_client_state_path)"
      frp_client_set_service_field "$1" "$2" "$3"
      ;;
    enable-service)
      frp_require_root
      shift
      [[ $# -ge 1 ]] || { echo "ERROR: usage: frp-client enable-service <id>" >&2; exit 2; }
      frp_acquire_client_lock || exit 1
      trap 'frp_release_client_lock' EXIT
      frp_load_client_state "$(frp_client_state_path)"
      frp_client_set_service_enabled "$1" 1
      ;;
    disable-service)
      frp_require_root
      shift
      [[ $# -ge 1 ]] || { echo "ERROR: usage: frp-client disable-service <id>" >&2; exit 2; }
      frp_acquire_client_lock || exit 1
      trap 'frp_release_client_lock' EXIT
      frp_load_client_state "$(frp_client_state_path)"
      frp_client_set_service_enabled "$1" 0
      ;;
    apply-pending)
      frp_require_root
      frp_client_apply_pending
      ;;
    discard-pending)
      frp_require_root
      frp_client_discard_pending
      ;;
    pause)
      frp_require_root
      frp_client_pause
      ;;
    resume)
      frp_require_root
      frp_client_resume
      ;;
    -h|--help|help)
      cat <<'EOF'
Usage: frp-client [status|info|list|sync|update|pause|resume]

  (no args)   Interactive service management menu
  status      Show local client and service status (read-only)
  info        Show connection information (read-only)
  list        List configured services (read-only)
  sync        Reconcile local services against server releases
  update      Upgrade frp-auto-deploy management tools without re-enrolling
  pause       Stop frpc and disable autostart (identity preserved)
  resume      Re-enable autostart and start frpc

An Enrollment Code is required only to enroll this client or to
recover its management identity. Ordinary later changes are
authorized by the local client identity and do not require a
new Enrollment Code. A software update does not require an
Enrollment Code. Read-only commands (status/info/list) do not
contact the allocator. Use sync (or apply) to reconcile releases.

For everyday use, prefer: sudo frpctl
EOF
      ;;
    *)
      echo "ERROR: unknown command: $cmd" >&2
      echo "Usage: frp-client [status|info|list|sync|update|pause|resume]" >&2
      exit 2
      ;;
  esac
}

if [[ "${FRP_CLIENT_TOOL_SOURCED:-}" != "1" ]]; then
  frp_client_cmd_main "$@"
fi
