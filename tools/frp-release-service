#!/usr/bin/env python3
import argparse
import fcntl
import importlib.util
import json
import os
import sys
import tempfile
from pathlib import Path

ROOT = os.environ.get('FRP_DEPLOY_TEST_ROOT', '')


def load_creg():
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / 'lib' / 'frp_client_registry.py',
        Path('/usr/local/lib/drlink/frp_client_registry.py'),
    ]
    if ROOT:
        candidates.insert(1, Path(ROOT) / 'usr/local/lib/drlink/frp_client_registry.py')
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location('frp_client_registry', str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise SystemExit('ERROR: missing frp_client_registry.py')


CREG = load_creg()


def load_locks():
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / 'lib' / 'frp_control_locks.py',
        Path('/usr/local/lib/drlink/frp_control_locks.py'),
    ]
    if ROOT:
        candidates.insert(1, Path(ROOT) / 'usr/local/lib/drlink/frp_control_locks.py')
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location('frp_control_locks', str(path))
            mod = importlib.util.module_from_spec(spec)
            sys.modules['frp_control_locks'] = mod
            spec.loader.exec_module(mod)
            return mod
    raise SystemExit('ERROR: missing frp_control_locks.py')


LOCKS = load_locks()


def control_root():
    return Path(ROOT or '/')


def lock_registry(path):
    lock_path = Path(path).resolve().parent / 'registry.lock'
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(lock_path), os.O_CREAT | os.O_RDWR, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def unlock_registry(fd):
    if fd is None:
        return
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass
    try:
        os.close(fd)
    except OSError:
        pass


def atomic_write_json(path, data, mode=0o600):
    fd, tmp = tempfile.mkstemp(prefix=path.name + '.', suffix='.tmp', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2, sort_keys=True)
            f.write('\n')
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def require_v2(state):
    if not isinstance(state, dict) or state.get('schema_version') != 2:
        version = 1
        if isinstance(state, dict) and 'schema_version' in state:
            version = state.get('schema_version')
        raise SystemExit(
            f'ERROR: unsupported registry schema version {version}.\n\n'
            'This release requires registry schema version 2.\n\n'
            'Back up the existing registry and redeploy/reset it explicitly before continuing.'
        )
    for client in (state.get('clients') or {}).values():
        if not isinstance(client, dict):
            raise SystemExit(
                'ERROR: unsupported registry schema version 2.\n\n'
                'This release requires registry schema version 2.\n\n'
                'Back up the existing registry and redeploy/reset it explicitly before continuing.'
            )
        if 'ssh_port' in client or 'https_port' in client:
            raise SystemExit(
                'ERROR: unsupported registry schema version 2.\n\n'
                'Legacy SSH/HTTPS fields are present. This release requires the generic multi-service registry.\n\n'
                'Back up the existing registry and redeploy/reset it explicitly before continuing.'
            )


parser = argparse.ArgumentParser(description='Release one service reservation for a client')
parser.add_argument('query', help='label, unique hostname, or machine-id prefix')
parser.add_argument('service_id', help='service id to release')
parser.add_argument('--force', action='store_true', help='release even if the published port is currently active')
args = parser.parse_args()


def ensure_releasable(service, force=False):
    state = CREG.passive_port_state(service.get('remote_port'))
    if state != 'offline' and not force:
        raise SystemExit(
            'Service state is %s. Stop publishing it first, or use --force.' % state
        )


cfg = json.loads(Path(ROOT + '/etc/drlink/config.json').read_text())
path = Path(cfg['registry_file'])
if ROOT and not str(path).startswith(ROOT):
    path = Path(ROOT + str(path))
state = json.loads(path.read_text())
require_v2(state)

# Capture immutable CLIENT ID before confirmation; never re-resolve label/hostname.
confirmed_mid, client = CREG.resolve_client_or_exit(state, args.query)
mid = confirmed_mid

sid = str(args.service_id).strip().lower()
services = client.get('services') or {}
if not isinstance(services, dict) or sid not in services:
    raise SystemExit(f'ERROR: service {sid} was not found on this client')
svc = services[sid]
if not isinstance(svc, dict):
    raise SystemExit(f'ERROR: service {sid} was not found on this client')
port = svc.get('remote_port')
if port:
    ensure_releasable(svc, args.force)

print(f'Releasing {CREG.sanitize_display(CREG.display_name(client, mid), 64)} '
      f'({CREG.sanitize_display(mid, 128)}) service {CREG.sanitize_display(sid, 32)}')
if port:
    print(f'Port: {port}')
answer = input('Type RELEASE to continue: ')
if answer != 'RELEASE':
    raise SystemExit('Cancelled')

acl_cleanup_error = None
with LOCKS.acquire_control_state_lock(control_root()):
    lock_fd = lock_registry(path)
    try:
        state = json.loads(path.read_text())
        require_v2(state)
        clients = state.get('clients') or {}
        if confirmed_mid not in clients or not isinstance(clients.get(confirmed_mid), dict):
            raise SystemExit(
                'ERROR: Target changed while waiting for confirmation.\n'
                'Re-run the command.'
            )
        mid = confirmed_mid
        client = clients[mid]
        services = client.get('services') or {}
        if not isinstance(services, dict) or sid not in services:
            raise SystemExit(
                'ERROR: Target changed while waiting for confirmation.\n'
                'Re-run the command.'
            )
        svc = services[sid]
        if not isinstance(svc, dict):
            raise SystemExit(
                'ERROR: Target changed while waiting for confirmation.\n'
                'Re-run the command.'
            )
        port = svc.get('remote_port')
        # Re-check under the registry lock to close the TOCTOU window.
        if port:
            ensure_releasable(svc, args.force)
        services.pop(sid)
        # Keep the Client record even when no services remain. A zero-service
        # management-only Client is valid; only `release client` removes it.
        client['services'] = services
        state['clients'][mid] = client
        atomic_write_json(path, state)
    finally:
        unlock_registry(lock_fd)

    # Access Control binding cleanup is required after registry release.
    # Lock order already held: control-state → registry (released) → ACL
    # per-resource lock taken inside mutate_access_state (never reverse).
    try:
        if os.environ.get('FRP_TEST_FAIL_ACL_CLEANUP') == '1':
            raise RuntimeError('injected ACL cleanup failure')
        here = Path(__file__).resolve()
        acl_candidates = [
            here.parent.parent / 'lib' / 'frp_access_control.py',
            Path('/usr/local/lib/drlink/frp_access_control.py'),
        ]
        if ROOT:
            acl_candidates.insert(1, Path(ROOT) / 'usr/local/lib/drlink/frp_access_control.py')
        acl = None
        for acl_path in acl_candidates:
            if not acl_path.is_file():
                continue
            spec = importlib.util.spec_from_file_location('frp_access_control', str(acl_path))
            acl = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(acl)
            break
        if acl is None:
            raise RuntimeError('frp_access_control.py is unavailable')
        access_path = acl.access_control_path(cfg)
        if access_path.is_file():
            def _clear(state, _mid=mid, _sid=sid):
                acl.clear_service_binding(state, _mid, _sid)

            acl.mutate_access_state(_clear, path=access_path, cfg=cfg)
    except Exception as exc:
        acl_cleanup_error = str(exc)

try:
    here = Path(__file__).resolve()
    for audit_path in (
        here.parent.parent / 'lib' / 'frp_audit.py',
        Path('/usr/local/lib/drlink/frp_audit.py'),
    ):
        if audit_path.is_file():
            spec = importlib.util.spec_from_file_location('frp_audit', str(audit_path))
            audit = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(audit)
            details = {'service_id': sid, 'remote_port': port}
            if acl_cleanup_error:
                details['acl_cleanup_error'] = acl_cleanup_error
                audit.try_emit(
                    'service.release_partial',
                    client_id=mid,
                    details=details,
                )
            else:
                audit.try_emit(
                    'service.released',
                    client_id=mid,
                    details=details,
                )
            break
except Exception:
    pass
if acl_cleanup_error:
    print(
        'ERROR: service released from registry, but Access Control cleanup failed: %s'
        % acl_cleanup_error,
        file=sys.stderr,
    )
    print('PARTIAL: registry updated; Access binding may still reference this service.')
    raise SystemExit(1)
print('Released.')
