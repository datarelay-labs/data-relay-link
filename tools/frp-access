def cmd_remove_expired(cfg, args):
    state = ACL.load_access_state(cfg=cfg)
    lid, lst = ACL.resolve_access_list(state, args.list)
    now = ACL.utc_now()
    expired = []
    for entry in lst.get("entries") or []:
        exp = ACL.parse_iso_ts(entry.get("expires_at")) if entry.get("expires_at") else None
        if exp is not None and exp <= now:
            expired.append(entry)
    if not expired:
        print("Removed 0 expired entries")
        return
    confirm_shared_list_mutation(cfg, lid, yes=bool(args.yes))

    def mut(state):
        return ACL.remove_expired_entries(state, lid)

    try:
        removed = ACL.mutate_access_state(mut, cfg=cfg)
    except ACL.AccessError as exc:
        raise SystemExit("ERROR: %s" % exc)
    print("Removed %d expired entr%s" % (len(removed), "y" if len(removed) == 1 else "ies"))


def resolve_service(cfg, client_sel, service_id):
    registry = load_registry(cfg)
    mid, client = CREG.resolve_client_or_exit(registry, client_sel)
    sid = str(service_id).strip().lower()
    services = client.get("services") or {}
    if sid not in services:
        raise SystemExit("ERROR: service not found: %s" % sid)
    return registry, mid, client, sid, services[sid]


def cmd_assign(cfg, args):
    registry, mid, _client, sid, svc = resolve_service(cfg, args.client, args.service)

    def mut(state):
        lid, lst = ACL.resolve_access_list(state, args.list)
        ACL.set_service_binding(state, mid, sid, ACL.MODE_ALLOWLIST, lid)
        return lst

    try:
        lst = ACL.mutate_access_state(mut, cfg=cfg)
    except ACL.AccessError as exc:
        # Interactive empty-allowlist UX
        msg = str(exc)
        if "No allowed sources" in msg and sys.stdin.isatty():
            print(msg)
            print()
            print("1) Add source")
            print("2) Cancel")
            choice = input("Select [2]: ").strip() or "2"
            if choice == "1":
                print()
                print("Add a source first:")
                print()
                print(
                    "  access add-source %s --name <name> --source <CIDR>"
                    % args.list
                )
                raise SystemExit(2)
            raise SystemExit(0)
        raise SystemExit("ERROR: %s" % exc)
    print("Assigned Access List %s to %s:%s (port %s)" % (
        lst.get("name"), short_client(registry, mid), sid, svc.get("remote_port"),
    ))


def cmd_public(cfg, args):
    registry, mid, _client, sid, svc = resolve_service(cfg, args.client, args.service)

    def mut(state):
        ACL.set_service_binding(state, mid, sid, ACL.MODE_PUBLIC, None)
        return True

    ACL.mutate_access_state(mut, cfg=cfg)
    print("Set %s:%s to PUBLIC (port %s)" % (
        short_client(registry, mid), sid, svc.get("remote_port"),
    ))


def cmd_show_service(cfg, args):
    registry, mid, client, sid, svc = resolve_service(cfg, args.client, args.service)
    state = ACL.load_access_state(cfg=cfg)
    binding = ACL.get_service_binding(state, mid, sid)
    print("Service Access")
    print("==============")
    print()
    print("Client        : %s" % short_client(registry, mid))
    print("Service ID    : %s" % sid)
    print("Public port   : %s" % (svc.get("remote_port") if svc else "-"))
    print("State         : %s" % ("ENABLED" if svc.get("enabled", True) else "DISABLED"))
    print("Access mode   : %s" % binding["access_mode"])
    list_name = "-"
    entries = []
    if binding["access_mode"] == ACL.MODE_ALLOWLIST and binding.get("access_list_id"):
        lst = (state.get("access_lists") or {}).get(binding["access_list_id"]) or {}
        list_name = lst.get("name") or binding["access_list_id"]
        entries = lst.get("entries") or []
    print("Access list   : %s" % list_name)
    print()
    print("Allowed sources")
    print("---------------")
    if binding["access_mode"] == ACL.MODE_PUBLIC:
        print("(public — any source)")
    elif not entries:
        print("(none)")
    else:
        for entry in entries:
            exp = ACL.parse_iso_ts(entry.get("expires_at")) if entry.get("expires_at") else None
            print(
                "%-18s %-20s %s"
                % (
                    CREG.sanitize_display(entry.get("name") or "-", 18),
                    entry.get("cidr") or "-",
                    ACL.format_remaining(exp),
                )
            )
    print()
    print("Recent Access")
    print("-------------")
    events = ACL.read_conn_log(cfg=cfg, client_id=mid, service_id=sid, limit=5)
    if not events:
        print("(none)")
    else:
        for event in events:
            ts = str(event.get("timestamp") or "")
            if "T" in ts:
                ts = ts.replace("T", " ").replace("Z", "")
                if len(ts) >= 8:
                    ts = ts[11:19] if len(ts) >= 19 else ts
            match = event.get("matched_entry_name") or "-"
            if event.get("reason") == ACL.REASON_ENTRY_EXPIRED and match != "-":
                match = "%s (expired)" % match
            print(
                "%-10s %-16s %-6s %s"
                % (ts, event.get("source_ip") or "-", event.get("decision") or "-", match)
            )


def cmd_test(cfg, args):
    registry, mid, _client, sid, svc = resolve_service(cfg, args.client, args.service)
    state = ACL.load_access_state(cfg=cfg)
    verdict = ACL.authorize(
        state,
        registry,
        client_id=mid,
        service_id=sid,
        source_ip=args.source,
    )
    binding = ACL.get_service_binding(state, mid, sid)
    list_name = "-"
    if binding.get("access_list_id"):
        lst = (state.get("access_lists") or {}).get(binding["access_list_id"]) or {}
        list_name = lst.get("name") or binding["access_list_id"]
    print("Access Policy Test")
    print("==================")
    print()
    print("Client        : %s" % short_client(registry, mid))
    print("Service ID    : %s" % sid)
    print("Public port   : %s" % (svc.get("remote_port") if svc else "-"))
    print("Mode          : %s" % verdict.get("access_mode"))
    print("Access list   : %s" % list_name)
    print("Source IP     : %s" % verdict.get("source_ip"))
    print()
    if verdict.get("matched_entry_name"):
        print("Matched entry")
        print("-------------")
        print("%s" % verdict.get("matched_entry_name"))
        # find cidr
        lst = (state.get("access_lists") or {}).get(binding.get("access_list_id")) or {}
        for entry in lst.get("entries") or []:
            if entry.get("id") == verdict.get("matched_entry_id"):
                print("%s" % entry.get("cidr"))
                break
        print()
    print("Decision      : %s" % verdict.get("decision"))
    if verdict.get("decision") != ACL.DECISION_ALLOW or verdict.get("reason") != ACL.REASON_PUBLIC:
        if verdict.get("decision") == ACL.DECISION_DENY or verdict.get("reason") not in (
            ACL.REASON_PUBLIC,
            ACL.REASON_CIDR_MATCH,
        ):
            print("Reason        : %s" % verdict.get("reason"))
        elif verdict.get("reason") == ACL.REASON_CIDR_MATCH:
            pass
        else:
            print("Reason        : %s" % verdict.get("reason"))


def cmd_log(cfg, args):
    registry, mid, _client, sid, _svc = resolve_service(cfg, args.client, args.service)
    decision = None
    if args.allow and args.deny:
        raise SystemExit("ERROR: use only one of --allow / --deny")
    if args.allow:
        decision = ACL.DECISION_ALLOW
    elif args.deny:
        decision = ACL.DECISION_DENY
    events = ACL.read_conn_log(
        cfg=cfg,
        client_id=mid,
        service_id=sid,
        decision=decision,
        limit=args.limit,
    )
    print("Recent Access")
    print("=============")
    print()
    print("%-20s %-15s %-8s %s" % ("TIME", "SOURCE", "DECISION", "MATCH"))
    if not events:
        print("(none)")
        return
    for event in events:
        ts = str(event.get("timestamp") or "").replace("T", " ").replace("Z", "")
        if len(ts) > 19:
            ts = ts[:19]
        match = event.get("matched_entry_name") or "-"
        if event.get("reason") == ACL.REASON_ENTRY_EXPIRED and match != "-":
            match = "%s (expired)" % match
        print(
            "%-20s %-15s %-8s %s"
            % (ts, event.get("source_ip") or "-", event.get("decision") or "-", match)
        )


def _short_client_id(mid: str, mids: list[str], n: int = 8) -> str:
    text = str(mid)
    length = min(n, len(text)) or 1
    while length <= len(text):
        prefix = text[:length]
        if sum(1 for item in mids if str(item).startswith(prefix)) == 1:
            return prefix
        length += 1
    return text


def pick_client(cfg) -> str:
    """Numbered local client picker. Returns CLIENT ID selector or typed value."""
    reg = load_registry(cfg)
    clients = reg.get("clients") or {}
    if not isinstance(clients, dict) or not clients:
        return input("Client: ").strip()
    items = [(str(mid), client) for mid, client in clients.items() if isinstance(client, dict)]
    mids = [mid for mid, _ in items]
    print()
    print("Select client:")
    print()
    rows = []
    for mid, client in sorted(items, key=lambda pair: pair[0]):
        cid = _short_client_id(mid, mids)
        label = str(client.get("label") or "-").strip() or "-"
        host = str(client.get("hostname") or "-").strip() or "-"
        rows.append((cid, mid, label, host))
    for idx, (cid, _mid, label, host) in enumerate(rows, start=1):
        print("%d) %-10s %-12s %s" % (idx, cid, label, host))
    print()
    choice = input("Select: ").strip()
    if choice.isdigit():
        n = int(choice)
        if 1 <= n <= len(rows):
            return rows[n - 1][0]
    return choice


def pick_service(cfg, client_sel: str) -> str:
    """Numbered service picker for one client. Falls back to typed Service ID."""
    reg = load_registry(cfg)
    clients = reg.get("clients") or {}
    mid = None
    client = None
    # Resolve short/label/host like other tools when possible.
    try:
        mid, client = CREG.resolve_client(reg, client_sel)
    except Exception:
        for key, item in clients.items():
            if str(key) == client_sel or str(key).startswith(client_sel):
                mid, client = str(key), item
                break
            if isinstance(item, dict) and (
                str(item.get("label") or "") == client_sel
                or str(item.get("hostname") or "") == client_sel
            ):
                mid, client = str(key), item
                break
    services = (client or {}).get("services") or {} if isinstance(client, dict) else {}
    if not isinstance(services, dict) or not services:
        return input("Service ID: ").strip()
    print()
    print("Select service:")
    print()
    rows = []
    for sid, item in sorted(services.items(), key=lambda pair: str(pair[0])):
        rec = item if isinstance(item, dict) else {}
        port = rec.get("remote_port") or "-"
        rows.append((str(sid), port))
    for idx, (sid, port) in enumerate(rows, start=1):
        print("%d) %-12s %s" % (idx, sid, port))
    print()
    choice = input("Select: ").strip()
    if choice.isdigit():
        n = int(choice)
        if 1 <= n <= len(rows):
            return rows[n - 1][0]
    return choice


def pick_access_list(cfg) -> str:
    state = ACL.load_access_state(cfg=cfg)
    lists = state.get("access_lists") or {}
    if not isinstance(lists, dict) or not lists:
        return input("Access list: ").strip()
    print()
    print("Select Access List:")
    print()
    rows = []
    for lid, lst in sorted(lists.items(), key=lambda pair: str((pair[1] or {}).get("name") or pair[0])):
        name = str((lst or {}).get("name") or lid)
        rows.append((str(lid), name))
    for idx, (lid, name) in enumerate(rows, start=1):
        print("%d) %s" % (idx, name))
    print()
    choice = input("Select: ").strip()
    if choice.isdigit():
        n = int(choice)
        if 1 <= n <= len(rows):
            return rows[n - 1][1]
    return choice


def interactive_menu(cfg):
    while True:
        print()
        print("Access Control")
        print("==============")
        print()
        print("1) List access lists")
        print("2) Create access list")
        print("3) Edit access list")
        print("4) Delete access list")
        print("5) Assign access list to service")
        print("6) Set service PUBLIC")
        print("7) Show service access")
        print("8) Test source IP")
        print("9) Recent access log")
        print("10) Back")
        choice = input("Select: ").strip()
        if choice in ("10", "q", "Q", ""):
            return
        try:
            if choice == "1":
                cmd_list(cfg, argparse.Namespace())
            elif choice == "2":
                name = input("Name: ").strip()
                desc = input("Description (optional): ").strip()
                cmd_create(cfg, argparse.Namespace(name=name, description=desc))
            elif choice == "3":
                interactive_edit_list(cfg)
            elif choice == "4":
                sel = pick_access_list(cfg)
                cmd_delete(cfg, argparse.Namespace(list=sel))
            elif choice == "5":
                client = pick_client(cfg)
                service = pick_service(cfg, client)
                lst = pick_access_list(cfg)
                cmd_assign(cfg, argparse.Namespace(client=client, service=service, list=lst))
            elif choice == "6":
                client = pick_client(cfg)
                service = pick_service(cfg, client)
                cmd_public(cfg, argparse.Namespace(client=client, service=service))
            elif choice == "7":
                client = pick_client(cfg)
                service = pick_service(cfg, client)
                cmd_show_service(cfg, argparse.Namespace(client=client, service=service))
            elif choice == "8":
                client = pick_client(cfg)
                service = pick_service(cfg, client)
                source = input("Source IP: ").strip()
                cmd_test(cfg, argparse.Namespace(client=client, service=service, source=source))
            elif choice == "9":
                client = pick_client(cfg)
                service = pick_service(cfg, client)
                cmd_log(
                    cfg,
                    argparse.Namespace(client=client, service=service, limit=50, allow=False, deny=False),
                )
            else:
                print("Unknown selection")
        except (ACL.AccessError, SystemExit) as exc:
            if isinstance(exc, SystemExit):
                code = exc.code
                if code not in (0, None):
                    print(exc if isinstance(code, str) else ("ERROR" if code else ""), file=sys.stderr)
            else:
                print("ERROR: %s" % exc, file=sys.stderr)


def interactive_edit_list(cfg):
    sel = pick_access_list(cfg)
    state = ACL.load_access_state(cfg=cfg)
    lid, lst = ACL.resolve_access_list(state, sel)
    while True:
