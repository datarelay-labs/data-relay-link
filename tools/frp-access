def _print_cidr_normalization(raw_source: str, canonical: str) -> None:
    raw = str(raw_source or "").strip()
    canon = str(canonical or "").strip()
    if raw and canon and raw != canon:
        print("Input      : %s" % raw)
        print("Normalized : %s" % canon)


def cmd_add_source(cfg, args):
    lid, _lst, _used = confirm_shared_list_mutation(cfg, args.list, yes=bool(args.yes))
    raw_source = str(args.source or "").strip()

    def mut(state):
        return ACL.add_source_entry(
            state,
            lid,
            args.name,
            args.source,
            ttl=args.ttl,
        )

    try:
        entry = ACL.mutate_access_state(mut, cfg=cfg)
    except ACL.AccessError as exc:
        raise SystemExit("ERROR: %s" % exc)
    print("Added source %s" % (entry.get("name"),))
    _print_cidr_normalization(raw_source, entry.get("cidr") or "")
    if not (raw_source and entry.get("cidr") and raw_source != entry.get("cidr")):
        print("CIDR       : %s" % entry.get("cidr"))
    if entry.get("expires_at"):
        print("Expires at  : %s" % entry.get("expires_at"))


