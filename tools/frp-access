#!/usr/bin/env python3
"""Manage Named Access Lists, service bindings, policy tests, and access logs."""
from __future__ import annotations

import argparse
import importlib.util
import json
import os
import sys
from pathlib import Path

ROOT = os.environ.get("FRP_DEPLOY_TEST_ROOT", "")


def load_mod(name: str, rel: str):
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / "lib" / rel,
        Path("/usr/local/lib/drlink") / rel,
    ]
    if ROOT:
        candidates.insert(1, Path(ROOT) / "usr/local/lib/drlink" / rel)
    for path in candidates:
        if path.is_file():
            existing = sys.modules.get(name)
            if existing is not None:
                return existing
            spec = importlib.util.spec_from_file_location(name, str(path))
            mod = importlib.util.module_from_spec(spec)
            sys.modules[name] = mod
            spec.loader.exec_module(mod)
            return mod
    raise SystemExit("ERROR: missing %s" % rel)


ACL = load_mod("frp_access_control", "frp_access_control.py")
CREG = load_mod("frp_client_registry", "frp_client_registry.py")
LOCKS = load_mod("frp_control_locks", "frp_control_locks.py")


def control_root() -> Path:
    root = ROOT or "/"
    return Path(root)


def with_control_state_lock(fn):
    """Serialize cross-authority access mutations under control-state.lock."""
    with LOCKS.acquire_control_state_lock(control_root()):
        return fn()


def load_cfg():
    path = Path(ROOT + "/etc/drlink/config.json")
    if not path.is_file():
        raise SystemExit("ERROR: missing /etc/drlink/config.json")
    return json.loads(path.read_text(encoding="utf-8"))


def load_registry(cfg):
    path = ACL.registry_path_from_cfg(cfg)
    if not path.is_file():
        raise SystemExit(
            "ERROR: registry.json is missing (authoritative registry state required)"
        )
    state = json.loads(path.read_text(encoding="utf-8"))
    if state.get("schema_version") != 2:
        raise SystemExit("ERROR: unsupported registry schema version")
    return state


def short_client(registry, mid):
    clients = list((registry.get("clients") or {}))
    client = (registry.get("clients") or {}).get(mid) or {}
    label = CREG.sanitize_display(client.get("label") or "", 32)
    sid = CREG.unique_short_id(mid, clients)
    return label or sid


def service_display(registry, mid, sid):
    client = (registry.get("clients") or {}).get(mid) or {}
    svc = (client.get("services") or {}).get(sid) or {}
    port = svc.get("remote_port") if isinstance(svc, dict) else None
    return "%s:%s" % (short_client(registry, mid), sid), port


def print_shared_list_impact(registry, used):
    print("This Access List is used by %d services:" % len(used))
    print()
    for mid, sid in used:
        label, port = service_display(registry, mid, sid)
        print("%-18s %s" % (label, port if port is not None else "-"))
    print()
    print("This change affects all services above.")


def confirm_shared_list_mutation(cfg, list_ref, *, yes=False):
    """Show shared-list impact and require confirmation before mutation.

    Interactive menu paths pass yes=True after their own prompt to avoid
    double confirmation. Non-interactive shared mutations require --yes.

    The operator prompt happens WITHOUT control-state.lock. Callers must
    revalidate after acquiring the lock via revalidate_shared_list_mutation.
    """
    state = ACL.load_access_state(cfg=cfg)
    lid, lst = ACL.resolve_access_list(state, list_ref)
    used = ACL.list_services_using(state, lid)
    if not used:
        return lid, lst, used
    registry = load_registry(cfg)
    print_shared_list_impact(registry, used)
    print()
    if yes:
        return lid, lst, used
    if not sys.stdin.isatty():
        raise SystemExit(
            "ERROR: Access List is used by %d service(s); re-run with --yes to confirm."
            % len(used)
        )
    answer = input("Continue? [y/N]: ").strip().lower()
    if answer not in ("y", "yes"):
        raise SystemExit("Aborted.")
    return lid, lst, used


def _shared_impact_fingerprint(used):
    return tuple(sorted((str(mid), str(sid)) for mid, sid in (used or [])))


def revalidate_shared_list_mutation(cfg, list_ref, used_before):
    """Re-read after control-state.lock; refuse stale confirmation."""
    state = ACL.load_access_state(cfg=cfg)
    lid, lst = ACL.resolve_access_list(state, list_ref)
    used = ACL.list_services_using(state, lid)
    if _shared_impact_fingerprint(used) != _shared_impact_fingerprint(used_before):
        raise SystemExit(
            "ERROR: Access List impact changed while waiting for confirmation; re-run the command."
        )
    return lid, lst, used


def mutate_access_after_confirm(cfg, list_ref, used_before, mut, expected_lid=None):
    """Revalidate shared-list impact inside the production control-state write."""

    def wrapped(state):
        lid, _lst = ACL.resolve_access_list(state, list_ref)
        if expected_lid is not None and lid != expected_lid:
            raise SystemExit(
                "ERROR: Access List identity changed while waiting for confirmation; re-run the command."
            )
        used = ACL.list_services_using(state, lid)
        if _shared_impact_fingerprint(used) != _shared_impact_fingerprint(used_before):
            raise SystemExit(
                "ERROR: Access List impact changed while waiting for confirmation; re-run the command."
            )
        return mut(state)

    return ACL.mutate_access_state(wrapped, cfg=cfg)


def cmd_list(cfg, _args):
    state = ACL.load_access_state(cfg=cfg)
    registry = load_registry(cfg)
    print("Access Lists")
    print("============")
    print()
    print("%-3s %-18s %-8s %-12s %-10s" % ("#", "NAME", "ENTRIES", "ACTIVE/TEMP", "USED BY"))
    lists = sorted(
        (state.get("access_lists") or {}).items(),
        key=lambda item: str((item[1] or {}).get("name") or "").lower(),
    )
    if not lists:
        print("(none)")
        return
    for idx, (lid, lst) in enumerate(lists, 1):
        entries = lst.get("entries") or []
        active = sum(1 for e in entries if ACL.entry_is_active(e))
        temp = sum(1 for e in entries if e.get("expires_at"))
        used = len(ACL.list_services_using(state, lid))
        print(
            "%-3d %-18s %-8d %-12s %d services"
            % (
                idx,
                CREG.sanitize_display(lst.get("name") or "-", 18),
                len(entries),
                "%d/%d" % (active, temp),
                used,
            )
        )


def cmd_create(cfg, args):
    def mut(state):
        lid, record = ACL.create_access_list(state, args.name, args.description or "")
        return lid, record

    lid, record = ACL.mutate_access_state(mut, cfg=cfg)
    print("Created Access List")
    print("  ID   : %s" % lid)
    print("  Name : %s" % record["name"])


def cmd_show(cfg, args):
    state = ACL.load_access_state(cfg=cfg)
    registry = load_registry(cfg)
    lid, lst = ACL.resolve_access_list(state, args.list)
    print("Access List: %s" % lst.get("name"))
    print("=" * (14 + len(str(lst.get("name") or ""))))
    print()
    print("ID          : %s" % lid)
    print("Description :")
    print("  %s" % (lst.get("description") or "(none)"))
    print()
    print("%-3s %-18s %-20s %s" % ("#", "NAME", "CIDR", "EXPIRATION"))
    for idx, entry in enumerate(lst.get("entries") or [], 1):
        exp = ACL.parse_iso_ts(entry.get("expires_at")) if entry.get("expires_at") else None
        print(
            "%-3d %-18s %-20s %s"
            % (
                idx,
                CREG.sanitize_display(entry.get("name") or "-", 18),
                entry.get("cidr") or "-",
                ACL.format_remaining(exp),
            )
        )
    if not (lst.get("entries") or []):
        print("(no sources)")
    print()
    print("Used by")
    print("-------")
    used = ACL.list_services_using(state, lid)
    if not used:
        print("(none)")
    else:
        for mid, sid in used:
            label, port = service_display(registry, mid, sid)
            print("%-22s %s" % (label, port if port is not None else "-"))


def cmd_add_source(cfg, args):
    lid, _lst, used = confirm_shared_list_mutation(cfg, args.list, yes=bool(args.yes))

    def mut(state):
        return ACL.add_source_entry(
            state,
            lid,
            args.name,
            args.source,
            ttl=args.ttl,
        )

    try:
        entry = mutate_access_after_confirm(cfg, args.list, used, mut, expected_lid=lid)
    except ACL.AccessError as exc:
        raise SystemExit("ERROR: %s" % exc)
    print("Added source %s (%s)" % (entry.get("name"), entry.get("cidr")))
    if entry.get("expires_at"):
        print("Expires at  : %s" % entry.get("expires_at"))
    print_access_session_semantics()


