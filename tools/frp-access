                    continue
                service = pick_service(cfg, client)
                if not service:
                    continue
                lst = pick_access_list(cfg)
                if not lst:
                    continue
                cmd_assign(cfg, argparse.Namespace(client=client, service=service, list=lst))
            elif choice == "7":
                client = pick_client(cfg)
                if not client:
                    continue
                service = pick_service(cfg, client)
                if not service:
                    continue
                cmd_public(cfg, argparse.Namespace(client=client, service=service))
            elif choice == "8":
                client = pick_client(cfg)
                if not client:
                    continue
                service = pick_service(cfg, client)
                if not service:
                    continue
                cmd_show_service(cfg, argparse.Namespace(client=client, service=service))
            elif choice == "9":
                client = pick_client(cfg)
                if not client:
                    continue
                service = pick_service(cfg, client)
                if not service:
                    continue
                _print_test_context(cfg, client, service)
                source = _prompt_source_ip()
                cmd_test(cfg, argparse.Namespace(client=client, service=service, source=source))
            elif choice == "10":
                client = pick_client(cfg)
                if not client:
                    continue
                service = pick_service(cfg, client)
                if not service:
                    continue
                cmd_log(
                    cfg,
                    argparse.Namespace(client=client, service=service, limit=50, allow=False, deny=False),
                )
            else:
                print("Unknown selection")
        except (ACL.AccessError, SystemExit) as exc:
            if isinstance(exc, SystemExit):
                code = exc.code
                if code not in (0, None):
                    print(exc if isinstance(code, str) else ("ERROR" if code else ""), file=sys.stderr)
            else:
                print("ERROR: %s" % exc, file=sys.stderr)


def build_parser():
    parser = argparse.ArgumentParser(prog="frp-access", description="FRP Auto Deploy Access Control")
    sub = parser.add_subparsers(dest="cmd")

    sub.add_parser("list", help="List access lists")
    sub.add_parser("menu", help="Interactive Access Control menu")

    p = sub.add_parser("create", help="Create access list")
    p.add_argument("name")
    p.add_argument("--description", default="")

    p = sub.add_parser("show", help="Show access list")
    p.add_argument("list")

    p = sub.add_parser("delete", help="Delete access list")
    p.add_argument("list")

    p = sub.add_parser("add-source", help="Add source to access list")
    p.add_argument("list")
    p.add_argument("--name", required=True)
    p.add_argument("--source", required=True)
    p.add_argument("--ttl", default=None)
    p.add_argument("--yes", action="store_true")

    p = sub.add_parser("remove-source", help="Remove source from access list")
    p.add_argument("list")
    p.add_argument("--source", required=True)
    p.add_argument("--yes", action="store_true")

    p = sub.add_parser("replace-source", help="Replace source entry atomically")
    p.add_argument("list")
    p.add_argument("--source", required=True, help="Existing source selector")
    p.add_argument("--name", required=True)
    p.add_argument("--new-source", required=True)
    p.add_argument("--ttl", default=None)
    p.add_argument("--yes", action="store_true")

    p = sub.add_parser("edit-info", help="Edit access list name/description")
    p.add_argument("list")
    p.add_argument("--name", default=None)
    p.add_argument("--description", default=None)
    p.add_argument("--yes", action="store_true")

    p = sub.add_parser("remove-expired", help="Remove expired entries")
    p.add_argument("list")
    p.add_argument("--yes", action="store_true")

    p = sub.add_parser("assign", help="Assign access list to service")
    p.add_argument("client")
    p.add_argument("service")
    p.add_argument("list")

    p = sub.add_parser("public", help="Set service PUBLIC")
    p.add_argument("client")
    p.add_argument("service")

    p = sub.add_parser("show-service", help="Show service access")
    p.add_argument("client")
    p.add_argument("service")

    p = sub.add_parser("test", help="Policy preview for a source IP")
    p.add_argument("client")
    p.add_argument("service")
    p.add_argument("source")

    p = sub.add_parser("log", help="Show recent access log")
    p.add_argument("client")
    p.add_argument("service")
    p.add_argument("--limit", type=int, default=50)
    p.add_argument("--allow", action="store_true")
    p.add_argument("--deny", action="store_true")

    return parser


def main(argv=None):
    argv = list(argv if argv is not None else sys.argv[1:])
    parser = build_parser()
    if not argv:
        cfg = load_cfg()
        interactive_menu(cfg)
        return
    args = parser.parse_args(argv)
    cfg = load_cfg()
    try:
        if args.cmd == "list":
            cmd_list(cfg, args)
        elif args.cmd == "menu":
            interactive_menu(cfg)
        elif args.cmd == "create":
            cmd_create(cfg, args)
        elif args.cmd == "show":
            cmd_show(cfg, args)
        elif args.cmd == "delete":
            cmd_delete(cfg, args)
        elif args.cmd == "add-source":
            cmd_add_source(cfg, args)
        elif args.cmd == "remove-source":
            cmd_remove_source(cfg, args)
        elif args.cmd == "replace-source":
            cmd_replace_source(cfg, args)
        elif args.cmd == "edit-info":
            cmd_edit_info(cfg, args)
        elif args.cmd == "remove-expired":
            cmd_remove_expired(cfg, args)
        elif args.cmd == "assign":
            cmd_assign(cfg, args)
        elif args.cmd == "public":
            cmd_public(cfg, args)
        elif args.cmd == "show-service":
            cmd_show_service(cfg, args)
        elif args.cmd == "test":
            cmd_test(cfg, args)
        elif args.cmd == "log":
            cmd_log(cfg, args)
        else:
            parser.print_help()
            raise SystemExit(2)
    except ACL.AccessError as exc:
        raise SystemExit("ERROR: %s" % exc)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
