#!/usr/bin/env python3
import argparse
import importlib.util
import json
import os
import sys
from pathlib import Path

ROOT = os.environ.get('FRP_DEPLOY_TEST_ROOT', '')
CFG = Path(ROOT + '/etc/drlink/config.json')


def load_creg():
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / 'lib' / 'frp_client_registry.py',
        Path('/usr/local/lib/drlink/frp_client_registry.py'),
    ]
    if ROOT:
        candidates.insert(1, Path(ROOT) / 'usr/local/lib/drlink/frp_client_registry.py')
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location('frp_client_registry', str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    raise SystemExit('ERROR: missing frp_client_registry.py')


def load_acl():
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / 'lib' / 'frp_access_control.py',
        Path('/usr/local/lib/drlink/frp_access_control.py'),
    ]
    if ROOT:
        candidates.insert(1, Path(ROOT) / 'usr/local/lib/drlink/frp_access_control.py')
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location('frp_access_control', str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    return None


CREG = load_creg()
ACL = load_acl()


parser = argparse.ArgumentParser(description='List registered clients')
parser.add_argument(
    '--tag',
    action='append',
    default=[],
    metavar='KEY=VALUE',
    help='show clients with this tag; multiple --tag filters use AND semantics',
)
parser.add_argument(
    '--group',
    default=None,
    metavar='GROUP',
    help='show clients in this group (ID, unique prefix, or exact name)',
)
args = parser.parse_args()
tag_filters = []
try:
    tag_filters = [CREG.parse_tag_assignment(value) for value in args.tag]
except ValueError as exc:
    parser.error(str(exc))


def require_v2(state):
    if not isinstance(state, dict) or state.get('schema_version') != 2:
        version = 1
        if isinstance(state, dict) and 'schema_version' in state:
            version = state.get('schema_version')
        raise SystemExit(
            f'ERROR: unsupported registry schema version {version}.\n\n'
            'This release requires registry schema version 2.\n\n'
            'Back up the existing registry and redeploy/reset it explicitly before continuing.'
        )
    for client in (state.get('clients') or {}).values():
        if not isinstance(client, dict):
            raise SystemExit(
                'ERROR: unsupported registry schema version 2.\n\n'
                'This release requires registry schema version 2.\n\n'
                'Back up the existing registry and redeploy/reset it explicitly before continuing.'
            )
        if 'ssh_port' in client or 'https_port' in client:
            raise SystemExit(
                'ERROR: unsupported registry schema version 2.\n\n'
                'Legacy SSH/HTTPS fields are present. This release requires the generic multi-service registry.\n\n'
                'Back up the existing registry and redeploy/reset it explicitly before continuing.'
            )


def access_summary(access_state, mid, client):
    if ACL is None:
        return '-'
    public = 0
    restricted = 0
    for sid, _svc in CREG.enabled_services(client):
        binding = ACL.get_service_binding(access_state, mid, sid)
        if binding.get('access_mode') == ACL.MODE_ALLOWLIST:
            restricted += 1
        else:
            public += 1
    if public == 0 and restricted == 0:
        return '0 PUBLIC / 0 RESTRICTED'
    return '%d PUBLIC / %d RESTRICTED' % (public, restricted)


cfg = json.loads(CFG.read_text())
reg = Path(cfg['registry_file'])
if ROOT and not str(reg).startswith(ROOT):
    reg = Path(ROOT + str(reg))
if not reg.exists():
    print('ERROR: registry.json is missing (authoritative registry state required)', file=sys.stderr)
    raise SystemExit(1)
try:
    state = json.loads(reg.read_text())
except (OSError, json.JSONDecodeError) as exc:
    print('ERROR: unable to read registry.json: %s' % exc, file=sys.stderr)
    raise SystemExit(1)
require_v2(state)

access_state = {}
if ACL is not None:
    try:
        access_path = ACL.access_control_path(cfg)
        if access_path.exists():
            access_state = ACL.load_access_state(cfg=cfg)
    except Exception:
        access_state = {}

public_ip = CREG.sanitize_display(cfg.get('public_ip') or cfg.get('public_host') or '', 253)
public_hostname = CREG.sanitize_display(cfg.get('public_hostname') or '', 253)
access_host = public_hostname or public_ip
clients = CREG.sorted_clients(state)
if args.group:
    try:
        gid, _group = CREG.resolve_group(state, args.group)
    except CREG.GroupLookupError as exc:
        if exc.matches:
            print('ERROR: multiple groups matched.', file=sys.stderr)
            print(CREG.format_group_candidate_table(exc.matches), file=sys.stderr, end='')
        else:
            print('ERROR: group not found: %s' % CREG.sanitize_display(args.group), file=sys.stderr)
        raise SystemExit(1)
    clients = [
        (mid, client)
        for mid, client in clients
        if CREG.client_matches_group(state, client, gid)
    ]
if tag_filters:
    clients = [
        (mid, client)
        for mid, client in clients
        if CREG.client_matches_tags(client, tag_filters)
    ]
listener_snapshot = CREG.passive_listening_ports()

print('Registered clients')
print('==================')
print()
print(
    f'{"#":<3} {"CLIENT ID":<10} {"LABEL":<12} {"HOSTNAME":<14} '
    f'{"SERVICES":<8} {"ACCESS":<22} {"STATE":<10} {"MGMT":<10} SSH'
)
print('-' * 128)

if not clients:
    print('(none)')

all_mids = [mid for mid, _client in clients]
for idx, (mid, client) in enumerate(clients, start=1):
    services = CREG.enabled_services(client)
    label = CREG.sanitize_display(client.get('label') or '-', 12)
    hostname = CREG.sanitize_display(client.get('hostname') or '-', 14)
    short_id = CREG.sanitize_display(CREG.unique_short_id(mid, all_mids), 10)
    state_txt = CREG.inventory_online_status(client, listener_snapshot)
    access_txt = CREG.sanitize_display(access_summary(access_state, mid, client), 22)
    mgmt = CREG.mgmt_status(client)
    ssh_txt = '-'
    _sid, ssh = CREG.first_ssh_service(client)
    if ssh:
        user = CREG.ssh_user_display(ssh)
        port = ssh.get('remote_port') or '-'
        if ssh.get('ssh_user'):
            ssh_txt = '%s@%s:%s' % (user, access_host or 'host', port)
        else:
            ssh_txt = 'legacy / unspecified'
        ssh_txt = CREG.sanitize_display(ssh_txt, 48)
    print(
        f'{idx:<3} {short_id:<10} {label:<12} {hostname:<14} '
        f'{str(len(services)):<8} {access_txt:<22} {state_txt:<10} {mgmt:<10} {ssh_txt}'
    )

print()
print('Use CLIENT ID in client commands.')
print('A unique label or hostname is also accepted as a shortcut.')
if clients:
    example = CREG.sanitize_display(CREG.unique_short_id(clients[0][0], all_mids), 16)
    if example:
        print()
        print('Example:')
        print('  show client %s' % example)

if clients:
    print()
    for mid, client in clients:
        name = CREG.sanitize_display(CREG.display_name(client, mid), 64)
        print(name)
        services = client.get('services') or {}
        if not isinstance(services, dict) or not services:
            print('  (no services)')
            continue
        for sid, svc in sorted(
            services.items(),
            key=lambda kv: (kv[1].get('remote_port') or 0, kv[0]) if isinstance(kv[1], dict) else (0, kv[0]),
        ):
            if not isinstance(svc, dict):
                continue
            port = svc.get('remote_port') or '-'
            suffix = '' if svc.get('enabled', True) else ' (reserved)'
            print(f'  {CREG.sanitize_display(sid, 32)}:{port}{suffix}')
        print()
