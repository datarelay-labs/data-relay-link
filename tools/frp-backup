#!/usr/bin/env python3
"""Create a root-only disaster-recovery archive of server control state."""
from __future__ import annotations

import datetime as dt
import hashlib
import importlib.util
import json
import os
import shutil
import stat
import sys
import tarfile
import tempfile
import time
from pathlib import Path

FORMAT = "data-relay-link-server-backup"
SCHEMA_VERSION = 1
# Trust/config identity that is always required for a supported Server DR archive.
# Canonical DB + config.json come from frp_state_paths SSOT (backup_policy=required).
TRUST_REQUIRED = (
    "etc/drlink/version",
    "etc/drlink/pki/ca.key",
    "etc/drlink/pki/ca.crt",
    "etc/drlink/pki/server.key",
    "etc/drlink/pki/server.crt",
    "etc/frp/frps.toml",
    "etc/frp/server_token",
)
def _load_state_paths():
    candidates = []
    try:
        here = Path(__file__).resolve()
        candidates.append(here.parent.parent / "lib" / "frp_state_paths.py")
    except NameError:
        # compile()/exec() harnesses may omit __file__.
        pass
    env_root = os.environ.get("ROOT") or os.environ.get("FRP_SOURCE_ROOT") or ""
    if env_root:
        candidates.append(Path(env_root) / "lib" / "frp_state_paths.py")
    candidates.append(Path("/usr/local/lib/drlink/frp_state_paths.py"))
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location("frp_state_paths", str(path))
            module = importlib.util.module_from_spec(spec)
            sys.modules[spec.name] = module
            assert spec.loader is not None
            spec.loader.exec_module(module)
            return module
    raise RuntimeError("frp_state_paths.py is unavailable")


_STATE_PATHS = _load_state_paths()
REQUIRED = tuple(
    dict.fromkeys((*_STATE_PATHS.backup_required_files(), *TRUST_REQUIRED))
)
OPTIONAL_FILES = (
    "etc/drlink/frontend.conf",
    "var/lib/drlink/mgmt-nonces.json",
    "var/lib/drlink/nginx-ownership",
    *_STATE_PATHS.backup_optional_files(),
    *_STATE_PATHS.backup_forensic_optional_files(),
)
OPTIONAL_TREES = (
    "etc/drlink/pki",
    *_STATE_PATHS.backup_tree_roots(),
)
CONTROL_DB_REL = "var/lib/drlink/drlink.db"


def fail(message: str) -> "NoReturn":
    print(f"ERROR: {message}", file=sys.stderr)
    raise SystemExit(1)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def snapshot_sqlite(source: Path, target: Path) -> None:
    """Capture a consistent SQLite snapshot (includes WAL state via backup API)."""
    import sqlite3

    target.parent.mkdir(parents=True, exist_ok=True)
    src = sqlite3.connect(f"file:{source}?mode=ro", uri=True)
    try:
        dest = sqlite3.connect(str(target))
        try:
            src.backup(dest)
            # Flatten to a single-file DB so -wal/-shm are not archived.
            dest.execute("PRAGMA journal_mode=DELETE")
            dest.commit()
        finally:
            dest.close()
    finally:
        src.close()
    for suffix in ("-wal", "-shm"):
        companion = Path(str(target) + suffix)
        try:
            companion.unlink()
        except FileNotFoundError:
            pass


def control_db_manifest_fields(db_path: Path) -> dict:
    """Bind canonical DB schema/revision into the DR manifest when readable."""
    import sqlite3

    info: dict = {"path": CONTROL_DB_REL}
    try:
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    except sqlite3.Error:
        return info
    try:
        try:
            schema = int(
                conn.execute(
                    "SELECT COALESCE(MAX(version), 0) FROM schema_migrations"
                ).fetchone()[0]
                or 0
            )
        except sqlite3.Error:
            schema = 0
        try:
            revision = int(
                conn.execute(
                    "SELECT COALESCE(MAX(revision), 0) FROM config_revisions"
                ).fetchone()[0]
                or 0
            )
        except sqlite3.Error:
            revision = 0
        if schema > 0:
            info["schema_version"] = schema
        info["revision"] = revision
    finally:
        conn.close()
    return info


def read_identity(path: Path) -> dict[str, str]:
    result: dict[str, str] = {}
    if path.is_file():
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            key, sep, value = line.partition("=")
            if sep and key in {
                "PROJECT_VERSION",
                "FRP_VERSION",
                "RELEASE_CHANNEL",
                "SOURCE_REF",
                "BUNDLE_SHA256",
            }:
                result[key.lower()] = value
    return result


def safe_source(root: Path, rel: str, required: bool = False) -> Path | None:
    path = root / rel
    if path.is_symlink():
        fail(f"refusing symlink in control state: /{rel}")
    if path.is_file():
        return path
    if required:
        fail(f"required server state is missing: /{rel}")
    return None


def _load_locks():
    here = Path(__file__).resolve()
    candidates = (
        here.parent.parent / "lib" / "frp_control_locks.py",
        Path("/usr/local/lib/drlink/frp_control_locks.py"),
    )
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location("frp_control_locks", str(path))
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            return module
    raise RuntimeError("frp_control_locks.py is unavailable")


def _audit_emit(event, **kwargs):
    try:
        here = Path(__file__).resolve()
        candidates = (
            here.parent.parent / "lib" / "frp_audit.py",
            Path("/usr/local/lib/drlink/frp_audit.py"),
        )
        for path in candidates:
            if path.is_file():
                spec = importlib.util.spec_from_file_location("frp_audit", str(path))
                module = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(module)
                module.try_emit(event, **kwargs)
                return
    except Exception:
        return


def collect_files(root: Path) -> list[tuple[str, Path]]:
    # Pre-restore raw snapshots must capture whatever is present even when
    # required control-state files are missing or damaged.
    raw_snapshot = os.environ.get("FRP_BACKUP_RAW_SNAPSHOT") == "1"
    found: dict[str, Path] = {}
    for rel in REQUIRED:
        source = safe_source(root, rel, required=not raw_snapshot)
        if source is not None:
            found[rel] = source
    for rel in OPTIONAL_FILES:
        source = safe_source(root, rel)
        if source is not None:
            found[rel] = source
    for rel in OPTIONAL_TREES:
        tree = root / rel
        if tree.is_symlink():
            fail(f"refusing symlink in control state: /{rel}")
        if not tree.exists():
            continue
        if not tree.is_dir():
            fail(f"expected control-state directory: /{rel}")
        for source in sorted(tree.rglob("*")):
            child_rel = source.relative_to(root).as_posix()
            if source.is_symlink():
                fail(f"refusing symlink in control state: /{child_rel}")
            if source.is_file():
                found[child_rel] = source
            elif not source.is_dir():
                fail(f"unsupported control-state entry: /{child_rel}")
    for child_rel, source in _STATE_PATHS.collect_present_rotated_files(root):
        found[child_rel] = source
    return sorted(found.items())


def _hold_lock_hook() -> None:
    ready = os.environ.get("FRP_BACKUP_HOOK_READY", "")
    go = os.environ.get("FRP_BACKUP_HOOK_GO", "")
    if not ready or not go:
        return
    Path(ready).write_text("ready\n", encoding="utf-8")
    deadline = time.time() + float(os.environ.get("FRP_BACKUP_HOOK_WAIT", "10"))
    while time.time() < deadline:
        if Path(go).is_file():
            return
        time.sleep(0.05)


def _lexists(path: Path) -> bool:
    try:
        os.lstat(path)
        return True
    except FileNotFoundError:
        return False
    except OSError:
        return False


def _is_symlink(path: Path) -> bool:
    try:
        return stat.S_ISLNK(os.lstat(path).st_mode)
    except FileNotFoundError:
        return False


def _reject_symlink_components(path: Path, what: str) -> None:
    parts = path.parts
    if not parts:
        fail(f"refusing empty {what}")
    acc = Path(parts[0])
    prefixes = [acc]
    for part in parts[1:]:
        acc = acc / part
        prefixes.append(acc)
    for prefix in prefixes:
        if _is_symlink(prefix):
            fail(f"refusing {what} that traverses a symlink")


def _validate_user_path(raw: str, *, what: str) -> Path:
    if not raw or raw in {".", "..", "/", "//", "-"}:
        fail(f"refusing unsafe {what}")
    path = Path(raw)
    if not path.is_absolute():
        path = Path.cwd() / path
    if ".." in path.parts or "\\" in raw:
        fail(f"refusing unsafe {what}")
    _reject_symlink_components(path, what)
    return path


def create_backup(root: Path, output: Path, *, secure_parent: bool) -> None:
    if os.environ.get("FRP_BACKUP_ALREADY_LOCKED") == "1":
        _hold_lock_hook()
        files = collect_files(root)
        _stage_backup(root, output, files, secure_parent=secure_parent)
        return
    locks = _load_locks()
    timeout = float(os.environ.get("FRP_BACKUP_LOCK_TIMEOUT", "30"))
    with locks.acquire_control_locks(root, timeout=timeout):
        _hold_lock_hook()
        files = collect_files(root)
        _stage_backup(root, output, files, secure_parent=secure_parent)


def _stage_backup(root: Path, output: Path, files: list[tuple[str, Path]], *, secure_parent: bool) -> None:
    parent = output.parent
    if secure_parent:
        parent.mkdir(parents=True, exist_ok=True)
        if _is_symlink(parent):
            fail("refusing to write through a symlink parent directory")
        os.chmod(parent, 0o700)
        if os.geteuid() == 0:
            os.chown(parent, 0, 0)
    else:
        if not parent.is_dir() or _is_symlink(parent):
            fail("backup parent directory does not exist")
        if _is_symlink(parent):
            fail("refusing backup parent directory that is a symlink")
    if _lexists(output) and _is_symlink(output):
        fail("refusing to overwrite a symlink")
    if _lexists(output) and not output.is_file():
        fail("backup output must be a regular file")

    with tempfile.TemporaryDirectory(prefix=".frp-backup-", dir=str(output.parent)) as tmp_name:
        stage = Path(tmp_name)
        payload = stage / "payload"
        entries = []
        for rel, source in files:
            target = payload / rel
            target.parent.mkdir(parents=True, exist_ok=True)
            if rel == CONTROL_DB_REL:
                try:
                    snapshot_sqlite(source, target)
                except Exception:
                    if os.environ.get("FRP_BACKUP_RAW_SNAPSHOT") == "1":
                        # Pre-restore evidence may include a damaged DB file.
                        shutil.copyfile(source, target)
                    else:
                        raise
                mode = 0o600
            else:
                shutil.copyfile(source, target)
                mode = stat.S_IMODE(source.stat().st_mode)
            os.chmod(target, mode)
            entries.append({"path": rel, "sha256": sha256(target), "mode": mode})

        identity = read_identity(root / "etc/drlink/version")
        control_db = None
        db_staged = payload / CONTROL_DB_REL
        if db_staged.is_file():
            control_db = control_db_manifest_fields(db_staged)
        manifest = {
            "format": FORMAT,
            "schema_version": SCHEMA_VERSION,
            "created_at": dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat(),
            "project_version": identity.get("project_version", "unknown"),
            "frp_version": identity.get("frp_version", "unknown"),
            "release_channel": identity.get("release_channel", "unknown"),
            "build_identity": {
                key: value
                for key, value in identity.items()
                if key in {"source_ref", "bundle_sha256"}
            },
            "control_db": control_db,
            "files": entries,
        }
        manifest_path = stage / "manifest.json"
        manifest_path.write_text(
            json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8"
        )
        checksums = stage / "checksums.sha256"
        checksums.write_text(
            "".join(f"{entry['sha256']}  payload/{entry['path']}\n" for entry in entries),
            encoding="utf-8",
        )
        os.chmod(manifest_path, 0o600)
        os.chmod(checksums, 0o600)

        fd, temp_name = tempfile.mkstemp(prefix=".frp-backup-", suffix=".tar.gz", dir=output.parent)
        os.close(fd)
        temp_archive = Path(temp_name)
        try:
            os.chmod(temp_archive, 0o600)
            with tarfile.open(temp_archive, "w:gz", format=tarfile.PAX_FORMAT) as archive:
                archive.add(manifest_path, arcname="manifest.json", recursive=False)
                archive.add(checksums, arcname="checksums.sha256", recursive=False)
                archive.add(payload, arcname="payload", recursive=True)
            os.chmod(temp_archive, 0o600)
            os.replace(temp_archive, output)
            os.chmod(output, 0o600)
        finally:
            if temp_archive.exists():
                temp_archive.unlink()


def main() -> int:
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and sys.argv[1] in {"-h", "--help"}):
        print("Usage: frp-backup [OUTPUT.tar.gz]")
        return 0 if len(sys.argv) == 2 else 2
    test_root = os.environ.get("FRP_DEPLOY_TEST_ROOT", "")
    if os.geteuid() != 0 and not test_root:
        fail("run with sudo")
    root = Path(test_root or "/")
    now = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    default = root / f"var/lib/drlink/backups/server-backup-{now}.tar.gz"
    if len(sys.argv) == 2:
        output = _validate_user_path(sys.argv[1], what="backup output path")
        parent = output.parent
        if not parent.is_dir() or _is_symlink(parent):
            fail("backup parent directory does not exist")
        create_backup(root, output, secure_parent=False)
    else:
        output = default
        create_backup(root, output, secure_parent=True)
    print("WARNING: this backup contains private keys, authentication tokens, and enrollment secrets.")
    print(f"Backup created: {output}")
    _audit_emit("backup.created", details={"path": str(output.name)})
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
