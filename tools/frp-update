#!/usr/bin/env bash
set -euo pipefail

_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${_SCRIPT_DIR}/../lib/frp-common.sh" ]]; then
  # shellcheck source=../lib/frp-common.sh
  . "${_SCRIPT_DIR}/../lib/frp-common.sh"
elif [[ -f /usr/local/lib/drlink/frp-common.sh ]]; then
  # shellcheck disable=SC1091
  . /usr/local/lib/drlink/frp-common.sh
elif [[ -f '/Library/Application Support/drlink/lib/frp-common.sh' ]]; then
  # shellcheck disable=SC1091
  . '/Library/Application Support/drlink/lib/frp-common.sh'
else
  echo "ERROR: missing lib/frp-common.sh" >&2
  exit 1
fi

usage() {
  cat <<'EOF'
Usage: frp-update [--check] [--role server|client|both]

Upgrade the local FRP binary (frps on server, frpc on client) to the version
tested by Data Relay Link. Dual-role hosts update both binaries by default.
If the new binary fails health checks, the previous binary is restored
automatically.

  --check, --dry-run   report current/target versions without changing anything
  --role ROLE          override detected role (server, client, or both)
  -h, --help           show this help

Upstream latest FRP releases are not installed. This command only installs the
tested/pinned FRP version from this Data Relay Link release.
EOF
}

CHECK_ONLY=0
ROLE_OVERRIDE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --check|--dry-run) CHECK_ONLY=1; shift ;;
    --role)
      ROLE_OVERRIDE="${2:-}"
      [[ -n "$ROLE_OVERRIDE" ]] || { echo "ERROR: --role requires an argument" >&2; exit 2; }
      shift 2
      ;;
    -h|--help) usage; exit 0 ;;
    *)
      echo "ERROR: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done
case "$ROLE_OVERRIDE" in
  ""|server|client|both) ;;
  *)
    echo "ERROR: invalid --role value: ${ROLE_OVERRIDE} (use server, client, or both)" >&2
    exit 2
    ;;
esac

if ! frp_test_harness_enabled; then
  if [[ ${EUID} -ne 0 ]]; then
    echo "ERROR: run with sudo" >&2
    exit 1
  fi
fi

FRPS_BIN="$(frp_path /usr/local/bin/frps)"
FRPC_BIN="$(frp_path /usr/local/bin/frpc)"
FRPS_CONFIG="$(frp_path /etc/frp/frps.toml)"
FRPC_CONFIG="$(frp_path /etc/frp/frpc.toml)"
CLIENT_STATE="$(frp_path /etc/frp/client-state.json)"
TOKEN_FILE="$(frp_path /etc/frp/server_token)"
REGISTRY_FILE="$(frp_path /var/lib/drlink/registry.json)"
BACKUP_ROOT="$(frp_path /var/lib/drlink/backups)"
VERSION_FILE="$(frp_path /etc/drlink/version)"
SKIP_SYSTEMD=0
if frp_test_harness_enabled && [[ "${FRP_UPDATE_HOOK_SKIP_SYSTEMD:-}" == "1" ]]; then
  SKIP_SYSTEMD=1
fi

TARGET_VERSION="${FRP_VERSION}"
PREVIOUS_VERSION="unknown"
TOKEN_BEFORE=""
REGISTRY_BEFORE=""
BACKUP_DIR=""
INSTALLED_NEW=0
TMPDIR=""
EXTRACTED_FRPC=""
HAS_SERVER=0
HAS_CLIENT=0
PREVIOUS_FRPC_VERSION="unknown"

cleanup() {
  if [[ -n "$TMPDIR" && -d "$TMPDIR" ]]; then
    rm -rf "$TMPDIR"
  fi
}
trap cleanup EXIT

require_cmd() {
  local cmd
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || {
      echo "ERROR: required command not found: ${cmd}" >&2
      return 1
    }
  done
}

snapshot_preservation() {
  TOKEN_BEFORE="$(frp_file_sha256 "$TOKEN_FILE")"
  REGISTRY_BEFORE="$(frp_registry_identity "$REGISTRY_FILE")"
}

report_preservation() {
  local token_after registry_after
  token_after="$(frp_file_sha256 "$TOKEN_FILE")"
  registry_after="$(frp_registry_identity "$REGISTRY_FILE")"
  if [[ -n "$TOKEN_BEFORE" && "$token_after" == "$TOKEN_BEFORE" ]]; then
    echo "TOKEN_PRESERVED=PASS"
  else
    echo "TOKEN_PRESERVED=FAIL"
  fi
  if [[ "$registry_after" == "$REGISTRY_BEFORE" ]]; then
    echo "REGISTRY_PRESERVED=PASS"
  else
    echo "REGISTRY_PRESERVED=FAIL"
  fi
}

restart_frps() {
  if [[ "$SKIP_SYSTEMD" == "1" ]]; then
    mkdir -p "$(dirname "$(frp_path /var/lib/drlink/update-actions.log)")"
    echo "restart drlink-server" >>"$(frp_path /var/lib/drlink/update-actions.log)"
    if frp_test_harness_enabled && [[ "${FRP_UPDATE_HOOK_RESTART_FAIL:-}" == "1" ]]; then
      echo "ERROR: simulated restart failure" >&2
      return 1
    fi
    if frp_test_harness_enabled && [[ "${FRP_UPDATE_HOOK_ROLLBACK_RESTART_FAIL:-}" == "1" && "${FRP_UPDATE_IN_ROLLBACK:-}" == "1" ]]; then
      echo "ERROR: simulated rollback restart failure" >&2
      return 1
    fi
    return 0
  fi
  systemctl restart drlink-server
}

health_check_server() {
  local ver port
  ver="$(frp_parse_binary_version "$FRPS_BIN")"
  if frp_test_harness_enabled && [[ -n "${FRP_UPDATE_HOOK_HEALTH_FAIL_VERSION:-}" && "$ver" == "${FRP_UPDATE_HOOK_HEALTH_FAIL_VERSION}" ]]; then
    echo "ERROR: health check failed for FRP ${ver}" >&2
    return 1
  fi
  if [[ "$SKIP_SYSTEMD" == "1" ]]; then
    if frp_test_harness_enabled && [[ "${FRP_UPDATE_HOOK_LISTEN:-}" == "fail" ]]; then
      echo "ERROR: control port is not listening" >&2
      return 1
    fi
    return 0
  fi
  systemctl is-active --quiet drlink-server || {
    echo "ERROR: frps is not active" >&2
    return 1
  }
  sleep 1
  systemctl is-active --quiet drlink-server || {
    echo "ERROR: frps did not stay active" >&2
    return 1
  }
  port="$(frp_bind_port "$FRPS_CONFIG")"
  if [[ -n "$port" ]]; then
    if ! frp_port_listening "$port"; then
      echo "ERROR: FRP control port ${port} is not listening" >&2
      return 1
    fi
  fi
  return 0
}

health_check_client() {
  local ver
  ver="$(frp_parse_binary_version "$FRPC_BIN")"
  if frp_test_harness_enabled && [[ -n "${FRP_UPDATE_HOOK_HEALTH_FAIL_VERSION:-}" && "$ver" == "${FRP_UPDATE_HOOK_HEALTH_FAIL_VERSION}" ]]; then
    echo "ERROR: health check failed for FRP ${ver}" >&2
    return 1
  fi
  if [[ "$SKIP_SYSTEMD" == "1" ]]; then
    return 0
  fi
  if frp_is_darwin; then
    if declare -F frp_macos_launchd_running >/dev/null 2>&1 && frp_macos_launchd_running; then
      return 0
    fi
    echo "ERROR: frpc is not active" >&2
    return 1
  fi
  systemctl is-active --quiet drlink-client || {
    echo "ERROR: frpc is not active" >&2
    return 1
  }
  return 0
}

health_check() {
  case "${UPDATE_ROLE:-server}" in
    client) health_check_client ;;
    both)
      health_check_server || return 1
      health_check_client
      ;;
    *) health_check_server ;;
  esac
}

create_backup() {
  local ts bin name cfg
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  BACKUP_DIR="${BACKUP_ROOT}/${ts}-${PREVIOUS_VERSION}"
  mkdir -p "$BACKUP_DIR"
  chmod 700 "$BACKUP_ROOT" 2>/dev/null || true
  chmod 700 "$BACKUP_DIR"
  case "${UPDATE_ROLE:-server}" in
    client)
      bin="$FRPC_BIN"; name=frpc; cfg="$FRPC_CONFIG"
      cp "$bin" "${BACKUP_DIR}/${name}"
      chmod 0755 "${BACKUP_DIR}/${name}"
      if [[ -f "$cfg" ]]; then
        cp "$cfg" "${BACKUP_DIR}/$(basename "$cfg")"
        chmod 600 "${BACKUP_DIR}/$(basename "$cfg")"
      fi
      ;;
    both)
      cp "$FRPS_BIN" "${BACKUP_DIR}/frps"
      cp "$FRPC_BIN" "${BACKUP_DIR}/frpc"
      chmod 0755 "${BACKUP_DIR}/frps" "${BACKUP_DIR}/frpc"
      if [[ -f "$FRPS_CONFIG" ]]; then
        cp "$FRPS_CONFIG" "${BACKUP_DIR}/$(basename "$FRPS_CONFIG")"
        chmod 600 "${BACKUP_DIR}/$(basename "$FRPS_CONFIG")"
      fi
      if [[ -f "$FRPC_CONFIG" ]]; then
        cp "$FRPC_CONFIG" "${BACKUP_DIR}/$(basename "$FRPC_CONFIG")"
        chmod 600 "${BACKUP_DIR}/$(basename "$FRPC_CONFIG")"
      fi
      ;;
    *)
      bin="$FRPS_BIN"; name=frps; cfg="$FRPS_CONFIG"
      cp "$bin" "${BACKUP_DIR}/${name}"
      chmod 0755 "${BACKUP_DIR}/${name}"
      if [[ -f "$cfg" ]]; then
        cp "$cfg" "${BACKUP_DIR}/$(basename "$cfg")"
        chmod 600 "${BACKUP_DIR}/$(basename "$cfg")"
      fi
      ;;
  esac
  cat >"${BACKUP_DIR}/metadata" <<EOF
PREVIOUS_FRP_VERSION=${PREVIOUS_VERSION}
PREVIOUS_FRPC_VERSION=${PREVIOUS_FRPC_VERSION}
TARGET_FRP_VERSION=${TARGET_VERSION}
BACKUP_UTC=${ts}
ROLE=${UPDATE_ROLE:-server}
EOF
  chmod 644 "${BACKUP_DIR}/metadata"
  frp_prune_backup_dirs "$BACKUP_ROOT" "$FRP_BACKUP_KEEP"
}

do_rollback() {
  local name dest
  FRP_UPDATE_IN_ROLLBACK=1
  echo "Rolling back to FRP ${PREVIOUS_VERSION} ..."
  case "${UPDATE_ROLE:-server}" in
    client)
      name=frpc
      dest="$FRPC_BIN"
      if [[ -z "$BACKUP_DIR" || ! -x "${BACKUP_DIR}/${name}" ]]; then
        echo "ERROR: rollback backup is missing" >&2
        return 1
      fi
      frp_atomic_install "${BACKUP_DIR}/${name}" "$dest" 0755 || {
        echo "ERROR: rollback restore failed" >&2
        return 1
      }
      ;;
    both)
      if [[ -z "$BACKUP_DIR" || ! -x "${BACKUP_DIR}/frps" || ! -x "${BACKUP_DIR}/frpc" ]]; then
        echo "ERROR: rollback backup is missing" >&2
        return 1
      fi
      frp_atomic_install "${BACKUP_DIR}/frps" "$FRPS_BIN" 0755 || {
        echo "ERROR: rollback restore failed for frps" >&2
        return 1
      }
      frp_atomic_install "${BACKUP_DIR}/frpc" "$FRPC_BIN" 0755 || {
        echo "ERROR: rollback restore failed for frpc" >&2
        return 1
      }
      ;;
    *)
      name=frps
      dest="$FRPS_BIN"
      if [[ -z "$BACKUP_DIR" || ! -x "${BACKUP_DIR}/${name}" ]]; then
        echo "ERROR: rollback backup is missing" >&2
        return 1
      fi
      frp_atomic_install "${BACKUP_DIR}/${name}" "$dest" 0755 || {
        echo "ERROR: rollback restore failed" >&2
        return 1
      }
      ;;
  esac
  if ! restart_frp_unit; then
    echo "ERROR: rollback restart failed" >&2
    return 1
  fi
  if ! health_check; then
    echo "ERROR: rollback health check failed" >&2
    return 1
  fi
  return 0
}

fail_update() {
  local class="${1:-STAGING_FAILED}"
  local txn_role="${FRP_TXN_ROLE:-server}"
  echo >&2
  echo "FRP update failed." >&2
  frp_emit_failure_class "$class"
  if [[ "$INSTALLED_NEW" == "1" ]]; then
    if do_rollback; then
      echo
      echo "Rollback completed successfully."
      echo
      echo "Restored FRP : ${PREVIOUS_VERSION}"
      echo "Target FRP   : ${TARGET_VERSION}"
      echo
      echo "The previous FRP version is running."
      report_preservation
      frp_txn_clear "$txn_role"
      exit 1
    fi
    echo "CRITICAL: FRP update failed and automatic rollback did not recover runtime." >&2
    frp_emit_failure_class UPDATE_ROLLBACK_FAILED
    echo "RECOVERY_REQUIRED" >&2
    echo "FAILURE_CLASS=UPDATE_ROLLBACK_FAILED" >&2
    report_preservation
    exit 2
  fi
  frp_txn_clear "$txn_role"
  exit 1
}

precheck() {
  require_cmd python3 tar curl mkdir mv cp chmod mktemp date || return 1
  frp_detect_arch || return 1
  frp_valid_version "$TARGET_VERSION" || {
    echo "ERROR: invalid target FRP version: ${TARGET_VERSION}" >&2
    return 1
  }
  HAS_SERVER=0
  HAS_CLIENT=0
  [[ -x "$FRPS_BIN" && -f "$FRPS_CONFIG" ]] && HAS_SERVER=1
  [[ -x "$FRPC_BIN" && -f "$CLIENT_STATE" ]] && HAS_CLIENT=1
  if [[ -n "$ROLE_OVERRIDE" ]]; then
    UPDATE_ROLE="$ROLE_OVERRIDE"
  elif [[ "$HAS_SERVER" == "1" && "$HAS_CLIENT" == "1" ]]; then
    UPDATE_ROLE=both
  elif [[ "$HAS_CLIENT" == "1" ]]; then
    UPDATE_ROLE=client
  elif [[ "$HAS_SERVER" == "1" ]]; then
    UPDATE_ROLE=server
  else
    echo "ERROR: no installed FRP server or client was detected" >&2
    frp_emit_failure_class INSTALL_PRECHECK_FAILED
    return 1
  fi
  case "$UPDATE_ROLE" in
    server)
      [[ "$HAS_SERVER" == "1" ]] || {
        echo "ERROR: --role server requested but frps is not installed" >&2
        return 1
      }
      ;;
    client)
      [[ "$HAS_CLIENT" == "1" ]] || {
        echo "ERROR: --role client requested but frpc is not installed" >&2
        return 1
      }
      [[ -f "$FRPC_CONFIG" ]] || {
        echo "ERROR: missing FRP client config: ${FRPC_CONFIG}" >&2
        frp_emit_failure_class INSTALL_PRECHECK_FAILED
        return 1
      }
      ;;
    both)
      [[ "$HAS_SERVER" == "1" && "$HAS_CLIENT" == "1" ]] || {
        echo "ERROR: --role both requested but dual-role installation was not detected" >&2
        return 1
      }
      [[ -f "$FRPC_CONFIG" ]] || {
        echo "ERROR: missing FRP client config: ${FRPC_CONFIG}" >&2
        frp_emit_failure_class INSTALL_PRECHECK_FAILED
        return 1
      }
      ;;
  esac
  if [[ "$SKIP_SYSTEMD" != "1" ]]; then
    if frp_is_darwin; then
      require_cmd launchctl || return 1
    else
      require_cmd systemctl || return 1
    fi
  fi
  _frp_update_disk_bin="$FRPS_BIN"
  if [[ "$UPDATE_ROLE" == "client" ]]; then
    _frp_update_disk_bin="$FRPC_BIN"
  fi
  if ! frp_has_disk_kb "$(dirname "$_frp_update_disk_bin")" 65536; then
    echo "ERROR: not enough disk space to install FRP" >&2
    return 1
  fi
  if [[ "$UPDATE_ROLE" == "both" ]] && ! frp_has_disk_kb "$(dirname "$FRPC_BIN")" 65536; then
    echo "ERROR: not enough disk space to install FRP client binary" >&2
    return 1
  fi
  if ! frp_has_disk_kb "$BACKUP_ROOT" 65536; then
    echo "ERROR: not enough disk space for an FRP rollback backup" >&2
    return 1
  fi
}

prepare_new_binary() {
  local archive extracted expected url member dest fixture fixture_client
  EXTRACTED_FRPS="${TMPDIR}/frps.new"
  EXTRACTED_FRPC="${TMPDIR}/frpc.new"
  if frp_test_harness_enabled && [[ "${FRP_UPDATE_HOOK_DOWNLOAD_FAIL:-}" == "1" ]]; then
    echo "ERROR: failed to download FRP archive" >&2
    UPDATE_FAIL_CLASS=DOWNLOAD_FAILED
    return 1
  fi
  if frp_test_harness_enabled && [[ -n "${FRP_UPDATE_HOOK_NEW_BINARY:-}" ]]; then
    fixture="${FRP_UPDATE_HOOK_NEW_BINARY}"
    fixture_client="${FRP_UPDATE_HOOK_NEW_BINARY_FRPC:-$fixture}"
    [[ -x "$fixture" && -x "$fixture_client" ]] || {
      echo "ERROR: fixture binary is missing" >&2
      UPDATE_FAIL_CLASS=STAGING_FAILED
      return 1
    }
    case "${UPDATE_ROLE:-server}" in
      client)
        cp "$fixture_client" "$EXTRACTED_FRPC"
        chmod 0755 "$EXTRACTED_FRPC"
        ;;
      both)
        cp "$fixture" "$EXTRACTED_FRPS"
        cp "$fixture_client" "$EXTRACTED_FRPC"
        chmod 0755 "$EXTRACTED_FRPS" "$EXTRACTED_FRPC"
        ;;
      *)
        cp "$fixture" "$EXTRACTED_FRPS"
        chmod 0755 "$EXTRACTED_FRPS"
        ;;
    esac
    if [[ "${FRP_UPDATE_HOOK_CHECKSUM_FAIL:-}" == "1" ]]; then
      echo "ERROR: SHA256 checksum mismatch" >&2
      UPDATE_FAIL_CLASS=INTEGRITY_FAILED
      return 1
    fi
    if [[ "${FRP_UPDATE_HOOK_ARCH_FAIL:-}" == "1" ]]; then
      echo "ERROR: candidate architecture (other) does not match this host (${FRP_ARCH})" >&2
      UPDATE_FAIL_CLASS=INTEGRITY_FAILED
      return 1
    fi
    return 0
  fi

  archive="${TMPDIR}/frp.tar.gz"
  url="$(frp_release_url "$TARGET_VERSION" "$FRP_ARCH")"
  expected="$(frp_checksum_for "$TARGET_VERSION" "$FRP_ARCH")"
  curl -fL --retry 3 --connect-timeout 10 --max-time 120 -o "$archive" "$url" || {
    echo "ERROR: failed to download FRP archive" >&2
    UPDATE_FAIL_CLASS=DOWNLOAD_FAILED
    return 1
  }
  frp_verify_sha256 "$expected" "$archive" || {
    UPDATE_FAIL_CLASS=INTEGRITY_FAILED
    return 1
  }
  case "${UPDATE_ROLE:-server}" in
    client)
      extracted="$(frp_extract_frp_member "$archive" "$TMPDIR" frpc)" || {
        UPDATE_FAIL_CLASS=STAGING_FAILED
        return 1
      }
      cp "$extracted" "$EXTRACTED_FRPC"
      chmod 0755 "$EXTRACTED_FRPC"
      ;;
    both)
      extracted="$(frp_extract_frp_member "$archive" "$TMPDIR" frps)" || {
        UPDATE_FAIL_CLASS=STAGING_FAILED
        return 1
      }
      cp "$extracted" "$EXTRACTED_FRPS"
      chmod 0755 "$EXTRACTED_FRPS"
      extracted="$(frp_extract_frp_member "$archive" "$TMPDIR" frpc)" || {
        UPDATE_FAIL_CLASS=STAGING_FAILED
        return 1
      }
      cp "$extracted" "$EXTRACTED_FRPC"
      chmod 0755 "$EXTRACTED_FRPC"
      ;;
    *)
      extracted="$(frp_extract_frp_member "$archive" "$TMPDIR" frps)" || {
        UPDATE_FAIL_CLASS=STAGING_FAILED
        return 1
      }
      cp "$extracted" "$EXTRACTED_FRPS"
      chmod 0755 "$EXTRACTED_FRPS"
      ;;
  esac
}

validate_new_binary() {
  if frp_test_harness_enabled && [[ "${FRP_UPDATE_HOOK_VERIFY_FAIL:-}" == "1" ]]; then
    echo "ERROR: configuration is not valid for the target FRP version" >&2
    UPDATE_FAIL_CLASS=STAGING_FAILED
    return 1
  fi
  case "${UPDATE_ROLE:-server}" in
    client)
      if ! frp_validate_frp_binary "$EXTRACTED_FRPC" "$TARGET_VERSION" "$FRP_ARCH"; then
        UPDATE_FAIL_CLASS=INTEGRITY_FAILED
        return 1
      fi
      "$EXTRACTED_FRPC" verify -c "$FRPC_CONFIG" || {
        echo "ERROR: configuration is not valid for the target FRP version" >&2
        UPDATE_FAIL_CLASS=STAGING_FAILED
        return 1
      }
      ;;
    both)
      if ! frp_validate_frp_binary "$EXTRACTED_FRPS" "$TARGET_VERSION" "$FRP_ARCH"; then
        UPDATE_FAIL_CLASS=INTEGRITY_FAILED
        return 1
      fi
      if ! frp_validate_frp_binary "$EXTRACTED_FRPC" "$TARGET_VERSION" "$FRP_ARCH"; then
        UPDATE_FAIL_CLASS=INTEGRITY_FAILED
        return 1
      fi
      "$EXTRACTED_FRPS" verify -c "$FRPS_CONFIG" || {
        echo "ERROR: configuration is not valid for the target FRP version" >&2
        UPDATE_FAIL_CLASS=STAGING_FAILED
        return 1
      }
      "$EXTRACTED_FRPC" verify -c "$FRPC_CONFIG" || {
        echo "ERROR: configuration is not valid for the target FRP version" >&2
        UPDATE_FAIL_CLASS=STAGING_FAILED
        return 1
      }
      ;;
    *)
      if ! frp_validate_frp_binary "$EXTRACTED_FRPS" "$TARGET_VERSION" "$FRP_ARCH"; then
        UPDATE_FAIL_CLASS=INTEGRITY_FAILED
        return 1
      fi
      "$EXTRACTED_FRPS" verify -c "$FRPS_CONFIG" || {
        echo "ERROR: configuration is not valid for the target FRP version" >&2
        UPDATE_FAIL_CLASS=STAGING_FAILED
        return 1
      }
      ;;
  esac
}

restart_frp_client_unit() {
  if [[ "$SKIP_SYSTEMD" == "1" ]]; then
    mkdir -p "$(dirname "$(frp_path /var/lib/drlink/update-actions.log)")"
    echo "restart drlink-client" >>"$(frp_path /var/lib/drlink/update-actions.log)"
    if frp_test_harness_enabled && [[ "${FRP_UPDATE_HOOK_RESTART_FAIL:-}" == "1" ]]; then
      echo "ERROR: simulated restart failure" >&2
      return 1
    fi
    return 0
  fi
  if frp_is_darwin; then
    if declare -F frp_client_restart >/dev/null 2>&1; then
      frp_client_restart || return 1
      return 0
    fi
    frp_macos_launchd_set_enabled enable || return 1
    if frp_macos_launchd_running; then
      frp_macos_launchd_kickstart || return 1
    else
      frp_macos_launchd_bootstrap || return 1
    fi
    return 0
  fi
  systemctl restart drlink-client
}

restart_frp_unit() {
  case "${UPDATE_ROLE:-server}" in
    client) restart_frp_client_unit ;;
    both)
      restart_frps || return 1
      restart_frp_client_unit
      ;;
    *) restart_frps ;;
  esac
}

# --- main ---
UPDATE_ROLE=server
UPDATE_FAIL_CLASS=""
TXN_OPERATION=frp-update
precheck || exit 1
# Role-correct transaction markers: client frpc update must not use server txn.
if [[ "$UPDATE_ROLE" == "client" ]]; then
  FRP_TXN_ROLE=client
  TXN_OPERATION=client-frp-update
else
  FRP_TXN_ROLE=server
  TXN_OPERATION=frp-update
fi
export FRP_TXN_ROLE

# Serialize against other lifecycle mutations for the same role.
if [[ "$UPDATE_ROLE" == "client" && "$HAS_SERVER" != "1" ]]; then
  if [[ -f /usr/local/lib/drlink/frp-client-common.sh ]]; then
    # shellcheck disable=SC1091
    . /usr/local/lib/drlink/frp-client-common.sh
  elif [[ -f '/Library/Application Support/drlink/lib/frp-client-common.sh' ]]; then
    # shellcheck disable=SC1091
    . '/Library/Application Support/drlink/lib/frp-client-common.sh'
  elif [[ -f "${_SCRIPT_DIR}/../lib/frp-client-common.sh" ]]; then
    # shellcheck disable=SC1091
    . "${_SCRIPT_DIR}/../lib/frp-client-common.sh"
  fi
  if declare -F frp_acquire_client_lock >/dev/null 2>&1; then
    frp_acquire_client_lock || exit 1
    trap 'frp_release_client_lock; cleanup' EXIT
  fi
else
  _frp_update_server_lock="$(frp_path /var/lib/drlink/server-lifecycle.lock)"
  mkdir -p "$(dirname "$_frp_update_server_lock")"
  if command -v flock >/dev/null 2>&1 && [[ "${FRP_UPDATE_HOOK_SKIP_SYSTEMD:-}" != "1" || -z "${FRP_DEPLOY_TEST_ROOT:-}${FRP_UPDATE_ROOT:-}" ]]; then
    exec {FRP_UPDATE_LOCK_FD}>>"$_frp_update_server_lock"
    if ! flock -n "$FRP_UPDATE_LOCK_FD"; then
      echo "ERROR: another server lifecycle operation is already running." >&2
      exit 1
    fi
    trap 'exec {FRP_UPDATE_LOCK_FD}>&- 2>/dev/null || true; cleanup' EXIT
  fi
fi

PREVIOUS_VERSION="$(frp_parse_binary_version "$FRPS_BIN")"
PREVIOUS_FRPC_VERSION="$(frp_parse_binary_version "$FRPC_BIN")"
if [[ "$UPDATE_ROLE" == "client" ]]; then
  PREVIOUS_VERSION="$PREVIOUS_FRPC_VERSION"
fi
snapshot_preservation

echo "Update role : ${UPDATE_ROLE}"
if [[ "$UPDATE_ROLE" == "both" ]]; then
  echo "Current frps: ${PREVIOUS_VERSION}"
  echo "Current frpc: ${PREVIOUS_FRPC_VERSION}"
else
  echo "Current FRP : ${PREVIOUS_VERSION}"
fi
echo "Target FRP  : ${TARGET_VERSION}"

update_needed=0
case "$UPDATE_ROLE" in
  both)
    [[ "$PREVIOUS_VERSION" != "$TARGET_VERSION" || "$PREVIOUS_FRPC_VERSION" != "$TARGET_VERSION" ]] && update_needed=1
    ;;
  client)
    [[ "$PREVIOUS_FRPC_VERSION" != "$TARGET_VERSION" ]] && update_needed=1
    ;;
  *)
    [[ "$PREVIOUS_VERSION" != "$TARGET_VERSION" ]] && update_needed=1
    ;;
esac

if [[ "$CHECK_ONLY" == "1" ]]; then
  if [[ "$update_needed" == "0" ]]; then
    echo "Update      : not needed"
  else
    echo "Update      : available"
  fi
  exit 0
fi

if [[ "$update_needed" == "0" ]]; then
  echo
  echo "FRP ${TARGET_VERSION} is already installed."
  echo "Nothing to do."
  report_preservation
  exit 0
fi

echo
echo "Checking prerequisites..."
frp_checksum_for "$TARGET_VERSION" "$FRP_ARCH" >/dev/null

TMPDIR="$(frp_secure_mktemp_dir)"
FRP_TXN_MUTATION_STARTED=false frp_txn_write "$TXN_OPERATION" stage "$PREVIOUS_VERSION" "$TARGET_VERSION"

echo "Downloading FRP v${TARGET_VERSION}..."
prepare_new_binary || fail_update "${UPDATE_FAIL_CLASS:-DOWNLOAD_FAILED}"

echo "Verifying SHA256..."
# Real downloads already verified the archive. Fixture path verifies via hooks.

echo "Validating configuration..."
validate_new_binary || fail_update "${UPDATE_FAIL_CLASS:-STAGING_FAILED}"

echo "Creating rollback backup..."
create_backup || fail_update STAGING_FAILED
FRP_TXN_SNAPSHOT_PATH="$BACKUP_DIR" \
FRP_TXN_MUTATION_STARTED=true \
  frp_txn_write "$TXN_OPERATION" commit "$PREVIOUS_VERSION" "$TARGET_VERSION"

echo "Installing FRP v${TARGET_VERSION}..."
case "$UPDATE_ROLE" in
  client)
    frp_atomic_install "$EXTRACTED_FRPC" "$FRPC_BIN" 0755 || fail_update FILE_COMMIT_FAILED
    ;;
  both)
    frp_atomic_install "$EXTRACTED_FRPS" "$FRPS_BIN" 0755 || fail_update FILE_COMMIT_FAILED
    frp_atomic_install "$EXTRACTED_FRPC" "$FRPC_BIN" 0755 || fail_update FILE_COMMIT_FAILED
    ;;
  *)
    frp_atomic_install "$EXTRACTED_FRPS" "$FRPS_BIN" 0755 || fail_update FILE_COMMIT_FAILED
    ;;
esac
INSTALLED_NEW=1

# Clear the pending marker before restart. Client restarts can drop the SSH
# path used to drive the update; leaving client-frp-update pending would make a
# later project upgrade attempt treat the FRP binary backup as a tools snapshot.
frp_txn_clear "$FRP_TXN_ROLE"

echo "Restarting ${UPDATE_ROLE} runtime..."
restart_frp_unit || fail_update SERVICE_START_FAILED

echo "Running health checks..."
health_check || fail_update HEALTH_CHECK_FAILED

frp_audit_emit frp_update.completed
echo
echo "FRP update completed successfully."
echo
if [[ "$UPDATE_ROLE" == "both" ]]; then
  echo "Previous frps: ${PREVIOUS_VERSION}"
  echo "Previous frpc: ${PREVIOUS_FRPC_VERSION}"
  echo "Current frps : $(frp_parse_binary_version "$FRPS_BIN")"
  echo "Current frpc : $(frp_parse_binary_version "$FRPC_BIN")"
elif [[ "$UPDATE_ROLE" == "client" ]]; then
  echo "Previous : ${PREVIOUS_FRPC_VERSION}"
  echo "Current  : $(frp_parse_binary_version "$FRPC_BIN")"
else
  echo "Previous : ${PREVIOUS_VERSION}"
  echo "Current  : $(frp_parse_binary_version "$FRPS_BIN")"
fi
report_preservation
