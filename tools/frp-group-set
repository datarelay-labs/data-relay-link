#!/usr/bin/env python3
"""Create and mutate server-owned manual groups and memberships."""
import argparse
import fcntl
import importlib.util
import json
import os
import sys
from pathlib import Path

ROOT = os.environ.get('FRP_DEPLOY_TEST_ROOT', '')


def load_module(name, relative):
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / 'lib' / relative,
        Path(ROOT) / 'usr/local/lib/drlink' / relative if ROOT else None,
        Path('/usr/local/lib/drlink') / relative,
    ]
    for path in candidates:
        if path is not None and path.is_file():
            spec = importlib.util.spec_from_file_location(name, str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    return None


CREG = load_module('frp_client_registry', 'frp_client_registry.py')
if CREG is None:
    raise SystemExit('ERROR: missing frp_client_registry.py')


def fail(message):
    raise SystemExit('ERROR: %s' % message)


def registry_path():
    cfg = json.loads(Path(ROOT + '/etc/drlink/config.json').read_text())
    path = Path(cfg['registry_file'])
    if ROOT and not str(path).startswith(ROOT):
        path = Path(ROOT + str(path))
    return path


def parse_registry(state):
    """Shared schema + group invariant gate for every group tooling read."""
    if state.get('schema_version') != 2:
        fail('unsupported registry schema version')
    if not isinstance(state.get('clients', {}), dict):
        fail('registry clients must be an object')
    try:
        groups = CREG.ensure_groups_map(state)
        CREG.validate_group_invariants(state)
    except ValueError as exc:
        fail(str(exc))
    if state.get('groups') is None:
        state['groups'] = groups
    return state


def read_registry():
    """Read-only load used for confirmation previews (no lock held)."""
    path = registry_path()
    if not path.exists():
        fail('registry.json is missing (authoritative registry state required)')
    try:
        state = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        fail('unable to read registry.json: %s' % exc)
    return parse_registry(state)


def mutate_registry(callback):
    path = registry_path()
    if not path.exists():
        fail('registry.json is missing (authoritative registry state required)')
    lock_path = path.parent / 'registry.lock'
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(lock_path), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        try:
            state = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError) as exc:
            fail('unable to read registry.json: %s' % exc)
        parse_registry(state)
        result = callback(state)
        try:
            CREG.validate_group_invariants(state)
        except ValueError as exc:
            fail('refusing to write registry: %s' % exc)
        CREG.atomic_write_json(path, state)
        return result
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def audit(event, **fields):
    module = load_module('frp_audit', 'frp_audit.py')
    if module is not None:
        try:
            module.emit(event, **fields)
        except Exception:
            pass


def cmd_create(args):
    try:
        name = CREG.validate_group_name(args.name)
        description = CREG.validate_group_description(args.description)
    except ValueError as exc:
        fail(str(exc))

    def change(state):
        if CREG.find_group_id_by_name(state, name):
            fail('group name already exists: %s' % name)
        gid = CREG.generate_group_id(state['groups'])
        now = CREG.utc_now_iso()
        group = {'name': name, 'created_at': now, 'updated_at': now}
        if description:
            group['description'] = description
        state['groups'][gid] = group
        return gid, group

    gid, group = mutate_registry(change)
    print('Created group: %s' % group['name'])
    print()
    print('Add a client:')
    print('  set client <CLIENT> group %s' % group['name'])
    print()
    print('View:')
    print('  show group %s' % group['name'])
    audit('group.created', group_id=gid, group_name=group['name'])


def cmd_set(args):
    try:
        value = (
            CREG.validate_group_name(args.value)
            if args.property == 'name'
            else CREG.validate_group_description(args.value)
        )
    except ValueError as exc:
        fail(str(exc))

    def change(state):
        gid, group = CREG.resolve_manual_group_or_exit(state, args.selector)
        old = str(group.get(args.property) or '')
        if args.property == 'name':
            clash = CREG.find_group_id_by_name(state, value, exclude_id=gid)
            if clash:
                fail('group name already exists: %s' % value)
            group['name'] = value
        elif value:
            group['description'] = value
        else:
            group.pop('description', None)
        group['updated_at'] = CREG.utc_now_iso()
        return gid, group, old

    gid, group, old = mutate_registry(change)
    print('Updated group %s' % gid)
    print('%s: %s' % (args.property.capitalize(), group.get(args.property) or '(cleared)'))
    event = 'group.renamed' if args.property == 'name' else 'group.description_changed'
    audit(
        event,
        group_id=gid,
        group_name=group.get('name'),
        details={'old_value': old},
    )


def group_member_ids(state, gid):
    return [
        mid
        for mid, client in (state.get('clients') or {}).items()
        if isinstance(client, dict) and gid in (client.get('group_ids') or [])
    ]


def confirm_group_delete(selector, yes=False):
    """Show delete impact and confirm before mutating.

    The prompt happens without the registry lock, so the immutable GROUP ID
    (never the selector) is returned and the impact is revalidated under the
    lock: a rename or membership change during the prompt must not silently
    redirect or widen the delete.
    """
    state = read_registry()
    gid, group = CREG.resolve_manual_group_or_exit(state, selector)
    name = CREG.sanitize_display(group.get('name') or gid, 64)
    members = group_member_ids(state, gid)
    if yes:
        return gid, name, members
    if not sys.stdin.isatty():
        fail(
            'deleting group "%s" affects %d client(s); re-run with --yes to '
            'confirm non-interactively.' % (name, len(members))
        )
    print('Group ID      : %s' % gid)
    print('Name          : %s' % name)
    print('Client count  : %d' % len(members))
    print('Group membership is removed. Client identity, services, and ports')
    print('are not changed.')
    answer = input(
        'Delete group "%s" from %d clients? [y/N]: ' % (name, len(members))
    ).strip().lower()
    if answer not in ('y', 'yes'):
        raise SystemExit('Aborted.')
    return gid, name, members


def cmd_delete(args):
    gid, name, members_before = confirm_group_delete(args.selector, yes=args.yes)
    expected = sorted(str(mid) for mid in members_before)

    def change(state):
        group = state['groups'].get(gid)
        if not isinstance(group, dict):
            fail('group %s changed while waiting for confirmation; re-run the command' % gid)
        if sorted(str(mid) for mid in group_member_ids(state, gid)) != expected:
            fail('group membership changed while waiting for confirmation; re-run the command')
        for client in state['clients'].values():
            if not isinstance(client, dict):
                continue
            try:
                ids = CREG.normalize_group_ids(client.get('group_ids'))
            except ValueError:
                fail('client has malformed group_ids')
            CREG.set_client_group_ids(client, [item for item in ids if item != gid])
        state['groups'].pop(gid)
        return str(group.get('name') or '')

    name = mutate_registry(change) or name
    print('Deleted group %s (%s)' % (gid, name))
    print('Removed group membership from %d client(s).' % len(expected))
    print('Client identity, services, and ports were not changed.')
    audit(
        'group.deleted',
        group_id=gid,
        group_name=name,
        details={'client_count': len(expected)},
    )


def change_membership(args, adding):
    def change(state):
        mid, client = CREG.resolve_client_or_exit(state, args.client)
        gid, group = CREG.resolve_manual_group_or_exit(state, args.group)
        try:
            ids = CREG.normalize_group_ids(client.get('group_ids'))
        except ValueError as exc:
            fail(str(exc))
        present = gid in ids
        if adding and not present:
            ids.append(gid)
        if not adding and present:
            ids.remove(gid)
        CREG.set_client_group_ids(client, ids)
        return mid, gid, group, present

    mid, gid, group, present = mutate_registry(change)
    name = CREG.sanitize_display(group.get('name') or gid, 64)
    cid = CREG.sanitize_display(mid, 16)
    if adding:
        if present:
            print('Client %s already in group %s (%s)' % (cid, gid, name))
        else:
            print('Added client %s to group %s (%s)' % (cid, gid, name))
            audit('group.member_added', group_id=gid, group_name=name, client_id=mid)
    elif present:
        print('Removed client %s from group %s (%s)' % (cid, gid, name))
        audit('group.member_removed', group_id=gid, group_name=name, client_id=mid)
    else:
        print('Client %s was not in group %s (%s)' % (cid, gid, name))


def build_parser():
    parser = argparse.ArgumentParser(description='Manage manual client groups')
    subs = parser.add_subparsers(dest='command', required=True)
    create = subs.add_parser('create')
    create.add_argument('name')
    create.add_argument('--description', default='')
    create.set_defaults(func=cmd_create)
    set_cmd = subs.add_parser('set')
    set_cmd.add_argument('selector')
    set_cmd.add_argument('property', choices=('name', 'description'))
    set_cmd.add_argument('value')
    set_cmd.set_defaults(func=cmd_set)
    delete = subs.add_parser('delete')
    delete.add_argument('selector')
    delete.add_argument(
        '--yes',
        action='store_true',
        help='confirm the delete without an interactive prompt',
    )
    delete.set_defaults(func=cmd_delete)
    for command, adding in (('add-member', True), ('remove-member', False)):
        member = subs.add_parser(command)
        member.add_argument('client')
        member.add_argument('group')
        member.set_defaults(func=lambda args, add=adding: change_membership(args, add))
    return parser


def main():
    args = build_parser().parse_args()
    args.func(args)


if __name__ == '__main__':
    try:
        main()
    except BrokenPipeError:
        pass
