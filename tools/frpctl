      frpctl_dispatch set server installer-url "$value" || true
      ;;
    set_windows_installer_url)
      value="$(frpctl_nav_prompt_id "Windows client installer URL: ")" || return 1
      frpctl_dispatch set server windows-installer-url "$value" || true
      ;;
    restore_backup)
      path="$(frpctl_select_backup_archive)" || return 1
      frpctl_dispatch system restore "$path" || true
      ;;
    edit_service|enable_service|disable_service)
      id="$(frpctl_select_inventory local-services "Service: ")" || return 1
      case "$workflow" in
        edit_service)
          echo
          echo "1) target-host"
          echo "2) target-port"
          echo "3) ssh-user"
          echo "4) name"
          echo "5) health-type"
          echo "6) Back"
          path="$(frpctl_read "Select property: " "")" || return 1
          case "$path" in
            1) path="target-host" ;;
            2) path="target-port" ;;
