          ;;
        enable_service) frpctl_dispatch set service "$id" enabled || true ;;
        disable_service) frpctl_dispatch unset service "$id" enabled || true ;;
      esac
      ;;
    help) frpctl_menu_commands ;;
    *)
      echo "ERROR: unsupported guided workflow: $workflow" >&2
      return 1
      ;;
  esac
}

frpctl_nav_loop() {
  local menu_key="$1"
  local choice action_id kind target label top
  local -a stack=()
  local shown_identity=0
  while true; do
    echo
    # Show product/build identity once when guided navigation starts outside the
    # REPL. Inside the REPL the identity banner was already printed at entry.
    # Never reprint it above every submenu.
    if [[ "$shown_identity" -eq 0 ]]; then
      if [[ "${FRP_CTL_REPL:-}" != "1" ]]; then
        frpctl_header
      fi
      shown_identity=1
    fi
    frpctl_render_nav_menu "$menu_key"
    echo
    if [[ "${FRP_CTL_TEST_MENU:-}" == "1" ]]; then
      return 0
    fi
    choice="$(frpctl_read "Select: " "")" || return 1
    if ! {
      read -r action_id
      read -r kind
      read -r target
      read -r label
    } < <(frpctl_nav_resolve "$menu_key" "$choice" 2>/dev/null); then
      echo "ERROR: select a valid menu number" >&2
      continue
    fi
    case "$kind" in
      exit)
        echo "Exit."
        return 0
        ;;
      back)
        if ((${#stack[@]} == 0)); then
          return 0
        fi
        top=$((${#stack[@]} - 1))
        menu_key="${stack[$top]}"
        if ((top == 0)); then
          stack=()
        else
          stack=("${stack[@]:0:$top}")
        fi
        ;;
      submenu)
        stack+=("$menu_key")
        menu_key="$target"
        ;;
      command)
        frpctl_nav_dispatch_command "$target"
        ;;
      workflow)
        frpctl_nav_workflow "$target"
        ;;
      help)
        frpctl_menu_commands
        ;;
      *)
        echo "ERROR: select a valid menu number" >&2
        ;;
    esac
  done
}

frpctl_client_menu() {
  frpctl_nav_loop client
}

frpctl_server_menu() {
  frpctl_nav_loop server
}

frpctl_both_menu() {
  frpctl_nav_loop both
}

frpctl_input_init() {
  # Command substitution (name="$(frpctl_read ...)") runs each prompt in a new
  # subshell, so in-memory fds/exports cannot carry the read cursor. Key the
  # spool by PPID so sibling subshells share one file + offset.
  if [[ -z "${FRP_CTL_TEST_INPUT:-}" ]]; then
    return 0
  fi
  _FRP_CTL_INPUT_FILE="${TMPDIR:-/tmp}/frpctl-test-input.${PPID}"
  _FRP_CTL_INPUT_POS_FILE="${_FRP_CTL_INPUT_FILE}.pos"
  if [[ ! -f "${_FRP_CTL_INPUT_FILE}" ]]; then
    printf '%s' "${FRP_CTL_TEST_INPUT}" >"${_FRP_CTL_INPUT_FILE}"
    if [[ "${FRP_CTL_TEST_INPUT}" != *$'\n' ]]; then
      printf '\n' >>"${_FRP_CTL_INPUT_FILE}"
    fi
    printf '0\n' >"${_FRP_CTL_INPUT_POS_FILE}"
  fi
}

frpctl_input_cleanup() {
  if [[ -n "${_FRP_CTL_INPUT_FILE:-}" && -f "${_FRP_CTL_INPUT_FILE}" ]]; then
    rm -f "${_FRP_CTL_INPUT_FILE}"
  fi
  if [[ -n "${_FRP_CTL_INPUT_POS_FILE:-}" && -f "${_FRP_CTL_INPUT_POS_FILE}" ]]; then
    rm -f "${_FRP_CTL_INPUT_POS_FILE}"
  fi
  # Also sweep the PPID-keyed spool used by TEST_INPUT reads.
  rm -f "${TMPDIR:-/tmp}/frpctl-test-input.$$" "${TMPDIR:-/tmp}/frpctl-test-input.$$.pos" \
    "${TMPDIR:-/tmp}/frpctl-test-input.${PPID}" "${TMPDIR:-/tmp}/frpctl-test-input.${PPID}.pos" 2>/dev/null || true
  _FRP_CTL_INPUT_READY=""
  _FRP_CTL_INPUT_FILE=""
  _FRP_CTL_INPUT_POS_FILE=""
}

# Returns 1 on EOF. Empty Enter is a successful empty string.
frpctl_try_read() {
  local prompt="$1"
  local value=""
  frpctl_input_init
  if [[ -n "${FRP_CTL_TEST_INPUT:-}" ]]; then
    local pos lines
    pos="$(cat "${_FRP_CTL_INPUT_POS_FILE}")"
    pos=$((pos + 1))
    lines="$(wc -l < "${_FRP_CTL_INPUT_FILE}")"
    lines="${lines// /}"
    if [[ "$pos" -gt "$lines" ]]; then
      return 1
    fi
    value="$(sed -n "${pos}p" "${_FRP_CTL_INPUT_FILE}")"
    printf '%s\n' "$pos" >"${_FRP_CTL_INPUT_POS_FILE}"
  elif [[ -t 0 ]]; then
    # Use readline (-e) with -p so Backspace edits only the input buffer.
    # Never print the prompt separately then read: that allows the cursor to
    # walk into the immutable prompt text on some terminals/SSH clients.
    if ! IFS= read -e -r -p "$prompt" value; then
      return 1
    fi
  else
    echo "ERROR: no TTY for interactive menu; pass a command such as: ${FRP_CTL_CMD_NAME} status" >&2
    return 1
  fi
  printf '%s' "$value"
  return 0
}

frpctl_read() {
  local prompt="$1" default="${2:-}"
  local value=""
  if ! value="$(frpctl_try_read "$prompt")"; then
    return 1
  fi
  if [[ -z "$value" ]]; then
    value="$default"
  fi
  printf '%s' "$value"
}

frpctl_zt_validate_field() {
  # args: kind value -> prints normalized value on success; stderr + rc=1 on failure
  local kind="$1" value="$2"
  python3 - "$kind" "$value" <<'PY'
import re, sys
kind, value = sys.argv[1], sys.argv[2]
text = (value or "").strip()

def fail(msg):
    print("ERROR: %s" % msg, file=sys.stderr)
    raise SystemExit(1)

if kind == "label":
    if not text:
        fail("Client name cannot be blank.")
    if any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in text):
        fail("Client name must not contain control characters or newlines")
    if len(text) > 64:
        fail("Client name must be at most 64 characters")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._ -]{0,63}", text):
        fail("invalid client name")
    print(text)
elif kind == "service_id":
    if not text:
        fail("Service ID is required.")
    lowered = text.lower()
    if not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,31}", lowered):
        fail("invalid service ID; use lowercase letters, digits, '.', '_' or '-' (max 32)")
    print(lowered)
elif kind == "target_host":
    if (
        not text
        or len(text) > 253
        or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in text)
        or any(c in text for c in " /\\;|&$`'\"<>")
    ):
        fail("invalid target host")
    print(text)
elif kind == "target_port":
    try:
        port = int(text)
    except ValueError:
        fail("invalid target port; must be an integer 1-65535")
    if port < 1 or port > 65535:
        fail("invalid target port; must be an integer 1-65535")
    print(str(port))
elif kind == "ssh_user":
    if not text:
        fail("SSH user is required.")
    if not re.fullmatch(r"[A-Za-z0-9._@-]{1,32}", text):
        fail("invalid ssh_user")
    print(text)
else:
    fail("unknown validation kind")
PY
}

