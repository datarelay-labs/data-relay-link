  # Bash filename completion cannot become the fallback.
  if [[ "${FRP_CTL_DISABLE_TAB:-}" == "1" ]]; then
    return 0
  fi
  if (( BASH_VERSINFO[0] < 4 )); then
    return 0
  fi
  if bind -x '"\t": frpctl_readline_complete' 2>/dev/null; then
    bind 'set disable-completion on' 2>/dev/null || true
    _FRP_CTL_BOUND_TAB=1
  fi
}

frpctl_repl_disable_completion() {
  if [[ "${_FRP_CTL_BOUND_TAB:-}" == "1" ]]; then
    bind -r '\t' 2>/dev/null || true
  fi
  _FRP_CTL_BOUND_TAB=""
}

frpctl_edit_distance() {
  python3 - "$1" "$2" <<'PY'
import sys
a, b = sys.argv[1], sys.argv[2]
la, lb = len(a), len(b)
if abs(la - lb) > 3:
    print(99)
    raise SystemExit(0)
prev = list(range(lb + 1))
for i, ca in enumerate(a, 1):
    cur = [i]
    for j, cb in enumerate(b, 1):
        ins, delete, sub = cur[j - 1] + 1, prev[j] + 1, prev[j - 1] + (ca != cb)
        cur.append(min(ins, delete, sub))
    prev = cur
print(prev[-1])
PY
}

frpctl_suggest() {
  local unknown="$1"
  local ranked=""
  [[ -n "$unknown" ]] || return 0
  # One Python process ranks all candidates (prefix + edit distance ≤ 2).
  # Script comes from FD 3 so stdin can carry the command list.
  ranked="$(
    frpctl_known_commands | sort -u | python3 /dev/fd/3 "$unknown" 3<<'PY'
import sys
unknown = sys.argv[1]
cmds = [line.strip() for line in sys.stdin.read().splitlines() if line.strip() and line.strip() != "?"]

def distance(a, b):
    if a == b:
        return 0
    if not a or not b:
        return max(len(a), len(b))
    prev = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        cur = [i]
        for j, cb in enumerate(b, 1):
            ins, delete, sub = cur[j - 1] + 1, prev[j] + 1, prev[j - 1] + (ca != cb)
            cur.append(min(ins, delete, sub))
        prev = cur
    return prev[-1]

seen = set()
for cmd in cmds:
    if cmd in seen:
        continue
    keep = False
    if len(unknown) >= 3 and cmd.startswith(unknown):
        keep = True
    elif len(cmd) >= 3 and unknown.startswith(cmd):
        keep = True
    else:
        d = distance(unknown, cmd)
        if 1 <= d <= 2:
            keep = True
    if keep:
        seen.add(cmd)
        print(cmd)
PY
  )" || true
  if [[ -z "$ranked" ]]; then
    return 0
  fi
  echo "Did you mean:"
  while IFS= read -r s; do
    [[ -n "$s" ]] || continue
    echo "  $s"
  done <<<"$ranked"
  echo
}

frpctl_unknown_command() {
