    printf '%s' "$path"
    return 0
  fi
  if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= idx )); then
    printf '%s' "${archives[$((choice - 1))]}"
    return 0
  fi
