#!/usr/bin/env bash
# Internal Data Relay Link operator dispatcher (not installed on PATH).
# Canonical user-facing CLI is /usr/local/bin/drlink.
# Thin dispatcher over existing commands. Does not reimplement registry or
# client-state mutations.
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1

_FRPCTL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# When invoked via tools/drlink, FRP_CTL_CMD_NAME is already set to drlink.
if [[ -z "${FRP_CTL_CMD_NAME:-}" || "${FRP_CTL_CMD_NAME}" == "frpctl" ]]; then
  if [[ -x /usr/local/bin/drlink ]] || [[ "${FRP_CTL_FORCE_DRLINK:-}" == "1" ]]; then
    FRP_CTL_CMD_NAME="drlink"
  else
    FRP_CTL_CMD_NAME="$(basename "${BASH_SOURCE[0]}")"
  fi
fi
export FRP_CTL_CMD_NAME
FRP_CTL_PRODUCT_NAME="${FRP_CTL_PRODUCT_NAME:-Data Relay Link}"
FRP_CTL_PRODUCT_FAMILY="${FRP_CTL_PRODUCT_FAMILY:-Data Relay Link Management}"
FRP_CTL_PROMPT="${FRP_CTL_PROMPT:-${FRP_CTL_CMD_NAME}> }"
_FRP_CTL_SESSION_HIST=()
_FRP_CTL_RC=0
if [[ -f "${_FRPCTL_DIR}/../lib/frp-doctor-common.sh" ]]; then
  # shellcheck source=../lib/frp-doctor-common.sh
  . "${_FRPCTL_DIR}/../lib/frp-doctor-common.sh"
elif [[ -f "${_FRPCTL_DIR}/frp-doctor-common.sh" ]]; then
  # Installed beside libraries at /usr/local/lib/drlink/frpctl
  # shellcheck disable=SC1091
  . "${_FRPCTL_DIR}/frp-doctor-common.sh"
elif [[ -f /usr/local/lib/drlink/frp-doctor-common.sh ]]; then
  # shellcheck disable=SC1091
  . /usr/local/lib/drlink/frp-doctor-common.sh
elif [[ -f '/Library/Application Support/drlink/lib/frp-doctor-common.sh' ]]; then
  # shellcheck disable=SC1091
  . '/Library/Application Support/drlink/lib/frp-doctor-common.sh'
fi

frpctl_path() {
  local p="$1"
  local root="${FRP_CTL_TEST_ROOT:-${FRP_CLIENT_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-${FRP_UPDATE_ROOT:-}}}}"
  if declare -F frp_platform_map_path >/dev/null 2>&1; then
    p="$(frp_platform_map_path "$p")"
  fi
  if [[ -n "$root" ]]; then
    printf '%s' "${root}${p}"
  else
    printf '%s' "$p"
  fi
}

frpctl_is_client() {
  if [[ -f "$(frpctl_path /etc/frp/client-state.json)" ]]; then
    return 0
  fi
  if [[ -f "$(frpctl_path /etc/frp/frpc.toml)" && -f "$(frpctl_path /etc/frp/client-identity.key)" ]]; then
    return 0
  fi
  return 1
}

frpctl_is_server() {
  if [[ -f "$(frpctl_path /etc/drlink/config.json)" ]]; then
    return 0
  fi
  if [[ -f "$(frpctl_path /etc/frp/server_token)" && -f "$(frpctl_path /var/lib/drlink/registry.json)" ]]; then
    return 0
  fi
  return 1
}

frpctl_read_kv() {
  local file="$1" key="$2"
  if [[ ! -f "$file" ]]; then
    return 0
  fi
  awk -F= -v k="$key" '$1==k {print substr($0, index($0,"=")+1); exit}' "$file"
}

frpctl_project_version() {
  local pv
  pv="$(frpctl_read_kv "$(frpctl_path /etc/drlink/version)" PROJECT_VERSION)"
  if [[ -z "$pv" ]]; then
    printf '%s' "legacy / unknown"
    return 0
  fi
  printf '%s' "$pv"
}

frpctl_probe_frp_binary_version() {
  local bin="$1" raw parsed
  [[ -x "$bin" ]] || return 1
  raw="$("$bin" --version 2>/dev/null)" || return 1
  parsed="$(python3 - "$raw" <<'PYVER'
import re, sys
raw = sys.argv[1]
if any(ord(ch) < 32 or ord(ch) == 127 for ch in raw):
    raise SystemExit(1)
text = raw.strip()
match = re.fullmatch(
    r'(?:frp[cs]\s+version\s+)?v?([0-9]+(?:\.[0-9]+){1,3}(?:[-+][0-9A-Za-z.-]+)?)',
    text,
    flags=re.IGNORECASE,
)
if not match:
    raise SystemExit(1)
print(match.group(1))
PYVER
)" || return 1
  [[ -n "$parsed" ]] || return 1
  printf '%s' "$parsed"
}

frpctl_binary_frp_version() {
  local server_version="" client_version=""
  if frpctl_is_server; then
    server_version="$(frpctl_probe_frp_binary_version "$(frpctl_path /usr/local/bin/frps)")" || server_version=""
  fi
  if frpctl_is_client; then
    client_version="$(frpctl_probe_frp_binary_version "$(frpctl_path /usr/local/bin/frpc)")" || client_version=""
  fi
  if [[ -n "$server_version" && -n "$client_version" ]]; then
    if [[ "$server_version" == "$client_version" ]]; then
      printf '%s' "$server_version"
    else
      printf 'frps %s / frpc %s' "$server_version" "$client_version"
    fi
    return 0
  fi
  if [[ -n "$server_version" ]]; then
    printf '%s' "$server_version"
    return 0
  fi
  if [[ -n "$client_version" ]]; then
    printf '%s' "$client_version"
    return 0
  fi
  return 1
}

frpctl_frp_version() {
  local fv
  fv="$(frpctl_read_kv "$(frpctl_path /etc/drlink/version)" FRP_VERSION)"
  if [[ -n "$fv" ]]; then
    printf '%s' "$fv"
    return 0
  fi
  fv="$(frpctl_binary_frp_version)" || fv=""
  if [[ -n "$fv" ]]; then
    printf '%s' "$fv"
    return 0
  fi
  printf '%s' "legacy / unknown"
}

frpctl_release_channel() {
  local ch
  ch="$(frpctl_read_kv "$(frpctl_path /etc/drlink/version)" RELEASE_CHANNEL)"
  if [[ -z "$ch" ]]; then
    printf '%s' "unknown"
    return 0
  fi
  printf '%s' "$ch"
}

frpctl_source_ref() {
  local ref
  ref="$(frpctl_read_kv "$(frpctl_path /etc/drlink/version)" SOURCE_REF)"
  if [[ -z "$ref" ]]; then
    printf '%s' "unknown"
    return 0
  fi
  printf '%s' "$ref"
}

frpctl_bundle_sha256() {
  local sha
  sha="$(frpctl_read_kv "$(frpctl_path /etc/drlink/version)" BUNDLE_SHA256)"
  if [[ -z "$sha" ]]; then
    printf '%s' "unknown"
    return 0
  fi
  printf '%s' "$sha"
}

frpctl_role_label() {
  local client=0 server=0
  frpctl_is_client && client=1
  frpctl_is_server && server=1
  if [[ "$client" == "1" && "$server" == "1" ]]; then
    printf '%s' "Client + Server"
  elif [[ "$client" == "1" ]]; then
    printf '%s' "Client"
  elif [[ "$server" == "1" ]]; then
    printf '%s' "Server"
  else
    printf '%s' "unknown"
  fi
}

frpctl_require_install() {
  if frpctl_is_client || frpctl_is_server; then
    return 0
  fi
  echo "ERROR: no ${FRP_CTL_PRODUCT_NAME} installation was found on this host." >&2
  echo "Install the server or client bootstrap first." >&2
  return 1
}

frpctl_find_cmd() {
  local name="$1" cand
  if [[ -n "${FRP_CTL_BIN_DIR:-}" ]]; then
    cand="${FRP_CTL_BIN_DIR}/${name}"
    if [[ -e "$cand" ]]; then
      printf '%s' "$cand"
      return 0
    fi
  fi
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  # Canonical install layout keeps management helpers under lib/drlink (not on PATH).
  # Legacy PATH locations remain as fallbacks for mid-upgrade hosts.
  for cand in \
    "/usr/local/lib/drlink/${name}" \
    "/usr/local/sbin/${name}" \
    "/usr/local/bin/${name}"; do
    if [[ -x "$cand" ]]; then
      printf '%s' "$cand"
      return 0
    fi
  done
  echo "ERROR: command not found: ${name}" >&2
  echo "This host does not have that ${FRP_CTL_PRODUCT_FAMILY} command installed." >&2
  return 1
}

frpctl_run() {
  local name="$1"
  shift
  local bin rc
  bin="$(frpctl_find_cmd "$name")" || return 1
  if [[ "${FRP_CTL_DRY_RUN:-}" == "1" ]]; then
    if [[ $# -gt 0 ]]; then
      printf 'DISPATCH %s' "$name"
      printf ' %s' "$@"
      printf '\n'
    else
      printf 'DISPATCH %s\n' "$name"
    fi
    # Exact argv boundary proof (tab-separated JSON array).
    python3 -c 'import json,sys; print("DISPATCH_ARGV\t"+json.dumps([sys.argv[1], *sys.argv[2:]], ensure_ascii=False))' "$name" "$@"
    return 0
  fi
  "$bin" "$@"
  rc=$?
  return "$rc"
}

# Load grammar passthrough tokens into global argv array _frpctl_pt (NUL-safe).
frpctl_load_passthrough() {
  # $1 = grammar JSON result
  # sets global array _frpctl_pt
  local result="$1"
  local arg
  _frpctl_pt=()
  while IFS= read -r -d '' arg || [[ -n "$arg" ]]; do
    _frpctl_pt+=("$arg")
  done < <(python3 -c '
import json,sys
for a in json.loads(sys.argv[1]).get("passthrough") or []:
    sys.stdout.buffer.write(str(a).encode("utf-8") + b"\0")
' "$result")
}

frpctl_json_get() {
  python3 -c 'import json,sys; v=json.loads(sys.argv[1]).get(sys.argv[2],""); print("" if v is None else v)' "$1" "$2"
}

frpctl_exec() {
  local name="$1"
  shift
  local bin
  bin="$(frpctl_find_cmd "$name")" || return 1
  if [[ "${FRP_CTL_DRY_RUN:-}" == "1" ]]; then
    if [[ $# -gt 0 ]]; then
      printf 'DISPATCH %s' "$name"
      printf ' %s' "$@"
      printf '\n'
    else
      printf 'DISPATCH %s\n' "$name"
    fi
    python3 -c 'import json,sys; print("DISPATCH_ARGV\t"+json.dumps([sys.argv[1], *sys.argv[2:]], ensure_ascii=False))' "$name" "$@"
    return 0
  fi
  exec "$bin" "$@"
}

# Direct mode may replace the process. Persistent-shell mode must return.
frpctl_invoke() {
  if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
    frpctl_run "$@"
  else
    frpctl_exec "$@"
  fi
}

frpctl_lib_candidate() {
  local name="$1" cand mapped=""
  local -a cands=()
  if declare -F frpctl_path >/dev/null 2>&1; then
    mapped="$(frpctl_path "/usr/local/lib/drlink/${name}")"
  fi
  cands+=("${_FRPCTL_DIR}/../lib/${name}")
  [[ -n "$mapped" ]] && cands+=("$mapped")
  cands+=("/usr/local/lib/drlink/${name}")
  cands+=("/Library/Application Support/drlink/lib/${name}")
  for cand in "${cands[@]}"; do
    [[ -n "$cand" && -f "$cand" ]] || continue
    printf '%s' "$cand"
    return 0
  done
  return 1
}

frpctl_grammar_py() {
  local path
  if path="$(frpctl_lib_candidate frp_ctl_grammar.py)"; then
    printf '%s' "$path"
    return 0
  fi
  echo "ERROR: the ${FRP_CTL_PRODUCT_NAME} CLI backend is incomplete (command grammar module not found)." >&2
  echo "Reinstall or run: ${FRP_CTL_CMD_NAME} update project" >&2
  return 1
}

frpctl_repl_py() {
  local path
  if path="$(frpctl_lib_candidate frp_ctl_repl.py)"; then
    printf '%s' "$path"
    return 0
  fi
  return 1
}

frpctl_role_token() {
  local client=0 server=0
  frpctl_is_client && client=1
  frpctl_is_server && server=1
  if [[ "$client" == "1" && "$server" == "1" ]]; then
    printf '%s' "both"
  elif [[ "$client" == "1" ]]; then
    printf '%s' "client"
  elif [[ "$server" == "1" ]]; then
    printf '%s' "server"
  else
    printf '%s' "unknown"
  fi
}

frpctl_grammar_payload() {
  # Cache within a REPL/session; inventory is read-only and cheap to reuse.
  if [[ -n "${FRP_CTL_GRAMMAR_PAYLOAD:-}" ]]; then
    printf '%s' "$FRP_CTL_GRAMMAR_PAYLOAD"
    return 0
  fi
  local built=""
  built="$(python3 - "$(frpctl_role_token)" "$(frpctl_path /etc/drlink/config.json)" \
    "${FRP_CTL_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-}}" "$(frpctl_path /etc/frp/client-state.json)" <<'PY'
import json, sys
from pathlib import Path
role, cfg_path, root, state_path = sys.argv[1:5]
names, services, local_services, clients_meta, groups = [], {}, [], [], []
inventory_warning = False
server_role = role in ("server", "both", "dual")
client_role = role in ("client", "both", "dual")
cfg = Path(cfg_path)

def unique_short(mid, mids, n=8):
    text = str(mid)
    length = min(n, len(text)) or 1
    while length <= len(text):
        prefix = text[:length]
        if sum(1 for item in mids if str(item).startswith(prefix)) == 1:
            return prefix
        length += 1
    return text

def _is_file(path):
    try:
        return path.is_file()
    except OSError:
        return False

if server_role and not _is_file(cfg):
    inventory_warning = True
if _is_file(cfg):
    try:
        data = json.loads(cfg.read_text(encoding="utf-8"))
        reg_raw = str((data or {}).get("registry_file") or "")
        if not reg_raw:
            inventory_warning = True
        reg = Path(reg_raw)
        if root and reg_raw and not str(reg).startswith(root):
            reg = Path(root + str(reg))
        if reg_raw and _is_file(reg):
            state = json.loads(reg.read_text(encoding="utf-8"))
            raw_clients = (state or {}).get("clients") or {}
            if not isinstance(raw_clients, dict):
                inventory_warning = True
                raw_clients = {}
            items = [
                (str(mid), client)
                for mid, client in raw_clients.items()
                if isinstance(client, dict)
            ]
            mids = [mid for mid, _client in items]
            raw_groups = (state or {}).get("groups") or {}
            if isinstance(raw_groups, dict):
                for gid, group in raw_groups.items():
                    if isinstance(group, dict):
                        groups.extend([str(gid), str(group.get("name") or "")])
            else:
                inventory_warning = True
            for mid, client in items:
                cid = unique_short(mid, mids)
                if not cid or "\n" in cid or "\r" in cid:
                    continue
                names.append(cid)
                label = str(client.get("label") or "").strip()
                host = str(client.get("hostname") or "").strip()
                clients_meta.append({"id": cid, "label": label, "hostname": host})
                sids = []
                for sid in (client.get("services") or {}):
                    sid = str(sid)
                    if sid and "\n" not in sid and "\r" not in sid:
                        sids.append(sid)
                sids = sorted(sids)
                services[cid] = sids
                services[mid] = sids
                if label:
                    services[label] = sids
                if host:
                    services[host] = sids
        elif server_role:
            inventory_warning = True
    except Exception:
        inventory_warning = True
st = Path(state_path)
if client_role and not _is_file(st):
    inventory_warning = True
if _is_file(st):
    try:
        data = json.loads(st.read_text(encoding="utf-8"))
        raw_services = (data or {}).get("services") or {}
        if not isinstance(raw_services, dict):
            inventory_warning = True
        else:
            local_services = sorted(str(s) for s in raw_services if s)
    except Exception:
        inventory_warning = True
json.dump({
    "role": role,
    "names": sorted(set(names)),
    "clients": clients_meta,
    "services": services,
    "local_services": local_services,
    "groups": sorted(set(item for item in groups if item)),
    "inventory_warning": inventory_warning,
}, sys.stdout)
PY
)" || return 1
  FRP_CTL_GRAMMAR_PAYLOAD="$built"
  export FRP_CTL_GRAMMAR_PAYLOAD
  printf '%s' "$built"
}

frpctl_grammar_call() {
  local action="$1"
  shift
  local py extra="{}"
  py="$(frpctl_grammar_py)" || return 1
  if [[ $# -gt 0 ]]; then
    extra="$1"
  fi
  python3 - "$(frpctl_grammar_payload)" "$extra" <<'PY' | python3 "$py" "$action"
import json, sys
base = json.loads(sys.argv[1])
extra = json.loads(sys.argv[2])
base.update(extra)
json.dump(base, sys.stdout)
PY
}

frpctl_usage() {
  local role usage_body catalog_py catalog_dir=""
  role="$(frpctl_role_token)"
  usage_body=""
  if catalog_py="$(frpctl_lib_candidate frp_cli_catalog.py)"; then
    catalog_dir="$(dirname "$catalog_py")"
    usage_body="$(
      python3 - "$catalog_dir" "$role" <<'PY' 2>/dev/null || true
import sys
sys.path.insert(0, sys.argv[1])
import frp_cli_catalog as catalog
print("\n".join(catalog.shell_usage_lines(sys.argv[2])))
PY
    )"
  fi
  if [[ -z "$usage_body" ]]; then
    usage_body="$(cat <<EOF
Canonical grammar:
  <resource> <action> [target] [options]

  status | version | doctor | support bundle
  client list | group list | egress list | ...
  help | help workflows | help legacy | menu | history | exit

Older verb-first commands still run for scripts. See 'help legacy'.
EOF
)"
  fi
  cat <<EOF
Usage: ${FRP_CTL_CMD_NAME} [command] [args]

${FRP_CTL_CMD_NAME} is the everyday Data Relay Link command. For normal operation,
this is the only command you need to remember:

    sudo ${FRP_CTL_CMD_NAME}

With no arguments and a TTY, that starts the persistent management CLI.
Type '?' for context help, or 'help' for full syntax. Press Tab to complete
a unique match or list next-token candidates. Type 'menu'
for the guided numbered menu.

${usage_body}

Official upstream FRP binaries are frps (server) and frpc (client).
This project does not fork FRP.
EOF
}

