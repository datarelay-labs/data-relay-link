    revoke_enrollment) frpctl_require_server || return 1; frpctl_invoke frp-enrollment-revoke "$(frpctl_json_get "$result" id)" ;;
    unset_enrollment)
      frpctl_require_server || return 1
      frpctl_unset_enrollment "$(frpctl_json_get "$result" id)"
      ;;
    purge_enrollment) frpctl_require_server || return 1; frpctl_invoke frp-enrollment-purge enrollment "$(frpctl_json_get "$result" id)" ;;
    purge_enrollments) frpctl_require_server || return 1; frpctl_invoke frp-enrollment-purge enrollments --older-than "$(frpctl_json_get "$result" older_than)" ;;
    release_client)
      frpctl_require_server || return 1
      frpctl_load_passthrough "$result"
      _rel_client="$(frpctl_json_get "$result" client)"
      _rel_ans=""
      _rel_yes=0
      for _pt in "${_frpctl_pt[@]+"${_frpctl_pt[@]}"}"; do
        [[ "$_pt" == "--yes" ]] && _rel_yes=1
      done
      if [[ "$_rel_yes" != "1" ]]; then
        if [[ -n "${FRP_CTL_TEST_INPUT:-}" || -t 0 ]]; then
          # Backend prints the release summary; only collect confirmation here
          # when stdin is interactive so one-shot non-TTY can require --yes.
          :
        elif IFS= read -r _rel_ans; then
          if [[ "$_rel_ans" != "RELEASE" ]]; then
            echo "Cancelled."
            return 0
          fi
          _rel_yes=1
        else
          echo "ERROR: releasing a client requires confirmation." >&2
          echo "Run interactively, or pass --yes:" >&2
          echo "  unset client ${_rel_client} --yes" >&2
          _FRP_CTL_RC=1
          return 0
        fi
      fi
      # Rebuild passthrough without a duplicated public --yes; backend receives
      # --yes after product-owned confirmation (or when already passed).
      _rel_pt=()
      for _pt in "${_frpctl_pt[@]+"${_frpctl_pt[@]}"}"; do
        [[ "$_pt" == "--yes" ]] && continue
        _rel_pt+=("$_pt")
      done
      if [[ "$_rel_yes" == "1" ]]; then
        _frpctl_pt=("--yes")
        if ((${#_rel_pt[@]} > 0)); then
          _frpctl_pt+=("${_rel_pt[@]}")
        fi
        frpctl_with_pt frpctl_invoke frp-release-client "$_rel_client"
      else
        # Interactive TTY: let the backend prompt for RELEASE (no --yes).
        _frpctl_pt=("${_rel_pt[@]+"${_rel_pt[@]}"}")
        frpctl_with_pt frpctl_invoke frp-release-client "$_rel_client"
      fi
      ;;
    release_service)
      frpctl_require_server || return 1
      frpctl_load_passthrough "$result"
      frpctl_with_pt frpctl_invoke frp-release-service "$(frpctl_json_get "$result" client)" "$(frpctl_json_get "$result" service)"
      ;;
    update_default)
      frpctl_load_passthrough "$result"
      frpctl_with_pt frpctl_update
      ;;
    update_project)
      frpctl_load_passthrough "$result"
      _frp_up_rc=0
      if frpctl_is_client && frpctl_is_server; then
        # Dual-role hosts share management files. Fail fast between role
        # updates so a partial client failure cannot continue into a mixed
        # server mutation, then verify shared runtime identity.
        # NOTE: capture status with `cmd || rc=$?` — `if ! cmd; then rc=$?`
        # loses the failure code under bash.
        frpctl_with_pt frpctl_client_update || _frp_up_rc=$?
        if [[ "${_frp_up_rc}" -ne 0 ]]; then
          echo "ERROR: client role product update failed; server role update was not started." >&2
          echo "DUAL_ROLE_PRODUCT_UPDATE=FAIL_FAST" >&2
        else
          frpctl_with_pt frpctl_run frp-project-update || _frp_up_rc=$?
          if [[ "${_frp_up_rc}" -ne 0 ]]; then
            echo "ERROR: server role product update failed after client role update." >&2
            echo "DUAL_ROLE_PRODUCT_UPDATE=SERVER_FAILED_AFTER_CLIENT" >&2
            echo "Shared management files may require recovery; run diagnostics before retrying." >&2
            frpctl_verify_dual_role_shared_runtime || true
          else
            frpctl_verify_dual_role_shared_runtime || _frp_up_rc=$?
          fi
        fi
      elif frpctl_is_client; then
        frpctl_with_pt frpctl_client_update || _frp_up_rc=$?
      elif frpctl_is_server; then
        frpctl_with_pt frpctl_run frp-project-update || _frp_up_rc=$?
      else
        false
        _frp_up_rc=$?
      fi
      if ! frpctl_is_client && ! frpctl_is_server; then
        false
      else
        [[ "${_frp_up_rc}" -eq 0 ]]
      fi
      ;;
    update_frp)
      if ! frpctl_is_server && ! frpctl_is_client; then
        frpctl_require_install || return 1
      fi
      frpctl_load_passthrough "$result"
      frpctl_with_pt frpctl_run frp-update
      ;;
    restore_backup)
      frpctl_require_server || return 1
      frpctl_load_passthrough "$result"
      _restore_path="$(frpctl_json_get "$result" path)"
      _restore_rc=0
      # Capture with `cmd || rc=$?` — plain `rc=$?` after a failing call is
      # lost under `set -e`, and a non-zero `return` here is swallowed by the
      # canonical dispatcher which only exports `_FRP_CTL_RC`.
      frpctl_confirm_restore "$_restore_path" || _restore_rc=$?
      if [[ "$_restore_rc" -eq 3 ]]; then
        return 0
      fi
      if [[ "$_restore_rc" -ne 0 ]]; then
        _FRP_CTL_RC="$_restore_rc"
        return 0
      fi
      frpctl_run frp-restore "$_restore_path"
      ;;
    doctor)
      if ! type frp_doctor_main >/dev/null 2>&1; then
        echo "ERROR: doctor diagnostics are not installed on this host." >&2
        return 2
      fi
      frpctl_load_passthrough "$result"
      frpctl_with_pt frp_doctor_main
      ;;
    support_bundle)
      frpctl_load_passthrough "$result"
      frpctl_with_pt frpctl_run frp-support-bundle
      ;;
    access_cmd)
      frpctl_require_server || return 1
      frpctl_load_passthrough "$result"
      _acl_confirm="$(frpctl_json_get "$result" confirm_expired)"
      if [[ "$_acl_confirm" == "True" || "$_acl_confirm" == "true" ]]; then
        _acl_rule="$(python3 -c 'import json,sys; pt=json.loads(sys.argv[1]).get("passthrough") or []; print(pt[1] if len(pt)>1 else "")' "$result")"
        _acl_yes=0
        for _acl_tok in "${_frpctl_pt[@]+"${_frpctl_pt[@]}"}"; do
          if [[ "$_acl_tok" == "--yes" ]]; then
            _acl_yes=1
            break
          fi
        done
        if [[ "$_acl_yes" -ne 1 ]]; then
          if [[ ! -t 0 && -z "${FRP_CTL_TEST_INPUT:-}" ]]; then
            echo "ERROR: removing expired ACL sources requires --yes for automation." >&2
            _FRP_CTL_RC=1
            return 0
          fi
          echo
          echo "Remove expired sources from Access Rule \"${_acl_rule}\"?"
          _acl_ans="$(frpctl_read "Continue? [y/N]: " "N")" || return 1
          case "$(printf '%s' "$_acl_ans" | tr '[:upper:]' '[:lower:]')" in
            y|yes) ;;
            *) echo "Cancelled."; return 0 ;;
          esac
        fi
        frpctl_invoke frp-access remove-expired "$_acl_rule" --yes
      else
        frpctl_with_pt frpctl_invoke frp-access
      fi
      ;;
    egress_cmd)
      frpctl_require_server || return 1
      frpctl_load_passthrough "$result"
      frpctl_with_pt frpctl_invoke frp-egress
      ;;
    help)
      frpctl_load_passthrough "$result"
      # Always render from the command catalog so shell and REPL help stay aligned.
      if ! frpctl_with_pt frpctl_repl_help; then
        frpctl_usage
      fi
      ;;
    menu) frpctl_interactive ;;
    history) frpctl_print_history ;;
    clear) frpctl_clear_screen ;;
    exit)
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        _FRP_CTL_SHOULD_EXIT=1
      fi
      return 0
      ;;
    *)
      set -e
      return 1
      ;;
  esac
  _FRP_CTL_RC=$?
  set -e
  return 0
}


frpctl_find_uninstaller() {
  local kind="$1" cand
  local cands=()
  if [[ "$kind" == "server" ]]; then
    cands+=(
      "$(frpctl_path /usr/local/lib/drlink/uninstall-server.sh)"
      "${_FRPCTL_DIR}/../uninstall-server.sh"
      "${_FRPCTL_DIR}/uninstall-server.sh"
    )
  else
    cands+=(
      "$(frpctl_path /usr/local/lib/drlink/uninstall-client.sh)"
      "${_FRPCTL_DIR}/../uninstall-client.sh"
      "${_FRPCTL_DIR}/uninstall-client.sh"
    )
  fi
  for cand in "${cands[@]}"; do
    if [[ -f "$cand" ]]; then
      printf '%s' "$cand"
      return 0
    fi
  done
  return 1
}

frpctl_run_uninstaller() {
  local script="$1"
  shift
  local root="${FRP_CTL_TEST_ROOT:-${FRP_CLIENT_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-${FRP_UPDATE_ROOT:-${FRP_UNINSTALL_TEST_ROOT:-}}}}}"
  if [[ -n "$root" ]]; then
    FRP_UNINSTALL_TEST_ROOT="$root" FRP_CLIENT_TEST_ROOT="${FRP_CLIENT_TEST_ROOT:-$root}" \
      bash "$script" "$@"
  else
    bash "$script" "$@"
  fi
}

frpctl_client_uninstall_flow() {
  local script ans yes=0 pt
  script="$(frpctl_find_uninstaller client)" || {
    echo "ERROR: client uninstaller is not installed on this host." >&2
    echo "Install or update Data Relay Link, then retry: system uninstall" >&2
    return 1
  }
  for pt in "${_frpctl_pt[@]+"${_frpctl_pt[@]}"}"; do
    [[ "$pt" == "--yes" ]] && yes=1
  done
  echo
  echo "Uninstall Data Relay Link client"
  echo "================================"
  echo
  echo "WHAT WILL BE REMOVED"
  echo
  echo "Local Data Relay Link software"
  echo "Local client identity"
  echo "Local client configuration"
  echo "Local service state"
  echo "Local autostart configuration"
  echo
  echo "WHAT WILL REMAIN ON THE SERVER"
  echo
  echo "Client record"
  echo "Published service reservations"
  echo "Public port reservations"
  echo "Server-side policy state"
  echo
  echo "This uninstall does not contact the server and does not release ports."
  echo
  if [[ "$yes" != "1" ]]; then
    ans="$(frpctl_read "Remove local Data Relay Link client? [y/N]: " "N")" || return 1
    case "$(printf '%s' "$ans" | tr '[:upper:]' '[:lower:]')" in
      y|yes) ;;
      *) echo "Cancelled."; return 0 ;;
    esac
  fi
  frpctl_run_uninstaller "$script"
}

frpctl_server_uninstall_flow() {
  local script choice ans yes=0 pt
  script="$(frpctl_find_uninstaller server)" || {
    echo "ERROR: server uninstaller is not installed on this host." >&2
    echo "Install or update Data Relay Link, then retry: system uninstall" >&2
    return 1
  }
  for pt in "${_frpctl_pt[@]+"${_frpctl_pt[@]}"}"; do
    [[ "$pt" == "--yes" ]] && yes=1
  done
  echo
  echo "Uninstall Data Relay Link"
  echo "========================"
  echo
  echo "1) Remove software"
  echo "   Preserve server configuration and state for reinstall"
  echo
  echo "2) Completely remove Data Relay Link"
  echo "   Remove software and all Data Relay Link server state"
  echo
  echo "3) Back"
  echo
  choice="$(frpctl_read "Select [3]: " "3")" || return 1
  case "$choice" in
    1)
      echo
      echo "WHAT WILL BE REMOVED"
      echo
      echo "Data Relay Link server software"
      echo "Runtime services"
      echo
      echo "WHAT WILL BE PRESERVED"
      echo
      echo "Server configuration"
      echo "CA / PKI state"
      echo "Client registry"
      echo "Enrollment state"
      echo "Service reservations"
      echo "Public port reservations"
      echo "ACLs"
      echo "Internet Access configuration"
      echo
      if [[ "$yes" != "1" ]]; then
        ans="$(frpctl_read "Remove server software and preserve state? [y/N]: " "N")" || return 1
        case "$(printf '%s' "$ans" | tr '[:upper:]' '[:lower:]')" in
          y|yes) ;;
          *) echo "Cancelled."; return 0 ;;
        esac
      fi
      frpctl_run_uninstaller "$script"
      ;;
    2)
      echo
      echo "WHAT WILL BE REMOVED"
      echo
      echo "Data Relay Link server software"
      echo "Server configuration"
      echo "CA / PKI state"
      echo "Client registry"
      echo "Enrollment state"
      echo "Service reservations"
      echo "Public port reservations"
      echo "ACLs"
      echo "Internet Access configuration"
      echo "Other Data Relay Link server-owned state"
      echo
      echo "This cannot be undone."
      echo
      ans="$(frpctl_read "Type PURGE to permanently delete all server state: " "")" || return 1
      if [[ "$ans" != "PURGE" ]]; then
        echo "Cancelled."
        return 0
      fi
      frpctl_run_uninstaller "$script" --purge --yes
      ;;
    *)
      echo "Cancelled."
      return 0
      ;;
  esac
}

frpctl_system_uninstall() {
  local has_client=0 has_server=0 choice
  frpctl_is_client && has_client=1
  frpctl_is_server && has_server=1
  if [[ "$has_client" != "1" && "$has_server" != "1" ]]; then
    echo "ERROR: Data Relay Link is not installed on this host." >&2
    return 1
  fi
  if [[ "$has_client" == "1" && "$has_server" == "1" ]]; then
    echo
    echo "Uninstall Data Relay Link"
    echo "========================"
    echo
    echo "This host has both server and client roles."
    echo
    echo "1) Uninstall client role"
    echo "2) Uninstall server role"
    echo "3) Back"
    echo
    choice="$(frpctl_read "Select [3]: " "3")" || return 1
    case "$choice" in
      1) frpctl_client_uninstall_flow ;;
      2) frpctl_server_uninstall_flow ;;
      *) echo "Cancelled."; return 0 ;;
    esac
    return $?
  fi
  if [[ "$has_server" == "1" ]]; then
    frpctl_server_uninstall_flow
    return $?
  fi
  frpctl_client_uninstall_flow
}

frpctl_guided_service_profile_create() {
