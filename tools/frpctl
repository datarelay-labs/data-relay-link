frpctl_repl_read_line() {
  _FRP_CTL_LINE=""
  frpctl_input_init
  if [[ -n "${FRP_CTL_TEST_INPUT:-}" ]]; then
    local pos lines
    printf '%s' "$FRP_CTL_PROMPT"
    pos="$(cat "${_FRP_CTL_INPUT_POS_FILE}")"
    pos=$((pos + 1))
    lines="$(wc -l < "${_FRP_CTL_INPUT_FILE}")"
    lines="${lines// /}"
    if [[ "$pos" -gt "$lines" ]]; then
      return 1
    fi
    _FRP_CTL_LINE="$(sed -n "${pos}p" "${_FRP_CTL_INPUT_FILE}")"
    printf '%s\n' "$pos" >"${_FRP_CTL_INPUT_POS_FILE}"
    printf '%s\n' "$_FRP_CTL_LINE"
    return 0
  fi
  if [[ ! -t 0 ]]; then
    echo "ERROR: interactive ${FRP_CTL_CMD_NAME} requires a TTY." >&2
    echo "Use: ${FRP_CTL_CMD_NAME} <command>" >&2
    return 1
  fi
  if [[ "${_FRP_CTL_BOUND_TAB:-}" == "1" ]]; then
    if ! IFS= read -e -r -p "$FRP_CTL_PROMPT" _FRP_CTL_LINE; then
      return 1
    fi
  else
    # No readline: Tab is a literal character, not filesystem completion.
    printf '%s' "$FRP_CTL_PROMPT"
    if ! IFS= read -r _FRP_CTL_LINE; then
      return 1
    fi
  fi
  return 0
}

frpctl_repl() {
  local rc
  frpctl_require_install || return 1
  if [[ -z "${FRP_CTL_TEST_INPUT:-}" && ! -t 0 ]]; then
    echo "ERROR: interactive ${FRP_CTL_CMD_NAME} requires a TTY." >&2
    echo "Use: ${FRP_CTL_CMD_NAME} <command>" >&2
    return 1
  fi

  # Session history for ↑/↓ only. Never write a history file.
  unset HISTFILE
  set -o history 2>/dev/null || true
  set +o histexpand 2>/dev/null || true
  _FRP_CTL_SESSION_HIST=()
  FRP_CTL_REPL=1
  _FRP_CTL_SHOULD_EXIT=0
  _FRP_CTL_SIGINT=0
  _FRP_CTL_BOUND_TAB=""
  frpctl_tab_reset
  trap 'frpctl_repl_sigint' INT

  if [[ -z "${FRP_CTL_TEST_INPUT:-}" && -t 0 && "${FRP_CTL_DISABLE_TAB:-}" != "1" ]]; then
    if _FRP_CTL_REPL_PY="$(frpctl_repl_py 2>/dev/null)" && python3 -c 'import readline' 2>/dev/null; then
      _FRP_CTL_BOUND_TAB=1
      frpctl_repl_banner
      FRP_CTL_GRAMMAR_PAYLOAD="$(frpctl_grammar_payload)" \
        FRPCTL_BIN="${BASH_SOURCE[0]}" \
        PYTHONUNBUFFERED=1 \
        python3 -u "$_FRP_CTL_REPL_PY" --frpctl "${BASH_SOURCE[0]}"
      trap - INT
      FRP_CTL_REPL=0
      return 0
    fi
    frpctl_repl_enable_completion
  fi

  frpctl_repl_banner

  while true; do
    _FRP_CTL_SIGINT=0
    _FRP_CTL_LINE=""
    if ! frpctl_repl_read_line; then
      if [[ "${_FRP_CTL_SIGINT}" == "1" ]]; then
        echo
        continue
      fi
      echo
      break
    fi
    if [[ "${_FRP_CTL_SIGINT}" == "1" ]]; then
      echo
      continue
    fi
    if ! frpctl_tokenize "$_FRP_CTL_LINE"; then
      echo "ERROR: could not parse command line." >&2
      continue
    fi
    if [[ ${#_FRP_CTL_TOKENS[@]} -eq 0 ]]; then
      continue
    fi
    frpctl_history_maybe_record "$_FRP_CTL_LINE"
    case "${_FRP_CTL_TOKENS[0]}" in
      '!'*|shell|exec|bash|sh)
        frpctl_reject_shell || true
        continue
        ;;
    esac
    rc=0
    frpctl_dispatch "${_FRP_CTL_TOKENS[@]}" || rc=$?
    if [[ "${_FRP_CTL_SHOULD_EXIT}" == "1" ]]; then
      break
    fi
    if [[ "$rc" -ne 0 && "$rc" -ne 130 ]]; then
      echo
      echo "Command failed with exit code ${rc}."
      echo
    fi
  done

  trap - INT
  frpctl_repl_disable_completion
  frpctl_input_cleanup
  FRP_CTL_REPL=0
  return 0
}

frpctl_main() {
  local cmd="${1:-}"
  case "$cmd" in
    --print-grammar-payload)
      unset FRP_CTL_GRAMMAR_PAYLOAD
      frpctl_grammar_payload
      printf '\n'
      ;;
    '')
      frpctl_repl
      ;;
    *)
      frpctl_dispatch "$@"
      ;;
  esac
}

if [[ "${FRP_CTL_SOURCED:-}" != "1" ]]; then
  frpctl_main "$@"
fi
