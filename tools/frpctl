frpctl_dispatch_canonical() {
  local extra result status action extra_args=""
  _FRP_CTL_RC=0
  extra="$(python3 -c 'import json,sys; print(json.dumps({"tokens":sys.argv[1:]}))' "$@")"
  result="$(frpctl_grammar_call match "$extra")" || return 1
  status="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("status",""))' "$result")"
  case "$status" in
    empty|legacy|unknown)
      return 1
      ;;
    shell)
      frpctl_reject_shell
      _FRP_CTL_RC=$?
      return 0
      ;;
    role)
      echo "ERROR: that command is not available on this host role." >&2
      _FRP_CTL_RC=1
      return 0
      ;;
    incomplete)
      frpctl_print_grammar_help "$(frpctl_json_get "$result" message)"
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        return 0
      fi
      _FRP_CTL_RC=2
      return
      ;;
    error)
      echo "ERROR: $(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("message",""))' "$result")" >&2
      _FRP_CTL_RC=1
      return 0
      ;;
    ok)
      ;;
    *)
      return 1
      ;;
  esac
  action="$(frpctl_json_get "$result" action)"
  _FRP_CTL_CANON="$result"
  set +e
  case "$action" in
    show_status)
      frpctl_load_passthrough "$result"
      frpctl_status "${_frpctl_pt[@]}"
      ;;
    show_server_status)
      frpctl_require_server || return 1
      frpctl_load_passthrough "$result"
      frpctl_run frp-server-status "${_frpctl_pt[@]}"
      ;;
    show_version) echo; frpctl_print_version; echo ;;
    show_clients)
      frpctl_require_server || return 1
      frpctl_load_passthrough "$result"
      frpctl_invoke frp-clients "${_frpctl_pt[@]}"
      ;;
    show_groups) frpctl_require_server || return 1; frpctl_invoke frp-groups ;;
    show_group)
      frpctl_require_server || return 1
      frpctl_invoke frp-groups "$(frpctl_json_get "$result" group)"
      ;;
    show_profiles) frpctl_require_server || return 1; frpctl_invoke frp-profile list ;;
    show_profile)
      frpctl_require_server || return 1
      frpctl_invoke frp-profile show "$(frpctl_json_get "$result" profile)"
      ;;
    show_egress_profiles) frpctl_require_server || return 1; frpctl_invoke frp-egress list ;;
    show_egress_profile)
      frpctl_require_server || return 1
      frpctl_invoke frp-egress show "$(frpctl_json_get "$result" profile)"
      ;;
    show_client)
      frpctl_require_server || return 1
      view="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("view") or "overview")' "$result")"
      frpctl_invoke frp-client-info "$(frpctl_json_get "$result" client)" "$view"
      ;;
    context_help)
      echo
