frpctl_zt_prompt_service_fields() {
  # Sets _FRP_ZT_SVC_JSON for one service.
  # Args: preset default_name default_host default_port used_ids_json
  local preset="$1" default_name="$2" default_host="$3" default_port="$4" used_json="${5:-[]}"
  local sid host port user name
  local explained="${_FRP_ZT_TARGET_HELP_SHOWN:-0}"

  if [[ "$explained" != "1" ]]; then
    frpctl_zt_print_target_host_help
    _FRP_ZT_TARGET_HELP_SHOWN=1
  fi

  host="$(frpctl_read "Target host [${default_host}]: " "$default_host")" || return 1
  host="${host#"${host%%[![:space:]]*}"}"
  host="${host%"${host##*[![:space:]]}"}"
  if [[ -z "$host" ]]; then
    echo "ERROR: Target host is required." >&2
    return 1
  fi
  if [[ -n "$default_port" ]]; then
    port="$(frpctl_read "Target port [${default_port}]: " "$default_port")" || return 1
  else
    port="$(frpctl_read "Target port: " "")" || return 1
  fi
  port="${port#"${port%%[![:space:]]*}"}"
  port="${port%"${port##*[![:space:]]}"}"
  if [[ ! "$port" =~ ^[0-9]+$ ]] || ((port < 1 || port > 65535)); then
    echo "ERROR: invalid target port; must be an integer 1-65535" >&2
    return 1
  fi
  name="$default_name"
  if [[ "$preset" == "custom" ]]; then
    name="$(frpctl_read "Display name [TCP ${port}]: " "TCP ${port}")" || return 1
    name="${name#"${name%%[![:space:]]*}"}"
    name="${name%"${name##*[![:space:]]}"}"
    [[ -n "$name" ]] || name="TCP ${port}"
  fi
  if [[ "$preset" == "ssh" ]]; then
    while true; do
      user="$(frpctl_read "SSH user: " "")" || return 1
      user="${user#"${user%%[![:space:]]*}"}"
      user="${user%"${user##*[![:space:]]}"}"
      if [[ -n "$user" ]]; then
        break
      fi
      echo "ERROR: SSH user is required." >&2
    done
  fi
  sid="$(frpctl_zt_suggest_service_id "$preset" "$port" "$used_json")" || return 1
  echo "Service ID : ${sid} (automatic)"
  if [[ "$preset" == "ssh" ]]; then
    _FRP_ZT_SVC_JSON="$(frpctl_zt_service_payload "$preset" "$sid" "$name" "$host" "$port" "$user")" || return 1
  else
    _FRP_ZT_SVC_JSON="$(frpctl_zt_service_payload "$preset" "$sid" "$name" "$host" "$port")" || return 1
  fi
  _FRP_ZT_LAST_SID="$sid"
  return 0
}

frpctl_zt_used_ids_json() {
  # Build used ID list from collected service JSON payloads.
  python3 - "$@" <<'PY'
import json, sys
used = []
for raw in sys.argv[1:]:
    try:
        item = json.loads(raw)
    except Exception:
        continue
    sid = str(item.get("id") or "").strip().lower()
    if sid:
        used.append(sid)
print(json.dumps(used))
PY
}

frpctl_zt_write_services_file() {
  # argv[1]=path, remaining=JSON object strings
  python3 - "$@" <<'PY'
import json, sys
path = sys.argv[1]
items = []
for raw in sys.argv[2:]:
    items.append(json.loads(raw))
with open(path, "w", encoding="utf-8") as fh:
    json.dump(items, fh)
    fh.write("\n")
PY
}

frpctl_zt_run_services() {
  local choice services_file="" rc=0 used_json="[]"
  local -a svc_jsons=()
  _FRP_ZT_CLIENT_NAME=""
  _FRP_ZT_NOTE=""
  _FRP_ZT_SVC_JSON=""
  _FRP_ZT_PLATFORM="${_FRP_ZT_PLATFORM:-linux}"
  _FRP_ZT_TARGET_HELP_SHOWN=0

  frpctl_zt_prompt_client_identification || return 1

  while true; do
    echo
    echo "Configure services"
    echo "=================="
    echo
    echo "1) Add SSH"
    echo "2) Add HTTP"
    echo "3) Add HTTPS"
    echo "4) Add Custom TCP"
    echo "5) Finish"
    echo "6) Cancel"
    echo
    choice="$(frpctl_read "Select: " "")" || return 1
    used_json="[]"
    if [[ ${#svc_jsons[@]} -gt 0 ]]; then
      used_json="$(frpctl_zt_used_ids_json "${svc_jsons[@]}")"
    fi
    case "$choice" in
      1)
        frpctl_zt_prompt_service_fields ssh SSH 127.0.0.1 22 "$used_json" || continue
        svc_jsons+=("$_FRP_ZT_SVC_JSON")
        echo "Added SSH service '${_FRP_ZT_LAST_SID}'."
        ;;
      2)
        frpctl_zt_prompt_service_fields http HTTP 127.0.0.1 80 "$used_json" || continue
        svc_jsons+=("$_FRP_ZT_SVC_JSON")
        echo "Added HTTP service '${_FRP_ZT_LAST_SID}'."
        ;;
      3)
        frpctl_zt_prompt_service_fields https HTTPS 127.0.0.1 443 "$used_json" || continue
        svc_jsons+=("$_FRP_ZT_SVC_JSON")
        echo "Added HTTPS service '${_FRP_ZT_LAST_SID}'."
        ;;
      4)
        frpctl_zt_prompt_service_fields custom "Custom TCP" 127.0.0.1 "" "$used_json" || continue
        svc_jsons+=("$_FRP_ZT_SVC_JSON")
        echo "Added Custom TCP service '${_FRP_ZT_LAST_SID}'."
        ;;
      5)
        if [[ ${#svc_jsons[@]} -eq 0 ]]; then
          echo "ERROR: add at least one service, or choose Cancel." >&2
          continue
        fi
        break
        ;;
      6|"")
        echo "Cancelled."
        return 0
        ;;
      *)
        echo "ERROR: select 1-6" >&2
        ;;
    esac
  done

  services_file="$(mktemp)" || return 1
  chmod 600 "$services_file" || {
    rm -f "$services_file"
    return 1
  }
  if ! frpctl_zt_write_services_file "$services_file" "${svc_jsons[@]}"; then
    rm -f "$services_file"
    return 1
  fi
  if [[ "${FRP_CTL_DRY_RUN:-}" == "1" ]]; then
    printf 'SERVICES_JSON '
    tr -d '\n' <"$services_file"
    printf '\n'
  fi
  frpctl_zt_invoke_create_client --one-line --services-file "$services_file"
  rc=$?
  rm -f "$services_file"
  return "$rc"
}

