# Prefer numbered inventory selection; still allow typing a selector.
# kind: clients | groups | acls | service-profiles | egress-profiles | fixed-tcp | local-services
frpctl_select_inventory() {
  local kind="$1"
  local prompt="${2:-Select: }"
  local payload key choice
  case "$kind" in
    clients) key="names" ;;
    groups) key="groups" ;;
    acls) key="access_lists" ;;
    service-profiles) key="service_profiles" ;;
    egress-profiles) key="egress" ;;
    local-services) key="local_services" ;;
    fixed-tcp) key="fixed_tcp" ;;
    *) key="" ;;
  esac
  payload="$(frpctl_grammar_payload 2>/dev/null || true)"
  # Bash 3.2 (macOS /bin/bash): avoid mapfile/readarray.
  _frpctl_inv_items=()
  while IFS= read -r _frpctl_inv_line || [[ -n "${_frpctl_inv_line:-}" ]]; do
    [[ -n "${_frpctl_inv_line}" ]] || continue
    _frpctl_inv_items+=("$_frpctl_inv_line")
  done < <(python3 - "$payload" "$key" "$kind" <<'PY'
import json, sys
payload = sys.argv[1] or '{}'
key = sys.argv[2]
kind = sys.argv[3]
try:
    data = json.loads(payload) if payload else {}
except Exception:
    data = {}
items = []
if key and key != 'fixed_tcp':
    raw = data.get(key) or []
    if key == 'names':
        meta = {str(c.get('id')): c for c in (data.get('clients') or []) if isinstance(c, dict)}
        for mid in raw:
            mid = str(mid)
            info = meta.get(mid) or {}
            label = str(info.get('label') or info.get('hostname') or '').strip()
            items.append(label or mid)
    else:
        items = [str(x) for x in raw if str(x).strip()]
elif kind == 'fixed_tcp':
    import os
    from pathlib import Path
    root = os.environ.get('FRP_CTL_TEST_ROOT') or os.environ.get('FRP_DEPLOY_TEST_ROOT') or ''
    cfg_path = Path(root + '/etc/drlink/config.json') if root else Path('/etc/drlink/config.json')
    cfg = {}
    if cfg_path.is_file():
        cfg = json.loads(cfg_path.read_text(encoding='utf-8'))
    raw_path = str(cfg.get('egress_control_file') or '/var/lib/drlink/egress-control.json')
    path = Path(raw_path)
    if root and not str(path).startswith(root):
        path = Path(root + str(path))
    if path.is_file():
        state = json.loads(path.read_text(encoding='utf-8'))
        for rid, relay in sorted((state.get('tcp_relays') or {}).items(), key=lambda kv: str((kv[1] or {}).get('name') or kv[0])):
            if isinstance(relay, dict):
                items.append(str(relay.get('name') or rid))
            else:
                items.append(str(rid))
seen = set()
out = []
for item in items:
    if item in seen:
        continue
    seen.add(item)
    out.append(item)
for item in out:
    print(item)
PY
)
  if ((${#_frpctl_inv_items[@]} > 0)); then
    local i=1
    for item in "${_frpctl_inv_items[@]}"; do
      echo "$i) $item"
      i=$((i + 1))
    done
    echo "Or type a selector."
  fi
  choice="$(frpctl_read "$prompt" "")" || return 1
  choice="${choice#"${choice%%[![:space:]]*}"}"
  choice="${choice%"${choice##*[![:space:]]}"}"
  [[ -n "$choice" ]] || return 1
  if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#_frpctl_inv_items[@]} )); then
    printf '%s' "${_frpctl_inv_items[$((choice - 1))]}"
    return 0
  fi
  printf '%s' "$choice"
}

