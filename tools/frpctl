frpctl_zt_service_payload() {
  # args: preset id name host port [ssh_user]
  python3 - "$@" <<'PY'
import json, sys
preset = sys.argv[1]
sid = sys.argv[2]
name = sys.argv[3]
host = sys.argv[4]
port = int(sys.argv[5])
payload = {
    "id": sid,
    "name": name,
    "protocol": "tcp",
    "local_ip": host,
    "local_port": port,
    "preset": preset,
    "enabled": True,
}
if preset == "ssh":
    if len(sys.argv) <= 6 or not str(sys.argv[6]).strip():
        raise SystemExit("ERROR: ssh_user is required for ssh services")
    payload["ssh_user"] = str(sys.argv[6]).strip()
print(json.dumps(payload))
PY
}

