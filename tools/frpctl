frpctl_client_list_services_numbered() {
  # Prints numbered local services; sets _FRP_CTL_SVC_IDS array.
  _FRP_CTL_SVC_IDS=()
  python3 - "$(frpctl_path /etc/frp/client-state.json)" \
    "$(frpctl_path /var/lib/frp-auto-deploy/client-draft.json)" <<'PY'
import json, sys
from pathlib import Path

def load(path):
    p = Path(path)
    if not p.is_file():
        return {}
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        return {}
    raw = data.get("services") or {}
    return raw if isinstance(raw, dict) else {}

committed = load(sys.argv[1])
draft = load(sys.argv[2])
svc = dict(committed)
svc.update(draft)
if not svc:
    print("(no services configured)")
    raise SystemExit(0)
print("ID           NAME           TARGET")
print("--           ----           ------")
for idx, sid in enumerate(sorted(svc), start=1):
    item = svc[sid] if isinstance(svc[sid], dict) else {}
    name = item.get("name") or sid
    host = item.get("local_ip") or "-"
    port = item.get("local_port")
    target = "%s:%s" % (host, port) if port is not None else str(host)
    print("%d) %-12s %-14s %s" % (idx, sid, name, target))
    print("ID\t%s" % sid)
PY
}

frpctl_client_pick_service() {
  local prompt="${1:-Select service: }"
  local out choice
  out="$(frpctl_client_list_services_numbered)" || return 1
  # Strip ID lines from display, collect IDs.
  _FRP_CTL_SVC_IDS=()
  while IFS= read -r line; do
    if [[ "$line" == ID$'\t'* ]]; then
      _FRP_CTL_SVC_IDS+=("${line#ID	}")
    else
      printf '%s\n' "$line"
    fi
  done <<<"$out"
  echo
  if [[ ${#_FRP_CTL_SVC_IDS[@]} -eq 0 ]]; then
    echo "No services available."
    return 1
  fi
  choice="$(frpctl_read "$prompt" "")" || return 1
  if [[ ! "$choice" =~ ^[0-9]+$ ]] || ((choice < 1 || choice > ${#_FRP_CTL_SVC_IDS[@]})); then
    echo "ERROR: select 1-${#_FRP_CTL_SVC_IDS[@]}" >&2
    return 1
  fi
  printf '%s' "${_FRP_CTL_SVC_IDS[$((choice - 1))]}"
}

