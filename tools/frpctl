frpctl_find_uninstall_client() {
  local cand
  for cand in \
    "${FRP_CTL_BIN_DIR:-}/uninstall-client.sh" \
    "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/uninstall-client.sh" \
    /usr/local/lib/frp-auto-deploy/uninstall-client.sh \
    /usr/local/sbin/uninstall-client.sh \
    "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/uninstall-client.sh"; do
    if [[ -n "$cand" && -f "$cand" ]]; then
      printf '%s' "$cand"
      return 0
    fi
  done
  return 1
}

frpctl_client_uninstall() {
  local confirm script yes=0 arg
  frpctl_require_client || return 1
  for arg in "$@"; do
    case "$arg" in
      --yes|-y) yes=1 ;;
    esac
  done
  echo "This removes FRP Auto Deploy from this machine."
  echo
  echo "Local client identity and configuration will be removed."
  echo "Server-side client records and public-port reservations will remain."
  echo
  if [[ "$yes" != "1" ]]; then
    if [[ -n "${FRP_CTL_TEST_INPUT:-}" || -t 0 ]]; then
      confirm="$(frpctl_read "Type UNINSTALL to continue: " "")" || return 1
      if [[ "$confirm" != "UNINSTALL" ]]; then
        echo "Uninstall cancelled."
        return 1
      fi
    else
      echo "ERROR: non-interactive uninstall requires --yes" >&2
      return 1
    fi
  fi
  if [[ "${FRP_CTL_DRY_RUN:-}" == "1" ]]; then
    echo "DISPATCH uninstall-client.sh"
    return 0
  fi
  if ! script="$(frpctl_find_uninstall_client)"; then
    echo "ERROR: uninstall-client.sh not found" >&2
    return 1
  fi
  # shellcheck disable=SC2086
  if ! bash "$script"; then
    return 1
  fi
  echo "FRP Auto Deploy client removed."
  # REPL / interactive session cannot continue on a deleted installation.
  exit 0
}

