frpctl_remove_internet_destination() {
  local spec="$1" profile destination host port protocol
  profile="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("profile",""))' "$spec")"
  destination="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("destination",""))' "$spec")"
  host="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("host",""))' "$spec")"
  port="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("port",""))' "$spec")"
  protocol="$(python3 -c 'import json,sys; print((json.loads(sys.argv[1]).get("protocol") or "").lower())' "$spec")"
  if [[ -n "$host" && -n "$port" ]]; then
    destination="${host}:${port}"
  fi
  if [[ -z "$destination" ]]; then
    echo "ERROR: destination selector is required" >&2
    return 1
  fi
  if [[ -n "$protocol" ]]; then
    frpctl_with_pt frpctl_invoke frp-egress remove-destination \
      "$profile" "$destination" --protocol "$protocol"
  else
    frpctl_with_pt frpctl_invoke frp-egress remove-destination \
      "$profile" "$destination"
  fi
}

frpctl_set_client_from_canon() {
  local spec="$1" client prop value
  client="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("client",""))' "$spec")"
  prop="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("property",""))' "$spec")"
  value="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("value",""))' "$spec")"
  case "$prop" in
    label) frpctl_invoke frp-client-set "$client" --label "$value" ;;
    note) frpctl_invoke frp-client-set "$client" --note "$value" ;;
    tag) frpctl_invoke frp-client-set "$client" --tag "$value" ;;
    *) echo "ERROR: unknown client setting" >&2; return 1 ;;
  esac
}

frpctl_unset_client_from_canon() {
  local spec="$1" client prop value
  client="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("client",""))' "$spec")"
  prop="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("property",""))' "$spec")"
  value="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("value",""))' "$spec")"
  case "$prop" in
    label) frpctl_invoke frp-client-set "$client" --clear-label ;;
    note) frpctl_invoke frp-client-set "$client" --clear-note ;;
    tag) frpctl_invoke frp-client-set "$client" --remove-tag "$value" ;;
    *) echo "ERROR: unknown client setting" >&2; return 1 ;;
  esac
}

frpctl_dispatch() {
  local cmd="${1:-}"
  _FRP_CTL_RC=0
  _FRP_CTL_CANON=""
  if [[ -n "$cmd" ]] && frpctl_dispatch_canonical "$@"; then
    return "${_FRP_CTL_RC:-0}"
  fi
  # Canonical grammar matched an action but the handler failed with return 1.
  # Do not fall through to legacy "unknown command" (double-error).
  if [[ -n "${_FRP_CTL_CANON:-}" ]]; then
    return "${_FRP_CTL_RC:-1}"
  fi
  shift || true
  case "$cmd" in
    -h|--help)
      frpctl_usage
      ;;
    help|'?')
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        frpctl_repl_help "$@"
      else
        if [[ $# -gt 0 ]]; then
          frpctl_repl_help "$@"
        else
          frpctl_usage
        fi
      fi
      ;;
    menu)
      frpctl_interactive
      ;;
    status)
      frpctl_status "$@"
      ;;
    doctor)
      if ! type frp_doctor_main >/dev/null 2>&1; then
        echo "ERROR: doctor diagnostics are not installed on this host." >&2
        return 2
      fi
      frp_doctor_main "$@"
      ;;
    support-bundle)
      frpctl_run frp-support-bundle "$@"
      ;;
    client-status)
      frpctl_require_client || return 1
      frpctl_run frp-client status "$@"
      ;;
    server-status)
      frpctl_require_server || return 1
      frpctl_run frp-server-status "$@"
      ;;
    version)
      echo
      frpctl_print_version
      echo
      ;;
    update)
      frpctl_update "$@"
      ;;
    client-update)
      frpctl_require_client || return 1
      frpctl_client_update "$@"
      ;;
    server-update|frp-update)
      if ! frpctl_is_server && ! frpctl_is_client; then
        frpctl_require_install || return 1
      fi
      frpctl_run frp-update "$@"
      ;;
    project-update)
      frpctl_require_server || return 1
      frpctl_run frp-project-update "$@"
      ;;
    backup)
      frpctl_require_server || return 1
      frpctl_run frp-backup "$@"
      ;;
    restore)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        frpctl_usage_error "restore <backup>"
        return $?
      fi
      frpctl_run frp-restore "$@"
      ;;
    enroll-bulk)
      frpctl_require_server || return 1
      frpctl_invoke frp-enroll-bulk "$@"
      ;;
    enrollments)
      frpctl_require_server || return 1
      frpctl_invoke frp-enrollments "$@"
      ;;
    enrollment-revoke)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        frpctl_usage_error "enrollment-revoke <id>"
        return $?
      fi
      frpctl_invoke frp-enrollment-revoke "$@"
      ;;
    upstream)
      frpctl_require_server || return 1
      frpctl_run frp-upstream "$@"
      ;;
    audit)
      frpctl_require_server || return 1
      frpctl_audit_tail
      ;;
    clear)
      frpctl_clear_screen
      ;;
    exit|quit|q)
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        _FRP_CTL_SHOULD_EXIT=1
        return 0
      fi
      return 0
      ;;
    manage)
      frpctl_require_client || return 1
      frpctl_invoke frp-client "$@"
      ;;
    services)
      frpctl_require_client || return 1
      frpctl_invoke frp-client list "$@"
      ;;
    info)
      frpctl_require_client || return 1
      frpctl_invoke frp-client info "$@"
      ;;
    clients)
      frpctl_require_server || return 1
      frpctl_invoke frp-clients "$@"
      ;;
    enroll|create-client)
      frpctl_require_server || return 1
      frpctl_invoke frp-create-client "$@"
      ;;
    client|client-info)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "$cmd" == "client" ]]; then
          frpctl_usage_error "client <name>"
        else
          frpctl_usage_error "${FRP_CTL_CMD_NAME} client-info <client>"
        fi
        return $?
      fi
      frpctl_invoke frp-client-info "$@"
      ;;
    client-set|edit-client)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
          frpctl_usage_error "client-set <client> [--label NAME] [--note TEXT]"
        else
          frpctl_usage_error "${FRP_CTL_CMD_NAME} client-set <client> [--label NAME] [--note TEXT]"
        fi
        return $?
      fi
      frpctl_invoke frp-client-set "$@"
      ;;
    revoke|revoke-client)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "$cmd" == "revoke" ]]; then
          frpctl_usage_error "revoke <name>"
        else
          frpctl_usage_error "${FRP_CTL_CMD_NAME} revoke-client <client>"
        fi
        return $?
      fi
      frpctl_invoke frp-revoke-client "$@"
      ;;
    release-service)
      frpctl_require_server || return 1
      if [[ $# -lt 2 ]]; then
        if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
          frpctl_usage_error "release-service <client> <service-id>"
        else
          frpctl_usage_error "${FRP_CTL_CMD_NAME} release-service <client> <service-id>"
        fi
        return $?
      fi
      frpctl_invoke frp-release-service "$@"
      ;;
    release-client)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
          frpctl_usage_error "release-client <client>"
        else
          frpctl_usage_error "${FRP_CTL_CMD_NAME} release-client <client>"
        fi
        return $?
      fi
      frpctl_invoke frp-release-client "$@"
      ;;
    shell|exec|bash|sh)
      frpctl_reject_shell
      ;;
    '!'*|\!*)
      frpctl_reject_shell
      ;;
    '')
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        return 0
      fi
      frpctl_repl
      ;;
    *)
      frpctl_unknown_command "$cmd"
      ;;
  esac
}

frpctl_tokenize() {
  local line="$1" py json
  _FRP_CTL_TOKENS=()
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -n "$line" ]] || return 0
  py="$(frpctl_grammar_py)" || return 1
  json="$(python3 "$py" tokenize "$line")" || return 2
  _FRP_CTL_TOKENS=()
  while IFS= read -r _tok; do
    [[ -n "$_tok" ]] && _FRP_CTL_TOKENS+=("$_tok")
  done < <(python3 -c 'import json,sys; [print(t) for t in json.loads(sys.argv[1])]' "$json")
}

frpctl_history_maybe_record() {
  local line="$1"
  [[ -n "$line" ]] || return 0
  if python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import frp_ctl_grammar as g; raise SystemExit(0 if g.looks_secret(sys.argv[2]) else 1)' \
    "$(dirname "$(frpctl_grammar_py)")" "$line"; then
    return 0
  fi
  _FRP_CTL_SESSION_HIST+=("$line")
  history -s "$line" 2>/dev/null || true
}

frpctl_print_history() {
  local i
  if [[ ${#_FRP_CTL_SESSION_HIST[@]} -eq 0 ]]; then
    echo "(no session history)"
    return 0
  fi
  for i in "${!_FRP_CTL_SESSION_HIST[@]}"; do
    printf '%5s  %s\n' "$((i + 1))" "${_FRP_CTL_SESSION_HIST[$i]}"
  done
}

frpctl_repl_sigint() {
  _FRP_CTL_SIGINT=1
}

frpctl_repl_banner() {
  echo "${FRP_CTL_PRODUCT_NAME}"
  echo "================="
  echo
  echo "Role            : $(frpctl_role_label)"
  echo "Project version : $(frpctl_project_version)"
  echo "Release channel : $(frpctl_release_channel)"
  echo "Source ref      : $(frpctl_source_ref)"
  echo "FRP version     : $(frpctl_frp_version)"
  echo "Bundle SHA256   : $(frpctl_bundle_sha256)"
  echo
  echo "Type '?' for a short command list, or 'help' for full syntax."
