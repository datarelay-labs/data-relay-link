# Read-only preflight for system restore. Prints operator summary.
# Exit 0 = ok to confirm/continue, 2 = version mismatch / refuse, 1 = other error.
frpctl_restore_preflight() {
  local archive="$1"
  local root="${FRP_DEPLOY_TEST_ROOT:-${FRP_CTL_TEST_ROOT:-}}"
  python3 - "$archive" "$root" <<'PY'
import json, sys, tarfile
from pathlib import Path

archive = Path(sys.argv[1])
root = Path(sys.argv[2] or "/")
if not archive.is_file():
    print("ERROR: backup archive not found: %s" % archive, file=sys.stderr)
    raise SystemExit(1)

try:
    with tarfile.open(archive, "r:gz") as tf:
        try:
            member = tf.getmember("manifest.json")
        except KeyError as exc:
            raise SystemExit("ERROR: backup is missing manifest.json") from exc
        raw = tf.extractfile(member)
        if raw is None:
            raise SystemExit("ERROR: backup manifest is unreadable")
        manifest = json.loads(raw.read().decode("utf-8"))
        clients = None
        reservations = None
        try:
            reg_member = tf.getmember("payload/var/lib/drlink/registry.json")
            reg_fh = tf.extractfile(reg_member)
            if reg_fh is not None:
                reg = json.loads(reg_fh.read().decode("utf-8"))
                if isinstance(reg, dict):
                    clients = len(reg.get("clients") or {})
                    reserved = reg.get("reserved")
                    if isinstance(reserved, list):
                        reservations = len(reserved)
        except Exception:
            pass
except SystemExit:
    raise
except Exception as exc:
    print("ERROR: cannot read backup: %s" % exc, file=sys.stderr)
    raise SystemExit(1)

def read_installed_version():
    version_path = root / "etc/drlink/version"
    if not version_path.is_file():
        return ""
    data = {}
    for line in version_path.read_text(encoding="utf-8").splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            data[k.strip()] = v.strip()
    return data.get("PROJECT_VERSION") or data.get("project_version") or ""

backup_ver = str(manifest.get("project_version") or "").strip()
installed_ver = read_installed_version()
role = str(manifest.get("role") or manifest.get("host_role") or "server")
created = str(manifest.get("created_at") or manifest.get("created") or "-")

print("Restore Data Relay Link")
print("=======================")
print()
print("Backup")
print("  Path        : %s" % archive)
print("  Created     : %s" % created)
print("  Version     : %s" % (backup_ver or "unknown"))
print("  Role        : %s" % role)
if clients is not None:
    print("  Clients     : %s" % clients)
if reservations is not None:
    print("  Reservations: %s" % reservations)
print()
print("Backup version    : %s" % (backup_ver or "unknown"))
print("Installed version : %s" % (installed_ver or "unknown"))
print()
if backup_ver and installed_ver and backup_ver != installed_ver:
    print("Restore cannot continue.")
    print("Cross-version restore is not supported.")
    raise SystemExit(2)
print("Current server state will be replaced.")
print("A pre-restore snapshot will be created automatically.")
print("Services will restart.")
print()
PY
}

frpctl_select_backup_archive() {
  local backup_dir choice path idx=0
  local -a archives=()
  local -a labels=()
  backup_dir="$(frpctl_restore_backup_dir)"
  echo
  echo "Available backups"
  echo
  if [[ -d "$backup_dir" ]]; then
    while IFS= read -r path; do
      [[ -n "$path" ]] || continue
      archives+=("${path%%$'\t'*}")
      labels+=("$path")
    done < <(python3 - "$backup_dir" <<'PY'
import json, sys, tarfile
