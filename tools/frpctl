frpctl_zt_service_payload() {
  # args: preset id name host port [ssh_user]
  python3 - "$@" <<'PY'
import json, sys
preset = sys.argv[1]
sid = sys.argv[2]
name = sys.argv[3]
host = sys.argv[4]
port = int(sys.argv[5])
payload = {
    "id": sid,
    "name": name,
    "protocol": "tcp",
    "local_ip": host,
    "local_port": port,
    "preset": preset,
    "enabled": True,
}
if preset == "ssh":
    if len(sys.argv) <= 6 or not str(sys.argv[6]).strip():
        raise SystemExit("ERROR: ssh_user is required for ssh services")
    payload["ssh_user"] = str(sys.argv[6]).strip()
print(json.dumps(payload))
PY
}

frpctl_zt_prompt_service_fields() {
  # Sets _FRP_ZT_SVC_JSON for one service. Args: preset default_id default_name default_host default_port
  local preset="$1" default_id="$2" default_name="$3" default_host="$4" default_port="$5"
  local sid host port user name
  while true; do
    if [[ -n "$default_id" ]]; then
      sid="$(frpctl_read "Service ID [${default_id}]: " "$default_id")" || return 1
    else
      sid="$(frpctl_read "Service ID: " "")" || return 1
    fi
    if sid="$(frpctl_zt_validate_field service_id "$sid")"; then
      break
    fi
  done
  while true; do
    host="$(frpctl_read "Target host [${default_host}]: " "$default_host")" || return 1
    if host="$(frpctl_zt_validate_field target_host "$host")"; then
      break
    fi
  done
  while true; do
    if [[ -n "$default_port" ]]; then
      port="$(frpctl_read "Target port [${default_port}]: " "$default_port")" || return 1
    else
      port="$(frpctl_read "Target port: " "")" || return 1
    fi
    if port="$(frpctl_zt_validate_field target_port "$port")"; then
      break
    fi
  done
  name="$default_name"
  if [[ "$preset" == "custom" ]]; then
    name="$(frpctl_read "Display name [${sid}]: " "$sid")" || return 1
    name="${name#"${name%%[![:space:]]*}"}"
    name="${name%"${name##*[![:space:]]}"}"
    [[ -n "$name" ]] || name="$sid"
  fi
  if [[ "$preset" == "ssh" ]]; then
    while true; do
      user="$(frpctl_read "SSH user: " "")" || return 1
      if user="$(frpctl_zt_validate_field ssh_user "$user")"; then
        break
      fi
    done
    _FRP_ZT_SVC_JSON="$(frpctl_zt_service_payload "$preset" "$sid" "$name" "$host" "$port" "$user")" || return 1
  else
    _FRP_ZT_SVC_JSON="$(frpctl_zt_service_payload "$preset" "$sid" "$name" "$host" "$port")" || return 1
  fi
  return 0
}

frpctl_zt_write_services_file() {
  # argv[1]=path, remaining=JSON object strings
  python3 - "$@" <<'PY'
import json, sys
path = sys.argv[1]
items = []
for raw in sys.argv[2:]:
    items.append(json.loads(raw))
with open(path, "w", encoding="utf-8") as fh:
    json.dump(items, fh)
    fh.write("\n")
PY
}

frpctl_zt_run_services() {
  local choice services_file="" rc=0
  local -a svc_jsons=()
  _FRP_ZT_SVC_JSON=""
  _FRP_ZT_PLATFORM="${_FRP_ZT_PLATFORM:-linux}"

  if [[ -z "${_FRP_ZT_CLIENT_NAME:-}" ]]; then
    _FRP_ZT_CLIENT_NAME=""
    _FRP_ZT_NOTE=""
    frpctl_zt_prompt_client_identification || return 1
  fi

  while true; do
    echo
    echo "Configure services"
    echo "=================="
    echo
    echo "1) Add SSH"
    echo "2) Add HTTP"
    echo "3) Add HTTPS"
    echo "4) Add Custom TCP"
    echo "5) Finish"
    echo "6) Cancel"
    echo
    choice="$(frpctl_read "Select: " "")" || return 1
    case "$choice" in
      1)
        frpctl_zt_prompt_service_fields ssh ssh SSH 127.0.0.1 22 || continue
        svc_jsons+=("$_FRP_ZT_SVC_JSON")
        echo "Added SSH service."
        ;;
      2)
        frpctl_zt_prompt_service_fields http http HTTP 127.0.0.1 80 || continue
        svc_jsons+=("$_FRP_ZT_SVC_JSON")
        echo "Added HTTP service."
        ;;
      3)
        frpctl_zt_prompt_service_fields https https HTTPS 127.0.0.1 443 || continue
        svc_jsons+=("$_FRP_ZT_SVC_JSON")
        echo "Added HTTPS service."
        ;;
      4)
        frpctl_zt_prompt_service_fields custom "" "Custom TCP" 127.0.0.1 "" || continue
        svc_jsons+=("$_FRP_ZT_SVC_JSON")
        echo "Added Custom TCP service."
        ;;
      5)
        if [[ ${#svc_jsons[@]} -eq 0 ]]; then
          echo "ERROR: add at least one service, or choose Cancel." >&2
          continue
        fi
        break
        ;;
      6|"")
        echo "Cancelled."
        return 0
        ;;
      *)
        echo "ERROR: select 1-6" >&2
        ;;
    esac
  done

  services_file="$(mktemp)" || return 1
  chmod 600 "$services_file" || {
    rm -f "$services_file"
    return 1
  }
  if ! frpctl_zt_write_services_file "$services_file" "${svc_jsons[@]}"; then
    rm -f "$services_file"
    return 1
  fi
  if [[ "${FRP_CTL_DRY_RUN:-}" == "1" ]]; then
    printf 'SERVICES_JSON '
    tr -d '\n' <"$services_file"
    printf '\n'
  fi
  frpctl_zt_invoke_create_client --one-line --services-file "$services_file"
  rc=$?
  rm -f "$services_file"
  return "$rc"
}

