frpctl_manage_clients() {
  local cfg root choice mid libdir
  cfg="$(frpctl_path /etc/drlink/config.json)"
  root="${FRP_CTL_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-}}"
  libdir="${_FRPCTL_DIR}/../lib"
  echo
  echo "${FRP_CTL_PRODUCT_NAME} — Client Management"
  echo "==================================="
  echo
  python3 - "$cfg" "$root" "$libdir" <<'PY'
import importlib.util
import json
import sys
from pathlib import Path
cfg_path = Path(sys.argv[1])
root = sys.argv[2]
libdir = Path(sys.argv[3])
search = []
if root:
    search.append(Path(root) / 'usr/local/lib/drlink/frp_client_registry.py')
search.append(libdir / 'frp_client_registry.py')
search.append(Path('/usr/local/lib/drlink/frp_client_registry.py'))
mod = None
for path in search:
    if path.is_file():
        spec = importlib.util.spec_from_file_location('frp_client_registry', str(path))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        break
if mod is None:
    sys.stderr.write('ERROR: missing frp_client_registry.py\n')
    raise SystemExit(1)
if not cfg_path.is_file():
    print('(no registered clients)')
    raise SystemExit(0)
cfg = json.loads(cfg_path.read_text(encoding='utf-8'))
reg = Path(str(cfg.get('registry_file') or ''))
if root and not str(reg).startswith(root):
    reg = Path(root + str(reg))
state = json.loads(reg.read_text(encoding='utf-8')) if reg.is_file() else {'clients': {}}
clients = mod.sorted_clients(state)
if not clients:
    print('(no registered clients)')
    raise SystemExit(0)
for idx, (mid, client) in enumerate(clients, start=1):
    print('%s. %s' % (idx, mod.sanitize_display(mod.display_name(client, mid))))
    print('   Hostname : %s' % mod.sanitize_display(client.get('hostname') or '-'))
    print('   ID       : %s' % mod.short_machine_id(mid))
    print('   State    : %s' % mod.mgmt_status(client))
    print()
PY
  choice="$(frpctl_read "Select client number: " "")" || return 1
  [[ -n "$choice" ]] || return 0
  mid="$(python3 - "$cfg" "$root" "$libdir" "$choice" <<'PY'
import importlib.util
import json
import sys
from pathlib import Path
cfg_path = Path(sys.argv[1])
root = sys.argv[2]
libdir = Path(sys.argv[3])
choice = sys.argv[4].strip()
search = []
if root:
    search.append(Path(root) / 'usr/local/lib/drlink/frp_client_registry.py')
search.append(libdir / 'frp_client_registry.py')
search.append(Path('/usr/local/lib/drlink/frp_client_registry.py'))
mod = None
for path in search:
    if path.is_file():
        spec = importlib.util.spec_from_file_location('frp_client_registry', str(path))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        break
if mod is None:
    raise SystemExit(1)
cfg = json.loads(cfg_path.read_text(encoding='utf-8'))
reg = Path(str(cfg.get('registry_file') or ''))
if root and not str(reg).startswith(root):
    reg = Path(root + str(reg))
state = json.loads(reg.read_text(encoding='utf-8'))
clients = mod.sorted_clients(state)
if not choice.isdigit():
    raise SystemExit(1)
idx = int(choice)
if idx < 1 or idx > len(clients):
    raise SystemExit(1)
print(clients[idx - 1][0])
PY
)" || {
    echo "ERROR: invalid client number" >&2
    return 1
  }
  [[ -n "$mid" ]] || return 1
  frpctl_manage_one_client "$mid"
}

