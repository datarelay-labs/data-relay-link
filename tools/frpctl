frpctl_server_guided_create_profile() {
  local choice name host port user desc preset
  echo
  echo "Create Service Profile"
  echo "======================"
  echo
  echo "The target is interpreted on the future FRP client."
  echo
  echo "  127.0.0.1       service on that client"
  echo "  LAN IP/hostname another service reachable from that client"
  echo
  echo "1) SSH   (default 127.0.0.1:22)"
  echo "2) HTTP  (default 127.0.0.1:80)"
  echo "3) HTTPS (default 127.0.0.1:443)"
  echo "4) Custom (port required)"
  echo "5) Back"
  echo
  choice="$(frpctl_read "Select preset: " "")" || return 1
  case "$choice" in
    1) preset=ssh; port=22 ;;
    2) preset=http; port=80 ;;
    3) preset=https; port=443 ;;
    4) preset=custom; port="" ;;
    5|"") return 0 ;;
    *) echo "ERROR: select 1-5" >&2; return 1 ;;
  esac
  name="$(frpctl_read "Profile name: " "")" || return 1
  if [[ -z "$name" ]]; then
    echo "ERROR: profile name is required" >&2
    return 1
  fi
  host="$(frpctl_read "Target host [127.0.0.1]: " "127.0.0.1")" || return 1
  if [[ "$preset" == "custom" ]]; then
    port="$(frpctl_read "Target port: " "")" || return 1
    if [[ -z "$port" ]]; then
      echo "ERROR: target port is required for custom profiles" >&2
      return 1
    fi
  else
    port="$(frpctl_read "Target port [${port}]: " "$port")" || return 1
  fi
  user=""
  if [[ "$preset" == "ssh" ]]; then
    user="$(frpctl_read "SSH user (optional): " "")" || return 1
  fi
  desc="$(frpctl_read "Description (optional): " "")" || return 1
  if [[ -n "$user" ]]; then
    frpctl_invoke frp-profile create "$name" --preset "$preset" \
      --target-host "$host" --target-port "$port" --ssh-user "$user" \
      --description "$desc" || true
  else
    frpctl_invoke frp-profile create "$name" --preset "$preset" \
      --target-host "$host" --target-port "$port" \
      --description "$desc" || true
  fi
}

