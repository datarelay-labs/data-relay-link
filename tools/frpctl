    add_egress_destination)
      frpctl_require_server || return 1
      frpctl_load_passthrough "$result"
      local _eg_profile _eg_host _eg_port _eg_proto _eg_confirm
      _eg_profile="$(frpctl_json_get "$result" profile)"
      _eg_host="$(frpctl_json_get "$result" host)"
      _eg_port="$(frpctl_json_get "$result" port)"
      _eg_proto="$(frpctl_json_get "$result" protocol)"
      if [[ -z "$_eg_host" || -z "$_eg_port" ]]; then
        echo
        echo "Add Internet Access Destination"
        echo "==============================="
        echo
        _eg_host="$(frpctl_read "Destination FQDN: " "")" || return 1
        [[ -n "$_eg_host" ]] || { echo "ERROR: destination FQDN is required" >&2; return 1; }
        _eg_port="$(frpctl_read "Port [443]: " "443")" || return 1
        [[ -n "$_eg_port" ]] || _eg_port=443
        echo
        echo "Protocol:"
        echo "  1) HTTPS"
        echo "  2) HTTP"
        echo "  3) TCP"
        echo
        _eg_proto="$(frpctl_read "Select: " "1")" || return 1
        case "$_eg_proto" in
          2) _eg_proto=http ;;
          3) _eg_proto=tcp ;;
          *) _eg_proto=https ;;
        esac
        echo
        _eg_confirm="$(frpctl_read "Add destination? [Y/n]: " "Y")" || return 1
        case "$(printf '%s' "$_eg_confirm" | tr '[:upper:]' '[:lower:]')" in
          n|no) echo "Cancelled."; return 0 ;;
        esac
        frpctl_invoke frp-egress add-destination \
          "$_eg_profile" "$_eg_host" "$_eg_port" --protocol "$_eg_proto"
      else
        if [[ -z "$_eg_proto" ]]; then
          echo "ERROR: PROTOCOL is required (http, https, or tcp)." >&2
          return 2
        fi
        frpctl_with_pt frpctl_invoke frp-egress add-destination \
          "$_eg_profile" \
          "$_eg_host" \
          "$_eg_port" \
          --protocol \
          "$_eg_proto"
      fi
