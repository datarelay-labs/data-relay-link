frpctl_confirm_restore() {
  local archive="$1"
  local ans="" yes=0 pt
  frpctl_restore_preflight "$archive"
  local rc=$?
  if [[ "$rc" -eq 2 ]]; then
    return 2
  fi
  if [[ "$rc" -ne 0 ]]; then
    return 1
  fi
  for pt in "${_frpctl_pt[@]+"${_frpctl_pt[@]}"}"; do
    [[ "$pt" == "--yes" ]] && yes=1
  done
  # Hidden automation escape for fixtures/non-interactive callers.
  if [[ "${FRP_RESTORE_YES:-}" == "1" ]]; then
    yes=1
  fi
  if [[ "$yes" == "1" ]]; then
    return 0
  fi
  if [[ -n "${FRP_CTL_TEST_INPUT:-}" || -t 0 ]]; then
    ans="$(frpctl_read "Continue with restore? [y/N]: " "N")" || return 1
  elif IFS= read -r ans; then
    :
  else
    echo "ERROR: restore requires confirmation." >&2
    echo "Run interactively, or pass --yes for automation:" >&2
    echo "  system restore ${archive} --yes" >&2
    return 1
  fi
  case "$(printf '%s' "$ans" | tr '[:upper:]' '[:lower:]')" in
    y|yes) return 0 ;;
    *)
      echo "Cancelled."
      return 3
      ;;
  esac
}

frpctl_verify_dual_role_shared_runtime() {
  # After a dual-role product update, shared management files must belong to
  # one coherent installed build identity.
  local root="${FRP_DEPLOY_TEST_ROOT:-${FRP_CTL_TEST_ROOT:-}}"
  python3 - "$root" <<'PY'
import hashlib, sys
from pathlib import Path

root = Path(sys.argv[1] or "/")
version = root / "etc/drlink/version"
if not version.is_file():
    print("ERROR: dual-role shared runtime check failed: missing /etc/drlink/version", file=sys.stderr)
    raise SystemExit(1)
data = {}
for line in version.read_text(encoding="utf-8").splitlines():
    if "=" in line:
        k, v = line.split("=", 1)
        data[k.strip()] = v.strip()
source_ref = data.get("SOURCE_REF") or data.get("source_ref") or ""
bundle = data.get("BUNDLE_SHA256") or data.get("bundle_sha256") or ""
shared = [
    "usr/local/lib/drlink/frpctl",
    "usr/local/lib/drlink/frp_cli_final_commands.json",
    "usr/local/lib/drlink/frp_cli_catalog.py",
    "usr/local/bin/drlink",
]
missing = []
digests = []
for rel in shared:
    path = root / rel
    if not path.is_file():
        missing.append(rel)
        continue
    digests.append(hashlib.sha256(path.read_bytes()).hexdigest())
if missing:
    print("ERROR: dual-role shared runtime incomplete: %s" % ", ".join(missing), file=sys.stderr)
    raise SystemExit(1)
if len(set(digests)) != len(digests) and False:
    # Placeholder: individual file digests naturally differ; coherence is the
    # single version identity below plus presence of the shared set.
    pass
if not (source_ref or bundle or data.get("PROJECT_VERSION")):
    print("ERROR: dual-role shared runtime identity is empty", file=sys.stderr)
    raise SystemExit(1)
print(
    "DUAL_ROLE_SHARED_RUNTIME=COHERENT source_ref=%s bundle=%s project=%s"
    % (source_ref or "-", (bundle[:12] + "…") if bundle else "-", data.get("PROJECT_VERSION") or "-")
)
PY
}


frpctl_audit_tail() {
  # Default: human-readable recent events. Optional lightweight filters:
  # last <N> | client <CLIENT> | event <EVENT>
  # Raw JSONL remains on disk; --json is an advanced escape hatch only.
  local root="${FRP_DEPLOY_TEST_ROOT:-${FRP_CTL_TEST_ROOT:-}}"
  python3 - "$root" "$@" <<'PY'
import json, sys
from pathlib import Path

root = sys.argv[1]
args = sys.argv[2:]
path = Path("/var/log/drlink/audit.jsonl")
if root:
    path = Path(root + "/var/log/drlink/audit.jsonl")
if not path.is_file():
    print("(no audit log)")
    raise SystemExit(0)

want_json = False
limit = 50
client_filter = None
event_filter = None
i = 0
while i < len(args):
    tok = args[i]
    if tok in ("--json", "json"):
        want_json = True
        i += 1
        continue
    if tok == "last" and i + 1 < len(args):
        try:
            limit = max(1, min(500, int(args[i + 1])))
        except ValueError:
            print("ERROR: system audit last <N> requires a positive integer.", file=sys.stderr)
            raise SystemExit(2)
        i += 2
        continue
    if tok == "client" and i + 1 < len(args):
        client_filter = str(args[i + 1]).strip().lower()
        i += 2
        continue
    if tok == "event" and i + 1 < len(args):
        event_filter = str(args[i + 1]).strip().lower()
        i += 2
        continue
    print("ERROR: unsupported audit filter %r." % tok, file=sys.stderr)
    print(
        "Use: system audit | system audit last <N> | "
        "system audit client <CLIENT> | system audit event <EVENT>",
        file=sys.stderr,
    )
    raise SystemExit(2)

raw_lines = path.read_text(encoding="utf-8").splitlines()
records = []
for line in raw_lines:
    line = line.strip()
    if not line:
        continue
    try:
        rec = json.loads(line)
    except Exception:
        continue
    if isinstance(rec, dict):
        records.append(rec)

def _hay(rec):
    details = rec.get("details") if isinstance(rec.get("details"), dict) else {}
    bits = [
        str(rec.get("event") or ""),
        str(rec.get("target") or ""),
        str(rec.get("client") or ""),
        str(rec.get("client_id") or ""),
        str(rec.get("hostname") or ""),
        json.dumps(details, sort_keys=True),
    ]
    return " ".join(bits).lower()

filtered = []
for rec in records:
    if event_filter and event_filter not in str(rec.get("event") or "").lower():
        continue
    if client_filter and client_filter not in _hay(rec):
        continue
    filtered.append(rec)
filtered = filtered[-limit:]

if want_json:
    print("\n".join(json.dumps(rec, sort_keys=True) for rec in filtered) if filtered else "(no audit log)")
    raise SystemExit(0)

def _time(rec):
    raw = str(rec.get("ts") or rec.get("time") or rec.get("timestamp") or "")
    if not raw:
        return "-"
    text = raw.replace("T", " ").replace("Z", "")
    return text[:16] if len(text) >= 16 else text

def _target(rec):
    details = rec.get("details") if isinstance(rec.get("details"), dict) else {}
    for key in (
        "target", "client", "client_id", "hostname", "path", "name", "id",
        "group_name", "profile_name", "list_name", "relay_name", "service_id",
    ):
        val = rec.get(key) or details.get(key)
        if val:
            text = str(val)
            if key == "path" and "/" in text:
                text = text.rsplit("/", 1)[-1]
            return text
    return "-"

def _result(rec):
    details = rec.get("details") if isinstance(rec.get("details"), dict) else {}
    for key in ("result", "status", "outcome"):
        val = rec.get(key) or details.get(key)
        if val:
            return str(val)
    if rec.get("error"):
        return "error"
    return "success"

if not filtered:
    print("(no matching audit events)")
    raise SystemExit(0)

print("%-19s %-24s %-16s %s" % ("TIME", "EVENT", "TARGET", "RESULT"))
for rec in filtered:
    print(
        "%-19s %-24s %-16s %s"
        % (
            _time(rec)[:19],
            str(rec.get("event") or "-")[:24],
            _target(rec)[:16],
            _result(rec)[:24],
        )
    )
PY
}

