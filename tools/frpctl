#!/usr/bin/env bash
# Unified operator entry point for frp-auto-deploy.
# Thin dispatcher over existing commands. Does not reimplement registry or
# client-state mutations.
set -euo pipefail

_FRPCTL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_FRP_CTL_SESSION_HIST=()
_FRP_CTL_RC=0
if [[ -f "${_FRPCTL_DIR}/../lib/frp-doctor-common.sh" ]]; then
  # shellcheck source=../lib/frp-doctor-common.sh
  . "${_FRPCTL_DIR}/../lib/frp-doctor-common.sh"
elif [[ -f /usr/local/lib/frp-auto-deploy/frp-doctor-common.sh ]]; then
  # shellcheck disable=SC1091
  . /usr/local/lib/frp-auto-deploy/frp-doctor-common.sh
elif [[ -f '/Library/Application Support/frp-auto-deploy/lib/frp-doctor-common.sh' ]]; then
  # shellcheck disable=SC1091
  . '/Library/Application Support/frp-auto-deploy/lib/frp-doctor-common.sh'
fi

frpctl_path() {
  local p="$1"
  local root="${FRP_CTL_TEST_ROOT:-${FRP_CLIENT_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-${FRP_UPDATE_ROOT:-}}}}"
  if declare -F frp_platform_map_path >/dev/null 2>&1; then
    p="$(frp_platform_map_path "$p")"
  fi
  if [[ -n "$root" ]]; then
    printf '%s' "${root}${p}"
  else
    printf '%s' "$p"
  fi
}

frpctl_is_client() {
  if [[ -f "$(frpctl_path /etc/frp/client-state.json)" ]]; then
    return 0
  fi
  if [[ -f "$(frpctl_path /etc/frp/frpc.toml)" && -f "$(frpctl_path /etc/frp/client-identity.key)" ]]; then
    return 0
  fi
  return 1
}

frpctl_is_server() {
  if [[ -f "$(frpctl_path /etc/frp-auto-deploy/config.json)" ]]; then
    return 0
  fi
  if [[ -f "$(frpctl_path /etc/frp/server_token)" && -f "$(frpctl_path /var/lib/frp-auto-deploy/registry.json)" ]]; then
    return 0
  fi
  return 1
}

frpctl_read_kv() {
  local file="$1" key="$2"
  if [[ ! -f "$file" ]]; then
    return 0
  fi
  awk -F= -v k="$key" '$1==k {print substr($0, index($0,"=")+1); exit}' "$file"
}

frpctl_project_version() {
  local pv
  pv="$(frpctl_read_kv "$(frpctl_path /etc/frp-auto-deploy/version)" PROJECT_VERSION)"
  if [[ -z "$pv" ]]; then
    printf '%s' "legacy / unknown"
    return 0
  fi
  printf '%s' "$pv"
}

frpctl_probe_frp_binary_version() {
  local bin="$1" raw parsed
  [[ -x "$bin" ]] || return 1
  raw="$("$bin" --version 2>/dev/null)" || return 1
  parsed="$(python3 - "$raw" <<'PYVER'
import re, sys
raw = sys.argv[1]
if any(ord(ch) < 32 or ord(ch) == 127 for ch in raw):
    raise SystemExit(1)
text = raw.strip()
match = re.fullmatch(
    r'(?:frp[cs]\s+version\s+)?v?([0-9]+(?:\.[0-9]+){1,3}(?:[-+][0-9A-Za-z.-]+)?)',
    text,
    flags=re.IGNORECASE,
)
if not match:
    raise SystemExit(1)
print(match.group(1))
PYVER
)" || return 1
  [[ -n "$parsed" ]] || return 1
  printf '%s' "$parsed"
}

frpctl_binary_frp_version() {
  local server_version="" client_version=""
  if frpctl_is_server; then
    server_version="$(frpctl_probe_frp_binary_version "$(frpctl_path /usr/local/bin/frps)")" || server_version=""
  fi
  if frpctl_is_client; then
    client_version="$(frpctl_probe_frp_binary_version "$(frpctl_path /usr/local/bin/frpc)")" || client_version=""
  fi
  if [[ -n "$server_version" && -n "$client_version" ]]; then
    if [[ "$server_version" == "$client_version" ]]; then
      printf '%s' "$server_version"
    else
      printf 'frps %s / frpc %s' "$server_version" "$client_version"
    fi
    return 0
  fi
  if [[ -n "$server_version" ]]; then
    printf '%s' "$server_version"
    return 0
  fi
  if [[ -n "$client_version" ]]; then
    printf '%s' "$client_version"
    return 0
  fi
  return 1
}

frpctl_frp_version() {
  local fv
  fv="$(frpctl_read_kv "$(frpctl_path /etc/frp-auto-deploy/version)" FRP_VERSION)"
  if [[ -n "$fv" ]]; then
    printf '%s' "$fv"
    return 0
  fi
  fv="$(frpctl_binary_frp_version)" || fv=""
  if [[ -n "$fv" ]]; then
    printf '%s' "$fv"
    return 0
  fi
  printf '%s' "legacy / unknown"
}

frpctl_release_channel() {
  local ch
  ch="$(frpctl_read_kv "$(frpctl_path /etc/frp-auto-deploy/version)" RELEASE_CHANNEL)"
  if [[ -z "$ch" ]]; then
    printf '%s' "unknown"
    return 0
  fi
  printf '%s' "$ch"
}

frpctl_source_ref() {
  local ref
  ref="$(frpctl_read_kv "$(frpctl_path /etc/frp-auto-deploy/version)" SOURCE_REF)"
  if [[ -z "$ref" ]]; then
    printf '%s' "unknown"
    return 0
  fi
  printf '%s' "$ref"
}

frpctl_bundle_sha256() {
  local sha
  sha="$(frpctl_read_kv "$(frpctl_path /etc/frp-auto-deploy/version)" BUNDLE_SHA256)"
  if [[ -z "$sha" ]]; then
    printf '%s' "unknown"
    return 0
  fi
  printf '%s' "$sha"
}

frpctl_role_label() {
  local client=0 server=0
  frpctl_is_client && client=1
  frpctl_is_server && server=1
  if [[ "$client" == "1" && "$server" == "1" ]]; then
    printf '%s' "Client + Server"
  elif [[ "$client" == "1" ]]; then
    printf '%s' "Client"
  elif [[ "$server" == "1" ]]; then
    printf '%s' "Server"
  else
    printf '%s' "unknown"
  fi
}

frpctl_require_install() {
  if frpctl_is_client || frpctl_is_server; then
    return 0
  fi
  echo "ERROR: no FRP Auto Deploy installation was found on this host." >&2
  echo "Install the server or client bootstrap first." >&2
  return 1
}

frpctl_find_cmd() {
  local name="$1" cand
  if [[ -n "${FRP_CTL_BIN_DIR:-}" ]]; then
    cand="${FRP_CTL_BIN_DIR}/${name}"
    if [[ -e "$cand" ]]; then
      printf '%s' "$cand"
      return 0
    fi
  fi
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  for cand in "/usr/local/sbin/${name}" "/usr/local/bin/${name}"; do
    if [[ -x "$cand" ]]; then
      printf '%s' "$cand"
      return 0
    fi
  done
  echo "ERROR: command not found: ${name}" >&2
  echo "This host does not have that frp-auto-deploy command installed." >&2
  return 1
}

frpctl_run() {
  local name="$1"
  shift
  local bin rc
  bin="$(frpctl_find_cmd "$name")" || return 1
  if [[ "${FRP_CTL_DRY_RUN:-}" == "1" ]]; then
    if [[ $# -gt 0 ]]; then
      printf 'DISPATCH %s' "$name"
      printf ' %s' "$@"
      printf '\n'
    else
      printf 'DISPATCH %s\n' "$name"
    fi
    return 0
  fi
  "$bin" "$@"
  rc=$?
  return "$rc"
}

frpctl_exec() {
  local name="$1"
  shift
  local bin
  bin="$(frpctl_find_cmd "$name")" || return 1
  if [[ "${FRP_CTL_DRY_RUN:-}" == "1" ]]; then
    if [[ $# -gt 0 ]]; then
      printf 'DISPATCH %s' "$name"
      printf ' %s' "$@"
      printf '\n'
    else
      printf 'DISPATCH %s\n' "$name"
    fi
    return 0
  fi
  exec "$bin" "$@"
}

# Direct mode may replace the process. Persistent-shell mode must return.
frpctl_invoke() {
  if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
    frpctl_run "$@"
  else
    frpctl_exec "$@"
  fi
}

frpctl_lib_candidate() {
  local name="$1" cand mapped=""
  local -a cands=()
  if declare -F frpctl_path >/dev/null 2>&1; then
    mapped="$(frpctl_path "/usr/local/lib/frp-auto-deploy/${name}")"
  fi
  cands+=("${_FRPCTL_DIR}/../lib/${name}")
  [[ -n "$mapped" ]] && cands+=("$mapped")
  cands+=("/usr/local/lib/frp-auto-deploy/${name}")
  cands+=("/Library/Application Support/frp-auto-deploy/lib/${name}")
  for cand in "${cands[@]}"; do
    [[ -n "$cand" && -f "$cand" ]] || continue
    printf '%s' "$cand"
    return 0
  done
  return 1
}

frpctl_grammar_py() {
  local path
  if path="$(frpctl_lib_candidate frp_ctl_grammar.py)"; then
    printf '%s' "$path"
    return 0
  fi
  echo "ERROR: missing frp_ctl_grammar.py" >&2
  return 1
}

frpctl_repl_py() {
  local path
  if path="$(frpctl_lib_candidate frp_ctl_repl.py)"; then
    printf '%s' "$path"
    return 0
  fi
  return 1
}

frpctl_role_token() {
  local client=0 server=0
  frpctl_is_client && client=1
  frpctl_is_server && server=1
  if [[ "$client" == "1" && "$server" == "1" ]]; then
    printf '%s' "both"
  elif [[ "$client" == "1" ]]; then
    printf '%s' "client"
  elif [[ "$server" == "1" ]]; then
    printf '%s' "server"
  else
    printf '%s' "unknown"
  fi
}

frpctl_grammar_payload() {
  python3 - "$(frpctl_role_token)" "$(frpctl_path /etc/frp-auto-deploy/config.json)" \
    "${FRP_CTL_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-}}" "$(frpctl_path /etc/frp/client-state.json)" \
    "$(frpctl_path /var/lib/frp-auto-deploy/client-draft.json)" <<'PY'
import json, sys
from pathlib import Path
role, cfg_path, root, state_path, draft_path = sys.argv[1:6]
names, services, local_services, local_service_details, clients_meta, groups, profiles = [], {}, [], [], [], [], []
inventory_warning = False
server_role = role in ("server", "both", "dual")
client_role = role in ("client", "both", "dual")
cfg = Path(cfg_path)

def unique_short(mid, mids, n=8):
    text = str(mid)
    length = min(n, len(text)) or 1
    while length <= len(text):
        prefix = text[:length]
        if sum(1 for item in mids if str(item).startswith(prefix)) == 1:
            return prefix
        length += 1
    return text

def service_detail(sid, item):
    if not isinstance(item, dict):
        item = {}
    host = str(item.get("local_ip") or "").strip()
    port = item.get("local_port")
    target = "%s:%s" % (host, port) if host and port is not None else (host or "-")
    enabled = item.get("enabled", True) is not False
    return {
        "id": sid,
        "name": str(item.get("name") or sid),
        "preset": str(item.get("preset") or "custom"),
        "target": target,
        "enabled": enabled,
        "remote_port": item.get("remote_port"),
    }

if server_role and not cfg.is_file():
    inventory_warning = True
if cfg.is_file():
    try:
        data = json.loads(cfg.read_text(encoding="utf-8"))
        reg_raw = str((data or {}).get("registry_file") or "")
        if not reg_raw:
            inventory_warning = True
        reg = Path(reg_raw)
        if root and reg_raw and not str(reg).startswith(root):
            reg = Path(root + str(reg))
        if reg_raw and reg.is_file():
            state = json.loads(reg.read_text(encoding="utf-8"))
            raw_clients = (state or {}).get("clients") or {}
            if not isinstance(raw_clients, dict):
                inventory_warning = True
                raw_clients = {}
            items = [
                (str(mid), client)
                for mid, client in raw_clients.items()
                if isinstance(client, dict)
            ]
            mids = [mid for mid, _client in items]
            raw_groups = (state or {}).get("groups") or {}
            if isinstance(raw_groups, dict):
                for gid, group in raw_groups.items():
                    if isinstance(group, dict):
                        groups.extend([str(gid), str(group.get("name") or "")])
            else:
                inventory_warning = True
            raw_profiles = (state or {}).get("service_profiles") or (state or {}).get("profiles") or {}
            if isinstance(raw_profiles, dict):
                for pid, profile in raw_profiles.items():
                    if isinstance(profile, dict):
                        profiles.extend([str(pid), str(profile.get("name") or "")])
                    else:
                        profiles.append(str(pid))
            for mid, client in items:
                cid = unique_short(mid, mids)
                if not cid or "\n" in cid or "\r" in cid:
                    continue
                names.append(cid)
                label = str(client.get("label") or "").strip()
                host = str(client.get("hostname") or "").strip()
                clients_meta.append({"id": cid, "label": label, "hostname": host})
                sids = []
                for sid in (client.get("services") or {}):
                    sid = str(sid)
                    if sid and "\n" not in sid and "\r" not in sid:
                        sids.append(sid)
                sids = sorted(sids)
                services[cid] = sids
                services[mid] = sids
                if label:
                    services[label] = sids
                if host:
                    services[host] = sids
        elif server_role:
            inventory_warning = True
        # Also try profiles file referenced by config when present.
        prof_raw = str((data or {}).get("profiles_file") or (data or {}).get("service_profiles_file") or "")
        if prof_raw:
            pref = Path(prof_raw)
            if root and not str(pref).startswith(root):
                pref = Path(root + str(pref))
            if pref.is_file():
                try:
                    pdata = json.loads(pref.read_text(encoding="utf-8"))
                    blob = pdata.get("profiles") if isinstance(pdata, dict) else None
                    if isinstance(blob, dict):
                        for pid, profile in blob.items():
                            if isinstance(profile, dict):
                                profiles.extend([str(pid), str(profile.get("name") or "")])
                            else:
                                profiles.append(str(pid))
                except Exception:
                    pass
    except Exception:
        inventory_warning = True
st = Path(state_path)
draft = Path(draft_path)
if client_role and not st.is_file():
    inventory_warning = True
svc_map = {}
if st.is_file():
    try:
        data = json.loads(st.read_text(encoding="utf-8"))
        raw_services = (data or {}).get("services") or {}
        if not isinstance(raw_services, dict):
            inventory_warning = True
        else:
            svc_map = dict(raw_services)
    except Exception:
        inventory_warning = True
if draft.is_file():
    try:
        data = json.loads(draft.read_text(encoding="utf-8"))
        raw_services = (data or {}).get("services") or {}
        if isinstance(raw_services, dict):
            svc_map.update(raw_services)
    except Exception:
        pass
if client_role and svc_map:
    local_services = sorted(str(s) for s in svc_map if s)
    for sid in local_services:
        local_service_details.append(service_detail(sid, svc_map.get(sid) or {}))
json.dump({
    "role": role,
    "names": sorted(set(names)),
    "clients": clients_meta,
    "services": services,
    "local_services": local_services,
    "local_service_details": local_service_details,
    "groups": sorted(set(item for item in groups if item)),
    "profiles": sorted(set(item for item in profiles if item)),
    "inventory_warning": inventory_warning,
    "pending_draft": draft.is_file(),
}, sys.stdout)
PY
}

frpctl_grammar_call() {
  local action="$1"
  shift
  local py extra="{}"
  py="$(frpctl_grammar_py)" || return 1
  if [[ $# -gt 0 ]]; then
    extra="$1"
  fi
  python3 - "$(frpctl_grammar_payload)" "$extra" <<'PY' | python3 "$py" "$action"
import json, sys
base = json.loads(sys.argv[1])
extra = json.loads(sys.argv[2])
base.update(extra)
json.dump(base, sys.stdout)
PY
}

frpctl_usage() {
  cat <<'EOF'
Usage: frpctl [command] [args]

frpctl is the everyday frp-auto-deploy command. For normal operation,
this is the only command you need to remember:

    sudo frpctl

With no arguments and a TTY, that starts the persistent management CLI.
Type '?' for context help, or 'help' for full syntax. Press Tab to complete
a unique match or list next-token candidates. Type 'menu'
for the guided numbered menu.

Canonical grammar:
  <verb> <resource> [target] [property] [value]

  show status | show version | show clients | show client ID
  set client ID label|note VALUE
  set client ID tag KEY VALUE
  unset client ID label|note|tag [KEY]
  create zero-touch | create enrollment | create backup
  revoke client ID | release client ID | release service ID SID
  access | access list | access menu
  update project [--check] | update frp [--check]
  doctor | support-bundle | help | menu | history | exit

status and version remain shortcuts. Older flat commands (clients,
client-set, enroll, ...) still work for scripts. See 'help legacy'.

Official upstream FRP binaries are frps (server) and frpc (client).
This project does not fork FRP.
EOF
}

