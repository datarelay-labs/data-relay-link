    show_enrollments) frpctl_require_server || return 1; frpctl_invoke frp-enrollments ;;
    show_audit) frpctl_require_server || return 1; frpctl_audit_tail ;;
    show_upstream)
      frpctl_require_server || return 1
      frpctl_load_passthrough "$result"
      frpctl_run frp-upstream "${_frpctl_pt[@]}"
      ;;
    show_services) frpctl_require_client || return 1; frpctl_invoke frp-client list ;;
    show_info) frpctl_require_client || return 1; frpctl_invoke frp-client info ;;
    set_client)
      frpctl_require_server || return 1
