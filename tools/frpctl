    delete_group)
      frpctl_require_server || return 1
      _del_group="$(frpctl_json_get "$result" group)"
      frpctl_load_passthrough "$result"
      # Product-owned confirmation. Public --yes (when present) skips the prompt;
      # backend still receives --yes only after confirmation here.
      _del_ans=""
      _del_yes=0
      for _pt in "${_frpctl_pt[@]+"${_frpctl_pt[@]}"}"; do
        [[ "$_pt" == "--yes" ]] && _del_yes=1
      done
      if [[ "$_del_yes" == "1" ]]; then
        _del_ans="y"
      elif [[ -n "${FRP_CTL_TEST_INPUT:-}" || -t 0 ]]; then
        echo
        echo "Delete group \"${_del_group}\"?"
        echo "Group membership is removed. Client identity, services, and ports"
        echo "are not changed."
        _del_ans="$(frpctl_read "Delete group? [y/N]: " "N")" || {
          _FRP_CTL_RC=1
          return 0
        }
      elif IFS= read -r _del_ans; then
        :
      else
        echo "ERROR: deleting a group requires confirmation." >&2
        echo "Run interactively, or pass --yes:" >&2
        echo "  unset group ${_del_group} --yes" >&2
        _FRP_CTL_RC=1
        return 0
      fi
      case "$(printf '%s' "$_del_ans" | tr '[:upper:]' '[:lower:]')" in
        y|yes) ;;
        *)
          echo "Aborted."
          return 0
          ;;
      esac
      frpctl_invoke frp-group-set delete "$_del_group" --yes
      ;;
    delete_profile) frpctl_require_server || return 1; frpctl_invoke frp-profile delete "$(frpctl_json_get "$result" profile)" ;;
    add_group_member)
      frpctl_require_server || return 1
      frpctl_invoke frp-group-set add-member \
        "$(frpctl_json_get "$result" client)" \
        "$(frpctl_json_get "$result" group)"
