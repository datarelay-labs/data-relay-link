  echo "Project version : $(frpctl_project_version)"
  echo "Release channel : $(frpctl_release_channel)"
  echo "Source ref      : $(frpctl_source_ref)"
  echo "FRP version     : $(frpctl_frp_version)"
  echo "Bundle SHA256   : $(frpctl_bundle_sha256)"
}

frpctl_print_catalog_overview() {
  local role="${1:-}"
  local catalog_py catalog_dir=""
  [[ -n "$role" ]] || role="$(frpctl_role_token)"
  if ! catalog_py="$(frpctl_lib_candidate frp_cli_catalog.py)"; then
    return 0
  fi
  catalog_dir="$(dirname "$catalog_py")"
  python3 - "$catalog_dir" "$role" <<'PY' 2>/dev/null || true
import sys
sys.path.insert(0, sys.argv[1])
import frp_cli_catalog as catalog

role = sys.argv[2]
by_category = {}
for name, roles, category, summary in catalog.ROOTS:
    if not catalog.role_allows(roles, role):
        continue
    if name == "client" and not catalog._root_has_commands("client", role):
        continue
    by_category.setdefault(category, []).append((name, summary))
print("Command categories")
print("==================")
for category in catalog.CATEGORY_ORDER:
    rows = by_category.get(category)
    if not rows:
        continue
    print()
    print(category)
    for line in catalog._fmt_rows(rows):
        print(line)
print()
print("Shortcuts")
print("=========")
PY
}

