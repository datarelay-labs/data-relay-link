      frpctl_load_passthrough "$result"
      frpctl_with_pt frpctl_invoke frp-egress add-source \
        "$(frpctl_json_get "$result" profile)" \
        "$(frpctl_json_get "$result" cidr)"
      ;;
    remove_egress_destination)
