  echo
  echo "Create Service Profile"
  echo "======================"
  echo
  echo "Name: $name"
  echo
  echo "Preset:"
  echo "  1) ssh"
  echo "  2) http"
  echo "  3) https"
  echo "  4) custom"
  echo
  preset="$(frpctl_read "Select [1]: " "1")" || return 1
  case "$preset" in
    2) preset=http ;;
    3) preset=https ;;
    4) preset=custom ;;
    *) preset=ssh ;;
  esac
  target_host="$(frpctl_read "Target host [127.0.0.1]: " "127.0.0.1")" || return 1
  [[ -n "$target_host" ]] || target_host=127.0.0.1
  target_port="$(frpctl_read "Target port: " "")" || return 1
  [[ -n "$target_port" ]] || { echo "ERROR: target port is required" >&2; return 1; }
  ssh_user=""
  if [[ "$preset" == "ssh" ]]; then
    ssh_user="$(frpctl_read "SSH user (optional): " "")" || return 1
  fi
  echo
  echo "Review"
  echo "------"
  echo "  name:        $name"
  echo "  preset:      $preset"
  echo "  target-host: $target_host"
  echo "  target-port: $target_port"
  [[ -n "$ssh_user" ]] && echo "  ssh-user:    $ssh_user"
  echo
  confirm="$(frpctl_read "Create profile? [Y/n]: " "Y")" || return 1
  case "$(printf '%s' "$confirm" | tr '[:upper:]' '[:lower:]')" in
    n|no) echo "Cancelled."; return 0 ;;
  esac
  if [[ -n "$ssh_user" ]]; then
    frpctl_invoke frp-profile create "$name" \
      --preset "$preset" \
      --target-host "$target_host" \
      --target-port "$target_port" \
      --ssh-user "$ssh_user"
  else
    frpctl_invoke frp-profile create "$name" \
      --preset "$preset" \
      --target-host "$target_host" \
      --target-port "$target_port"
  fi
}

