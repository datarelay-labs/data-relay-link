# bind -x fallback. Completes unique/common-prefix only. Never prints a list.
# Does not run the command parser/dispatcher.
frpctl_readline_complete() {
  local line="${READLINE_LINE-}"
  local point="${READLINE_POINT-0}"
  local -a cands=()
  local new=""
  if [[ "$point" != "${#line}" ]]; then
    return 0
  fi
  cands=()
  while IFS= read -r _cand; do
    [[ -n "$_cand" ]] && cands+=("$_cand")
  done < <(frpctl_completion_candidates "$line" || true)
  if [[ ${#cands[@]} -eq 0 ]]; then
    return 0
  fi
  new="$(frpctl_complete_line "$line")"
  if [[ "$new" != "$line" ]]; then
    READLINE_LINE="$new"
    READLINE_POINT=${#READLINE_LINE}
  fi
  return 0
}

frpctl_repl_enable_completion() {
  unset HISTFILE
  set -o history 2>/dev/null || true
  _FRP_CTL_BOUND_TAB=""
