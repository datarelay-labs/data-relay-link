frpctl_unset_enrollment() {
  local id="$1" state=""
  [[ -n "$id" ]] || { echo "ERROR: enrollment id required" >&2; return 1; }
  # Tests may force classification without reading secrets.
  if [[ -n "${FRP_ENROLLMENT_STATE:-}" ]]; then
    state="$(printf '%s' "$FRP_ENROLLMENT_STATE" | tr '[:lower:]' '[:upper:]')"
  else
    state="$(frpctl_invoke frp-enrollment-state "$id" 2>/dev/null || true)"
    state="$(printf '%s' "$state" | tr '[:lower:]' '[:upper:]' | tr -d '[:space:]')"
  fi
  case "$state" in
    PENDING|BOUND|ACTIVE|ISSUED)
      echo "Action: Revoke active enrollment"
      frpctl_invoke frp-enrollment-revoke "$id"
      ;;
    EXPIRED|COMPLETED|REVOKED|USED|TERMINAL)
      echo "Action: Delete terminal enrollment metadata"
      frpctl_invoke frp-enrollment-purge enrollment "$id"
      ;;
    *)
      echo "Action: Revoke active enrollment"
      if ! frpctl_invoke frp-enrollment-revoke "$id"; then
        echo "Action: Delete terminal enrollment metadata"
        frpctl_invoke frp-enrollment-purge enrollment "$id"
      fi
      ;;
  esac
}

frpctl_dispatch_canonical() {
  local extra result status action extra_args=""
  _FRP_CTL_RC=0
  extra="$(python3 -c 'import json,sys; print(json.dumps({"tokens":sys.argv[1:]}))' "$@")"
  result="$(frpctl_grammar_call match "$extra")" || return 1
  status="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("status",""))' "$result")"
  case "$status" in
    empty|legacy|unknown)
      return 1
      ;;
    shell)
      frpctl_reject_shell
      _FRP_CTL_RC=$?
      return 0
      ;;
    role)
      echo "ERROR: that command is not available on this host role." >&2
      _FRP_CTL_RC=1
      return 0
      ;;
    incomplete)
      frpctl_print_grammar_help "$(frpctl_json_get "$result" message)"
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        return 0
      fi
      _FRP_CTL_RC=2
      return
      ;;
    error)
      _err_msg="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("message",""))' "$result")"
      _err_code="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("exit_code",1))' "$result")"
      # Option/usage rejections are product-owned (exit 2); never leak backend argparse.
      if [[ "$_err_msg" == *"do not use --options"* ]]; then
        printf '%s\n' "$_err_msg" >&2
        _FRP_CTL_RC=2
      else
        echo "ERROR: ${_err_msg}" >&2
        _FRP_CTL_RC="${_err_code:-1}"
      fi
      return 0
      ;;
    ok)
      ;;
    *)
      return 1
      ;;
  esac
  action="$(frpctl_json_get "$result" action)"
  _FRP_CTL_CANON="$result"
  set +e
  case "$action" in
    show_status)
      frpctl_load_passthrough "$result"
      frpctl_with_pt frpctl_status
      ;;
    show_server_status)
      frpctl_require_server || return 1
      frpctl_load_passthrough "$result"
      frpctl_with_pt frpctl_run frp-server-status
      ;;
    show_version) echo; frpctl_print_version; echo ;;
    show_clients)
