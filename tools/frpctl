# Print matching completion candidates, one per line.
# Preserve grammar order (e.g. zero-touch before enrollment). Deduplicate only.
frpctl_completion_candidates() {
  local line="$1" extra
  extra="$(python3 -c 'import json,sys; print(json.dumps({"line":sys.argv[1]}))' "$line")"
  frpctl_grammar_call complete "$extra" | awk 'NF && !seen[$0]++'
}

frpctl_common_prefix() {
  local prefix="$1"
  shift || true
  local s
  [[ $# -gt 0 ]] || { printf '%s' "$prefix"; return 0; }
  for s in "$@"; do
    while [[ -n "$prefix" && "$s" != "$prefix"* ]]; do
      prefix="${prefix%?}"
    done
  done
  printf '%s' "$prefix"
}

frpctl_line_with_token() {
  local line="$1"
  local token="$2"
  local add_space="${3:-1}"
  local trailing=0 lastc i
  local -a words=()
  local new=""
  if [[ -n "$line" ]]; then
    lastc="${line: -1}"
    if [[ "$lastc" == " " || "$lastc" == $'\t' ]]; then
      trailing=1
    fi
  fi
  if [[ -n "${line//[[:space:]]/}" ]]; then
    IFS=$' \t' read -r -a words <<< "$line" || true
  fi
  if [[ ${#words[@]} -eq 0 || ( ${#words[@]} -eq 1 && "$trailing" == "0" ) ]]; then
    new="$token"
  elif [[ "$trailing" == "1" ]]; then
    new="${line%"${line##*[![:space:]]}"}"
    new="${new} ${token}"
  else
    new="${words[0]}"
    if [[ ${#words[@]} -gt 1 ]]; then
      for (( i=1; i<${#words[@]}-1; i++ )); do
        new+=" ${words[i]}"
      done
      new+=" ${token}"
    fi
  fi
  if [[ "$add_space" == "1" ]]; then
    new+=" "
  fi
  printf '%s' "$new"
}

# Apply unique/common-prefix completion. Prints the resulting line.
frpctl_complete_line() {
  local line="$1" extra
  extra="$(python3 -c 'import json,sys; print(json.dumps({"line":sys.argv[1]}))' "$line")"
  frpctl_grammar_call complete-line "$extra"
}

frpctl_tab_reset() {
  _FRP_CTL_LAST_TAB_LINE=""
  _FRP_CTL_LAST_TAB_POINT=""
  _FRP_CTL_LAST_TAB_CANDIDATES=""
  _FRP_CTL_TAB_REPEAT_COUNT=0
}

# bind -x fallback. Completes unique/common-prefix only. Never prints a list.
# Does not run the command parser/dispatcher.
frpctl_readline_complete() {
  local line="${READLINE_LINE-}"
  local point="${READLINE_POINT-0}"
  local -a cands=()
  local new=""
  if [[ "$point" != "${#line}" ]]; then
    return 0
  fi
  cands=()
  while IFS= read -r _cand; do
    [[ -n "$_cand" ]] && cands+=("$_cand")
  done < <(frpctl_completion_candidates "$line" || true)
  if [[ ${#cands[@]} -eq 0 ]]; then
    return 0
  fi
  new="$(frpctl_complete_line "$line")"
  if [[ "$new" != "$line" ]]; then
    READLINE_LINE="$new"
    READLINE_POINT=${#READLINE_LINE}
  fi
  return 0
}

frpctl_repl_enable_completion() {
  unset HISTFILE
  set -o history 2>/dev/null || true
  _FRP_CTL_BOUND_TAB=""
  # Custom Tab only. If bind -x is unavailable, keep using read without -e so
  # Bash filename completion cannot become the fallback.
  if [[ "${FRP_CTL_DISABLE_TAB:-}" == "1" ]]; then
    return 0
  fi
  if (( BASH_VERSINFO[0] < 4 )); then
    return 0
  fi
  if bind -x '"\t": frpctl_readline_complete' 2>/dev/null; then
    bind 'set disable-completion on' 2>/dev/null || true
    _FRP_CTL_BOUND_TAB=1
  fi
}

frpctl_repl_disable_completion() {
  if [[ "${_FRP_CTL_BOUND_TAB:-}" == "1" ]]; then
    bind -r '\t' 2>/dev/null || true
  fi
  _FRP_CTL_BOUND_TAB=""
}

frpctl_edit_distance() {
  python3 - "$1" "$2" <<'PY'
import sys
a, b = sys.argv[1], sys.argv[2]
la, lb = len(a), len(b)
if abs(la - lb) > 3:
    print(99)
    raise SystemExit(0)
prev = list(range(lb + 1))
for i, ca in enumerate(a, 1):
    cur = [i]
    for j, cb in enumerate(b, 1):
        ins, delete, sub = cur[j - 1] + 1, prev[j] + 1, prev[j - 1] + (ca != cb)
        cur.append(min(ins, delete, sub))
    prev = cur
print(prev[-1])
PY
}

frpctl_suggest() {
  local unknown="$1"
  local cmd dist
  local -a suggestions=()
  [[ -n "$unknown" ]] || return 0
  while IFS= read -r cmd; do
    [[ -n "$cmd" ]] || continue
    [[ "$cmd" != "?" ]] || continue
    if [[ ${#unknown} -ge 3 && "$cmd" == "$unknown"* ]]; then
      suggestions+=("$cmd")
      continue
    fi
    if [[ ${#cmd} -ge 3 && "$unknown" == "$cmd"* ]]; then
      suggestions+=("$cmd")
      continue
    fi
    dist="$(frpctl_edit_distance "$unknown" "$cmd" 2>/dev/null || echo 99)"
    if [[ "$dist" =~ ^[0-9]+$ ]] && [[ "$dist" -ge 1 && "$dist" -le 2 ]]; then
      suggestions+=("$cmd")
    fi
  done < <(frpctl_known_commands | sort -u)
  if [[ ${#suggestions[@]} -eq 0 ]]; then
    return 0
  fi
  echo "Did you mean:"
  local seen="" s
  for s in "${suggestions[@]}"; do
    case " $seen " in
      *" $s "*) continue ;;
    esac
    echo "  $s"
    seen="${seen} ${s}"
  done
  echo
}

frpctl_unknown_command() {
  local cmd="$1"
  if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
    echo "Unknown command: ${cmd}" >&2
    echo >&2
    frpctl_suggest "$cmd" >&2
    echo "Type 'help' for available commands." >&2
    return 0
  fi
  echo "ERROR: unknown command: ${cmd}" >&2
  echo >&2
  frpctl_usage >&2
  return 2
}

frpctl_reject_shell() {
  echo "ERROR: arbitrary shell execution is not allowed." >&2
  echo "frpctl is not a general-purpose shell. Type 'help' for commands." >&2
  if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
    return 0
  fi
  return 2
}

