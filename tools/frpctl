# Read-only hostname list from the local registry. Never prints secret fields.
frpctl_registry_client_names() {
  local cfg root
  cfg="$(frpctl_path /etc/drlink/config.json)"
  root="${FRP_CTL_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-}}"
  python3 - "$cfg" "$root" <<'PY' 2>/dev/null || true
import json, sys
from pathlib import Path
cfg_path = Path(sys.argv[1])
root = sys.argv[2]
if not cfg_path.is_file():
    raise SystemExit(0)
try:
    cfg = json.loads(cfg_path.read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(0)
if not isinstance(cfg, dict):
    raise SystemExit(0)
reg = Path(str(cfg.get('registry_file') or ''))
if not str(reg):
    raise SystemExit(0)
if root and not str(reg).startswith(root):
    reg = Path(root + str(reg))
if not reg.is_file():
    raise SystemExit(0)
try:
    state = json.loads(reg.read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(0)
if not isinstance(state, dict):
    raise SystemExit(0)
items = [
    (str(mid), client)
    for mid, client in (state.get('clients') or {}).items()
    if isinstance(client, dict)
]
mids = [mid for mid, _client in items]

def unique_short(mid, n=8):
    text = str(mid)
    length = min(n, len(text)) or 1
    while length <= len(text):
        prefix = text[:length]
        if sum(1 for item in mids if item.startswith(prefix)) == 1:
            return prefix
        length += 1
    return text

names = []
for mid, _client in items:
    cid = unique_short(mid)
    if cid and '\n' not in cid and '\r' not in cid:
        names.append(cid)
for name in sorted(set(names)):
    print(name)
PY
}

# Read-only service IDs for one client. Never prints secret fields.
frpctl_registry_service_ids() {
  local query="$1"
  local cfg root
  [[ -n "$query" ]] || return 0
  cfg="$(frpctl_path /etc/drlink/config.json)"
  root="${FRP_CTL_TEST_ROOT:-${FRP_DEPLOY_TEST_ROOT:-}}"
  python3 - "$cfg" "$root" "$query" <<'PY' 2>/dev/null || true
import json, sys
from pathlib import Path
cfg_path = Path(sys.argv[1])
root = sys.argv[2]
query = sys.argv[3]
if not cfg_path.is_file():
    raise SystemExit(0)
try:
    cfg = json.loads(cfg_path.read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(0)
if not isinstance(cfg, dict):
    raise SystemExit(0)
reg = Path(str(cfg.get('registry_file') or ''))
if not str(reg):
    raise SystemExit(0)
if root and not str(reg).startswith(root):
    reg = Path(root + str(reg))
if not reg.is_file():
    raise SystemExit(0)
try:
    state = json.loads(reg.read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(0)
if not isinstance(state, dict):
    raise SystemExit(0)
matches = []
for mid, client in (state.get('clients') or {}).items():
    if not isinstance(client, dict):
        continue
    host = str(client.get('hostname') or '')
    label = str(client.get('label') or '')
    if host == query or label == query or mid == query or str(mid).startswith(query):
        matches.append(client)
if len(matches) != 1:
    raise SystemExit(0)
services = matches[0].get('services') or {}
if not isinstance(services, dict):
    raise SystemExit(0)
for sid in sorted(services):
    sid = str(sid)
    if sid and '\n' not in sid and '\r' not in sid:
        print(sid)
PY
}

# Print matching completion candidates, one per line.
# Preserve grammar order (e.g. zero-touch before enrollment). Deduplicate only.
frpctl_completion_candidates() {
  local line="$1" extra
  extra="$(python3 -c 'import json,sys; print(json.dumps({"line":sys.argv[1]}))' "$line")"
  frpctl_grammar_call complete "$extra" | awk 'NF && !seen[$0]++'
}

frpctl_common_prefix() {
  local prefix="$1"
  shift || true
  local s
  [[ $# -gt 0 ]] || { printf '%s' "$prefix"; return 0; }
  for s in "$@"; do
    while [[ -n "$prefix" && "$s" != "$prefix"* ]]; do
      prefix="${prefix%?}"
    done
  done
  printf '%s' "$prefix"
}

frpctl_line_with_token() {
  local line="$1"
  local token="$2"
  local add_space="${3:-1}"
  local trailing=0 lastc i
  local -a words=()
  local new=""
  if [[ -n "$line" ]]; then
    lastc="${line: -1}"
    if [[ "$lastc" == " " || "$lastc" == $'\t' ]]; then
      trailing=1
    fi
  fi
  if [[ -n "${line//[[:space:]]/}" ]]; then
    IFS=$' \t' read -r -a words <<< "$line" || true
  fi
  if [[ ${#words[@]} -eq 0 || ( ${#words[@]} -eq 1 && "$trailing" == "0" ) ]]; then
    new="$token"
  elif [[ "$trailing" == "1" ]]; then
    new="${line%"${line##*[![:space:]]}"}"
    new="${new} ${token}"
  else
    new="${words[0]}"
    if [[ ${#words[@]} -gt 1 ]]; then
      for (( i=1; i<${#words[@]}-1; i++ )); do
        new+=" ${words[i]}"
      done
      new+=" ${token}"
    fi
  fi
  if [[ "$add_space" == "1" ]]; then
    new+=" "
  fi
  printf '%s' "$new"
}

# Apply unique/common-prefix completion. Prints the resulting line.
frpctl_complete_line() {
  local line="$1" extra
  extra="$(python3 -c 'import json,sys; print(json.dumps({"line":sys.argv[1]}))' "$line")"
  frpctl_grammar_call complete-line "$extra"
}

frpctl_tab_reset() {
  _FRP_CTL_LAST_TAB_LINE=""
