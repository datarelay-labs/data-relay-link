      frpctl_invoke frp-egress add-source \
        "$(frpctl_json_get "$result" profile)" \
        "$(frpctl_json_get "$result" cidr)"
      ;;
    remove_egress_destination)
      frpctl_require_server || return 1
      frpctl_invoke frp-egress remove-destination \
        "$(frpctl_json_get "$result" profile)" \
        "$(frpctl_json_get "$result" destination)"
      ;;
    remove_egress_source)
      frpctl_require_server || return 1
      frpctl_invoke frp-egress remove-source \
        "$(frpctl_json_get "$result" profile)" \
        "$(frpctl_json_get "$result" source)"
      ;;
    enable_egress_profile)
      frpctl_require_server || return 1
      frpctl_invoke frp-egress enable "$(frpctl_json_get "$result" profile)"
      ;;
    disable_egress_profile)
      frpctl_require_server || return 1
      frpctl_invoke frp-egress disable "$(frpctl_json_get "$result" profile)"
      ;;
    delete_egress_profile)
      frpctl_require_server || return 1
      frpctl_invoke frp-egress delete "$(frpctl_json_get "$result" profile)"
      ;;
    delete_group) frpctl_require_server || return 1; frpctl_invoke frp-group-set delete "$(frpctl_json_get "$result" group)" ;;
    delete_profile) frpctl_require_server || return 1; frpctl_invoke frp-profile delete "$(frpctl_json_get "$result" profile)" ;;
    add_group_member)
      frpctl_require_server || return 1
      frpctl_invoke frp-group-set add-member \
        "$(frpctl_json_get "$result" client)" \
        "$(frpctl_json_get "$result" group)"
      ;;
    remove_group_member)
      frpctl_require_server || return 1
      frpctl_invoke frp-group-set remove-member \
        "$(frpctl_json_get "$result" client)" \
        "$(frpctl_json_get "$result" group)"
      ;;
    revoke_client)
      frpctl_require_server || return 1
      frpctl_load_passthrough "$result"
      frpctl_invoke frp-revoke-client "$(frpctl_json_get "$result" client)" "${_frpctl_pt[@]}"
      ;;
    revoke_enrollment) frpctl_require_server || return 1; frpctl_invoke frp-enrollment-revoke "$(frpctl_json_get "$result" id)" ;;
    purge_enrollment) frpctl_require_server || return 1; frpctl_invoke frp-enrollment-purge enrollment "$(frpctl_json_get "$result" id)" ;;
    purge_enrollments) frpctl_require_server || return 1; frpctl_invoke frp-enrollment-purge enrollments --older-than "$(frpctl_json_get "$result" older_than)" ;;
    release_client)
      frpctl_require_server || return 1
      frpctl_load_passthrough "$result"
      frpctl_invoke frp-release-client "$(frpctl_json_get "$result" client)" "${_frpctl_pt[@]}"
      ;;
    release_service)
      frpctl_require_server || return 1
      frpctl_load_passthrough "$result"
      frpctl_invoke frp-release-service "$(frpctl_json_get "$result" client)" "$(frpctl_json_get "$result" service)" "${_frpctl_pt[@]}"
      ;;
    update_default)
      frpctl_load_passthrough "$result"
      frpctl_update "${_frpctl_pt[@]}"
      ;;
    update_project)
      frpctl_load_passthrough "$result"
      _frp_up_rc=0
      if frpctl_is_client; then
        frpctl_client_update "${_frpctl_pt[@]}" || _frp_up_rc=$?
      fi
      if frpctl_is_server; then
        frpctl_run frp-project-update "${_frpctl_pt[@]}" || _frp_up_rc=$?
      fi
      if ! frpctl_is_client && ! frpctl_is_server; then
        false
      else
        # Preserve the first failing update status; trailing `if` tests must not
        # mask a non-zero client/server update as success.
        [[ "${_frp_up_rc}" -eq 0 ]]
      fi
      ;;
    update_frp)
      if ! frpctl_is_server && ! frpctl_is_client; then
        frpctl_require_install || return 1
      fi
      frpctl_load_passthrough "$result"
      frpctl_run frp-update "${_frpctl_pt[@]}"
      ;;
    restore_backup) frpctl_require_server || return 1; frpctl_run frp-restore "$(frpctl_json_get "$result" path)" ;;
    doctor)
      if ! type frp_doctor_main >/dev/null 2>&1; then
        echo "ERROR: doctor diagnostics are not installed on this host." >&2
        return 2
      fi
      frpctl_load_passthrough "$result"
      frp_doctor_main "${_frpctl_pt[@]}"
      ;;
    support_bundle)
      frpctl_load_passthrough "$result"
      frpctl_run frp-support-bundle "${_frpctl_pt[@]}"
      ;;
    access_cmd)
      frpctl_require_server || return 1
      frpctl_load_passthrough "$result"
      frpctl_invoke frp-access "${_frpctl_pt[@]}"
      ;;
    egress_cmd)
      frpctl_require_server || return 1
      frpctl_load_passthrough "$result"
      frpctl_invoke frp-egress "${_frpctl_pt[@]}"
      ;;
    help)
      frpctl_load_passthrough "$result"
      # Always render from the command catalog so shell and REPL help stay aligned.
      if ! frpctl_repl_help "${_frpctl_pt[@]}"; then
        frpctl_usage
      fi
      ;;
    menu) frpctl_interactive ;;
    history) frpctl_print_history ;;
    clear) frpctl_clear_screen ;;
    exit)
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        _FRP_CTL_SHOULD_EXIT=1
      fi
      return 0
      ;;
    *)
      set -e
      return 1
      ;;
  esac
  _FRP_CTL_RC=$?
  set -e
  return 0
}


frpctl_set_client_from_canon() {
  local spec="$1" client prop value
  client="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("client",""))' "$spec")"
  prop="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("property",""))' "$spec")"
  value="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("value",""))' "$spec")"
  case "$prop" in
    label) frpctl_invoke frp-client-set "$client" --label "$value" ;;
    note) frpctl_invoke frp-client-set "$client" --note "$value" ;;
    tag) frpctl_invoke frp-client-set "$client" --tag "$value" ;;
    *) echo "ERROR: unknown client setting" >&2; return 1 ;;
  esac
}

frpctl_unset_client_from_canon() {
  local spec="$1" client prop value
  client="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("client",""))' "$spec")"
  prop="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("property",""))' "$spec")"
  value="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("value",""))' "$spec")"
  case "$prop" in
    label) frpctl_invoke frp-client-set "$client" --clear-label ;;
    note) frpctl_invoke frp-client-set "$client" --clear-note ;;
    tag) frpctl_invoke frp-client-set "$client" --remove-tag "$value" ;;
    *) echo "ERROR: unknown client setting" >&2; return 1 ;;
  esac
}

frpctl_dispatch() {
  local cmd="${1:-}"
  _FRP_CTL_RC=0
  if [[ -n "$cmd" ]] && frpctl_dispatch_canonical "$@"; then
    return "${_FRP_CTL_RC:-0}"
  fi
  shift || true
  case "$cmd" in
    -h|--help)
      frpctl_usage
      ;;
    help|'?')
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        frpctl_repl_help "$@"
      else
        if [[ $# -gt 0 ]]; then
          frpctl_repl_help "$@"
        else
          frpctl_usage
        fi
      fi
      ;;
    menu)
      frpctl_interactive
      ;;
    status)
      frpctl_status "$@"
      ;;
    doctor)
      if ! type frp_doctor_main >/dev/null 2>&1; then
        echo "ERROR: doctor diagnostics are not installed on this host." >&2
        return 2
      fi
      frp_doctor_main "$@"
      ;;
    support-bundle)
      frpctl_run frp-support-bundle "$@"
      ;;
    client-status)
      frpctl_require_client || return 1
      frpctl_run frp-client status "$@"
      ;;
    server-status)
      frpctl_require_server || return 1
      frpctl_run frp-server-status "$@"
      ;;
    version)
      echo
      frpctl_print_version
      echo
      ;;
    update)
      frpctl_update "$@"
      ;;
    client-update)
      frpctl_require_client || return 1
      frpctl_client_update "$@"
      ;;
    server-update|frp-update)
      if ! frpctl_is_server && ! frpctl_is_client; then
        frpctl_require_install || return 1
      fi
      frpctl_run frp-update "$@"
      ;;
    project-update)
      frpctl_require_server || return 1
      frpctl_run frp-project-update "$@"
      ;;
    backup)
      frpctl_require_server || return 1
      frpctl_run frp-backup "$@"
      ;;
    restore)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        frpctl_usage_error "restore <backup>"
        return $?
      fi
      frpctl_run frp-restore "$@"
      ;;
    enroll-bulk)
      frpctl_require_server || return 1
      frpctl_invoke frp-enroll-bulk "$@"
      ;;
    enrollments)
      frpctl_require_server || return 1
      frpctl_invoke frp-enrollments "$@"
      ;;
    enrollment-revoke)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        frpctl_usage_error "enrollment-revoke <id>"
        return $?
      fi
      frpctl_invoke frp-enrollment-revoke "$@"
      ;;
    upstream)
      frpctl_require_server || return 1
      frpctl_run frp-upstream "$@"
      ;;
    audit)
      frpctl_require_server || return 1
      frpctl_audit_tail
      ;;
    clear)
      frpctl_clear_screen
      ;;
    exit|quit|q)
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        _FRP_CTL_SHOULD_EXIT=1
        return 0
      fi
      return 0
      ;;
    manage)
      frpctl_require_client || return 1
      frpctl_invoke frp-client "$@"
      ;;
    services)
      frpctl_require_client || return 1
      frpctl_invoke frp-client list "$@"
      ;;
    info)
      frpctl_require_client || return 1
      frpctl_invoke frp-client info "$@"
      ;;
    clients)
      frpctl_require_server || return 1
      frpctl_invoke frp-clients "$@"
      ;;
    enroll|create-client)
      frpctl_require_server || return 1
      frpctl_invoke frp-create-client "$@"
      ;;
    client|client-info)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "$cmd" == "client" ]]; then
          frpctl_usage_error "client <name>"
        else
          frpctl_usage_error "${FRP_CTL_CMD_NAME} client-info <client>"
        fi
        return $?
      fi
      frpctl_invoke frp-client-info "$@"
      ;;
    client-set|edit-client)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
          frpctl_usage_error "client-set <client> [--label NAME] [--note TEXT]"
        else
          frpctl_usage_error "${FRP_CTL_CMD_NAME} client-set <client> [--label NAME] [--note TEXT]"
        fi
        return $?
      fi
      frpctl_invoke frp-client-set "$@"
      ;;
    revoke|revoke-client)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "$cmd" == "revoke" ]]; then
          frpctl_usage_error "revoke <name>"
        else
          frpctl_usage_error "${FRP_CTL_CMD_NAME} revoke-client <client>"
        fi
        return $?
      fi
      frpctl_invoke frp-revoke-client "$@"
      ;;
    release-service)
      frpctl_require_server || return 1
      if [[ $# -lt 2 ]]; then
        if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
          frpctl_usage_error "release-service <client> <service-id>"
        else
          frpctl_usage_error "${FRP_CTL_CMD_NAME} release-service <client> <service-id>"
        fi
        return $?
      fi
      frpctl_invoke frp-release-service "$@"
      ;;
    release-client)
      frpctl_require_server || return 1
      if [[ $# -lt 1 ]]; then
        if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
          frpctl_usage_error "release-client <client>"
        else
          frpctl_usage_error "${FRP_CTL_CMD_NAME} release-client <client>"
        fi
        return $?
      fi
      frpctl_invoke frp-release-client "$@"
      ;;
    shell|exec|bash|sh|system)
      frpctl_reject_shell
      ;;
    '!'*|\!*)
      frpctl_reject_shell
      ;;
    '')
      if [[ "${FRP_CTL_REPL:-}" == "1" ]]; then
        return 0
      fi
      frpctl_repl
      ;;
    *)
      frpctl_unknown_command "$cmd"
      ;;
  esac
}

frpctl_tokenize() {
  local line="$1" py json
  _FRP_CTL_TOKENS=()
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  [[ -n "$line" ]] || return 0
  py="$(frpctl_grammar_py)" || return 1
  json="$(python3 "$py" tokenize "$line")" || return 2
  _FRP_CTL_TOKENS=()
  while IFS= read -r _tok; do
    [[ -n "$_tok" ]] && _FRP_CTL_TOKENS+=("$_tok")
  done < <(python3 -c 'import json,sys; [print(t) for t in json.loads(sys.argv[1])]' "$json")
}

frpctl_history_maybe_record() {
  local line="$1"
  [[ -n "$line" ]] || return 0
  if python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import frp_ctl_grammar as g; raise SystemExit(0 if g.looks_secret(sys.argv[2]) else 1)' \
    "$(dirname "$(frpctl_grammar_py)")" "$line"; then
    return 0
  fi
  _FRP_CTL_SESSION_HIST+=("$line")
  history -s "$line" 2>/dev/null || true
}

frpctl_print_history() {
  local i
  if [[ ${#_FRP_CTL_SESSION_HIST[@]} -eq 0 ]]; then
    echo "(no session history)"
    return 0
  fi
  for i in "${!_FRP_CTL_SESSION_HIST[@]}"; do
    printf '%5s  %s\n' "$((i + 1))" "${_FRP_CTL_SESSION_HIST[$i]}"
  done
}

frpctl_repl_sigint() {
  _FRP_CTL_SIGINT=1
}

frpctl_repl_banner() {
  echo "${FRP_CTL_PRODUCT_NAME}"
  echo "================="
  echo
  echo "Role            : $(frpctl_role_label)"
  echo "Project version : $(frpctl_project_version)"
  echo "Release channel : $(frpctl_release_channel)"
  echo "Source ref      : $(frpctl_source_ref)"
  echo "FRP version     : $(frpctl_frp_version)"
  echo "Bundle SHA256   : $(frpctl_bundle_sha256)"
  echo
  echo "Type '?' for a short command list, or 'help' for full syntax."
  echo "Commands read <resource> <action>, for example: client list"
  echo "Type 'help workflows' for end-to-end examples."
  echo "Press Tab to complete a unique match or list next-token candidates."
  echo "On a server, Tab completes CLIENT IDs and service IDs."
  echo "Type 'menu' for the guided menu."
  echo "Type 'exit' to leave."
  echo
}

frpctl_repl_read_line() {
  _FRP_CTL_LINE=""
  frpctl_input_init
  if [[ -n "${FRP_CTL_TEST_INPUT:-}" ]]; then
    printf '%s' "$FRP_CTL_PROMPT"
    if ! IFS= read -r _FRP_CTL_LINE <&9; then
      return 1
    fi
    printf '%s\n' "$_FRP_CTL_LINE"
    return 0
  fi
  if [[ ! -t 0 ]]; then
    echo "ERROR: interactive ${FRP_CTL_CMD_NAME} requires a TTY." >&2
    echo "Use: ${FRP_CTL_CMD_NAME} <command>" >&2
    return 1
  fi
  if [[ "${_FRP_CTL_BOUND_TAB:-}" == "1" ]]; then
    if ! IFS= read -e -r -p "$FRP_CTL_PROMPT" _FRP_CTL_LINE; then
      return 1
    fi
  else
    # No readline: Tab is a literal character, not filesystem completion.
    printf '%s' "$FRP_CTL_PROMPT"
    if ! IFS= read -r _FRP_CTL_LINE; then
      return 1
    fi
  fi
  return 0
}

frpctl_repl() {
  local rc
  frpctl_require_install || return 1
  if [[ -z "${FRP_CTL_TEST_INPUT:-}" && ! -t 0 ]]; then
    echo "ERROR: interactive ${FRP_CTL_CMD_NAME} requires a TTY." >&2
    echo "Use: ${FRP_CTL_CMD_NAME} <command>" >&2
    return 1
  fi

  # Session history for ↑/↓ only. Never write a history file.
  unset HISTFILE
  set -o history 2>/dev/null || true
  set +o histexpand 2>/dev/null || true
  _FRP_CTL_SESSION_HIST=()
  FRP_CTL_REPL=1
  _FRP_CTL_SHOULD_EXIT=0
  _FRP_CTL_SIGINT=0
  _FRP_CTL_BOUND_TAB=""
  frpctl_tab_reset
  trap 'frpctl_repl_sigint' INT

  if [[ -z "${FRP_CTL_TEST_INPUT:-}" && -t 0 && "${FRP_CTL_DISABLE_TAB:-}" != "1" ]]; then
    if _FRP_CTL_REPL_PY="$(frpctl_repl_py 2>/dev/null)" && python3 -c 'import readline' 2>/dev/null; then
      _FRP_CTL_BOUND_TAB=1
      frpctl_repl_banner
      FRP_CTL_GRAMMAR_PAYLOAD="$(frpctl_grammar_payload)" \
        FRPCTL_BIN="${BASH_SOURCE[0]}" \
        PYTHONUNBUFFERED=1 \
        python3 -u "$_FRP_CTL_REPL_PY" --frpctl "${BASH_SOURCE[0]}"
      trap - INT
      FRP_CTL_REPL=0
      return 0
    fi
    frpctl_repl_enable_completion
  fi

  frpctl_repl_banner

  while true; do
    _FRP_CTL_SIGINT=0
    _FRP_CTL_LINE=""
    if ! frpctl_repl_read_line; then
      if [[ "${_FRP_CTL_SIGINT}" == "1" ]]; then
        echo
        continue
      fi
      echo
      break
    fi
    if [[ "${_FRP_CTL_SIGINT}" == "1" ]]; then
      echo
      continue
    fi
    if ! frpctl_tokenize "$_FRP_CTL_LINE"; then
      echo "ERROR: could not parse command line." >&2
      continue
    fi
    if [[ ${#_FRP_CTL_TOKENS[@]} -eq 0 ]]; then
      continue
    fi
    frpctl_history_maybe_record "$_FRP_CTL_LINE"
    case "${_FRP_CTL_TOKENS[0]}" in
      '!'*|shell|exec|bash|sh|system)
        frpctl_reject_shell || true
        continue
        ;;
    esac
    rc=0
    frpctl_dispatch "${_FRP_CTL_TOKENS[@]}" || rc=$?
    if [[ "${_FRP_CTL_SHOULD_EXIT}" == "1" ]]; then
      break
    fi
    if [[ "$rc" -ne 0 && "$rc" -ne 130 ]]; then
      echo
      echo "Command failed with exit code ${rc}."
      echo
    fi
  done

  trap - INT
  frpctl_repl_disable_completion
  frpctl_input_cleanup
  FRP_CTL_REPL=0
  return 0
}

frpctl_main() {
  local cmd="${1:-}"
  case "$cmd" in
    --print-grammar-payload)
      unset FRP_CTL_GRAMMAR_PAYLOAD
      frpctl_grammar_payload
      printf '\n'
      ;;
    '')
      frpctl_repl
      ;;
    *)
      frpctl_dispatch "$@"
      ;;
  esac
}

if [[ "${FRP_CTL_SOURCED:-}" != "1" ]]; then
  frpctl_main "$@"
fi
