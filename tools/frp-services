#!/usr/bin/env python3
"""Global server/operator service inventory (drlink service list)."""
import importlib.util
import json
import os
import sys
from pathlib import Path

ROOT = os.environ.get('FRP_DEPLOY_TEST_ROOT', '')
CFG = Path(ROOT + '/etc/drlink/config.json')


def load_mod(name, rel):
    here = Path(__file__).resolve()
    candidates = [
        here.parent.parent / 'lib' / rel,
        Path('/usr/local/lib/drlink') / rel,
    ]
    if ROOT:
        candidates.insert(1, Path(ROOT) / 'usr/local/lib/drlink' / rel)
    for path in candidates:
        if path.is_file():
            spec = importlib.util.spec_from_file_location(name, str(path))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            return mod
    return None


CREG = load_mod('frp_client_registry', 'frp_client_registry.py')
ACL = load_mod('frp_access_control', 'frp_access_control.py')
if CREG is None:
    raise SystemExit('ERROR: missing frp_client_registry.py')


def require_v2(state):
    if not isinstance(state, dict) or state.get('schema_version') != 2:
        raise SystemExit('ERROR: unsupported registry schema version')


cfg = json.loads(CFG.read_text())
reg = Path(cfg['registry_file'])
if ROOT and not str(reg).startswith(ROOT):
    reg = Path(ROOT + str(reg))
if not reg.exists():
    print('ERROR: registry.json is missing (authoritative registry state required)', file=sys.stderr)
    raise SystemExit(1)
state = json.loads(reg.read_text())
require_v2(state)

access_state = None
access_status = 'unavailable'
if ACL is not None:
    access_state, access_status = ACL.try_load_access_state_for_display(cfg=cfg)

public_ip = CREG.sanitize_display(cfg.get('public_ip') or cfg.get('public_host') or '', 253)
public_hostname = CREG.sanitize_display(cfg.get('public_hostname') or '', 253)
access_host = public_hostname or public_ip
clients = CREG.sorted_clients(state)
all_mids = [mid for mid, _client in clients]
snapshot = CREG.passive_listening_ports()

print(
    '%-10s %-10s %-22s %-18s %-10s %s'
    % ('CLIENT', 'SERVICE', 'PUBLIC ENDPOINT', 'ACCESS', 'STATE', 'PORT STATE')
)
print('-' * 92)

rows = 0
for mid, client in clients:
    short = CREG.sanitize_display(CREG.unique_short_id(mid, all_mids), 10)
    services = client.get('services') or {}
    if not isinstance(services, dict) or not services:
        continue
    for sid, svc in sorted(
        services.items(),
        key=lambda kv: (kv[1].get('remote_port') or 0, kv[0]) if isinstance(kv[1], dict) else (0, kv[0]),
    ):
        if not isinstance(svc, dict):
            continue
        remote_port = svc.get('remote_port') or '-'
        endpoint = '%s:%s' % (access_host or 'host', remote_port)
        if ACL is None:
            access = 'ACCESS ERROR'
        else:
            access = ACL.format_service_access_display(access_state, access_status, mid, sid)
        enabled = svc.get('enabled', True) is not False
        if not enabled:
            runtime_state, port_state = 'DISABLED', 'RESERVED'
        else:
            port_listen = CREG.passive_port_state(remote_port, snapshot)
            if port_listen == 'online':
                runtime_state, port_state = 'ONLINE', 'ACTIVE'
            elif port_listen == 'offline':
                runtime_state, port_state = 'OFFLINE', 'ACTIVE'
            else:
                runtime_state, port_state = 'UNKNOWN', 'ACTIVE'
        print(
            '%-10s %-10s %-22s %-18s %-10s %s'
            % (
                short,
                CREG.sanitize_display(sid, 10),
                CREG.sanitize_display(endpoint, 22),
                CREG.sanitize_display(access, 18),
                runtime_state,
                port_state,
            )
        )
        rows += 1

if rows == 0:
    print('(none)')
