.frp-compat-stage/

# Generated at release time from the checked-out release commit. A committed
# SBOM cannot record the hash of the commit that contains it, and checksumming
# it into SHA256SUMS (which the SBOM itself inventories) is circular.
# Produced by ./scripts/build-release-artifacts.sh and attested in CI.
dist/sbom.spdx.json

# Local test dependency venv (official MCP SDK interop; see tests/ensure-mcp-sdk-venv.sh)
.venv/

# Runtime Real E2E / overnight validation output (harness source stays in tests/)
e2e-reports/
OVERNIGHT_*.md

# Runtime-generated secrets, configs, and allocator state
server_token
install_key
registry.json
access-info.txt
frpc.toml
frps.toml
frps.toml.pre-drlink-*
# Historical pre-rename migration artifacts remain ignored.
frps.toml.pre-frp-auto-deploy-*
registry.json.pre-frp-auto-deploy-*
!server/config.example.json
