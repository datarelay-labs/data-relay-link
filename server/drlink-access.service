[Unit]
Description=Data Relay Link Access Control Plugin
After=network-online.target
Wants=network-online.target
Before=drlink-server.service

[Service]
Type=simple
RuntimeDirectory=drlink
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/lib/drlink/frp-access-plugin.py --config /etc/drlink/config.json
Restart=always
RestartSec=2
User=root
Group=root
# Hardening below requires systemd 232+. The installer strips these lines on
# older systemd (Amazon Linux 2 is 219) rather than failing unit load.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/drlink /var/log/drlink /etc/drlink /etc/frp

[Install]
WantedBy=multi-user.target
