[Unit]
Description=Data Relay Controlled Egress Gateway (HTTP/HTTPS forward proxy)
After=network-online.target
Wants=network-online.target
# Isolated from inbound FRP: failure must not stop frps.

[Service]
Type=simple
RuntimeDirectory=frp-auto-deploy
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/lib/frp-auto-deploy/frp-egress-gateway.py --config /etc/frp-auto-deploy/config.json
Restart=always
RestartSec=2
User=root
Group=root
# Hardening below requires systemd 232+. The installer strips these lines on
# older systemd (Amazon Linux 2 is 219) rather than failing unit load.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/frp-auto-deploy /var/log/frp-auto-deploy /run/frp-auto-deploy /etc/frp-auto-deploy /etc/frp
# Outbound TCP to approved Internet destinations.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
