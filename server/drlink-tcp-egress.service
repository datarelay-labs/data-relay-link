[Unit]
Description=Data Relay Link Fixed TCP Egress
After=network-online.target
Wants=network-online.target
# Isolated from inbound FRP: failure must not stop drlink-server.

[Service]
Type=simple
RuntimeDirectory=drlink/tcp-egress
RuntimeDirectoryMode=0700
# Sibling units set /run/drlink to 0700 and clear ACLs. Restore traverse-only
# 0710 root:drlink-egress on the runtime and log parents (not world 0755).
# Child mode cannot fix a non-traversable parent. PermissionsStartOnly keeps
# this repair as root on systemd 219 and newer.
PermissionsStartOnly=true
ExecStartPre=/bin/sh -c 'g=drlink-egress; id "$g" >/dev/null 2>&1 || exit 0; getent group "$g" >/dev/null 2>&1 || exit 0; for d in /run/drlink /var/log/drlink; do if [ ! -d "$d" ]; then mkdir -p "$d"; fi; chown root:"$g" "$d"; chmod 0710 "$d"; done; mkdir -p /var/log/drlink/egress /run/drlink/egress; chown root:"$g" /var/log/drlink/egress; chmod 0770 /var/log/drlink/egress; chown "$g":"$g" /run/drlink/egress; chmod 0700 /run/drlink/egress'
ExecStart=/usr/bin/python3 /usr/local/lib/drlink/drlink-tcp-egress.py --config /etc/drlink/config.json
Restart=always
RestartSec=2
User=drlink-egress
Group=drlink-egress
# Hardening below requires systemd 232+. The installer strips these lines on
# older systemd (Amazon Linux 2 is 219) rather than failing unit load.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/drlink/egress /run/drlink/tcp-egress
ReadOnlyPaths=/etc/drlink/config.json /var/lib/drlink/drlink.db /var/lib/drlink/drlink.db-wal /var/lib/drlink/drlink.db-shm /var/lib/drlink/runtime
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
