[Unit]
Description=Data Relay Link Fixed TCP Egress
After=network-online.target
Wants=network-online.target
# Isolated from inbound FRP: failure must not stop drlink-server.

[Service]
Type=simple
RuntimeDirectory=drlink/tcp-egress
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 /usr/local/lib/drlink/drlink-tcp-egress.py --config /etc/drlink/config.json
Restart=always
RestartSec=2
User=drlink-egress
Group=drlink-egress
# Hardening below requires systemd 232+. The installer strips these lines on
# older systemd (Amazon Linux 2 is 219) rather than failing unit load.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/drlink/egress /run/drlink/tcp-egress
ReadOnlyPaths=/etc/drlink/config.json /var/lib/drlink/drlink.db /var/lib/drlink/drlink.db-wal /var/lib/drlink/drlink.db-shm /var/lib/drlink/runtime
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
