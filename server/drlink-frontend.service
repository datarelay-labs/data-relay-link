[Unit]
Description=Data Relay Link HTTPS/WSS frontend
After=network-online.target drlink-server.service drlink-allocator.service
Wants=network-online.target drlink-server.service drlink-allocator.service

[Service]
Type=simple
# Runs as root (no User=) so the 0600 project TLS key stays non-world-readable.
# This unit uses a project-owned config and does not take over distro nginx.service.
RuntimeDirectory=drlink/frontend
RuntimeDirectoryMode=0700
# RuntimeDirectoryMode=0700 resets /run/drlink. Restore drlink-egress traverse
# on the runtime and log parents (0710, not world 0755) after that reset.
ExecStartPre=/bin/sh -c 'g=drlink-egress; id "$g" >/dev/null 2>&1 || exit 0; getent group "$g" >/dev/null 2>&1 || exit 0; for d in /run/drlink /var/log/drlink; do if [ ! -d "$d" ]; then mkdir -p "$d"; fi; chown root:"$g" "$d"; chmod 0710 "$d"; done; mkdir -p /var/log/drlink/egress /run/drlink/egress; chown root:"$g" /var/log/drlink/egress; chmod 0770 /var/log/drlink/egress; chown "$g":"$g" /run/drlink/egress; chmod 0700 /run/drlink/egress'
ExecStart=/usr/sbin/nginx -c /etc/drlink/frontend.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
# Hardening below requires systemd 232+. The installer strips these lines on
# older systemd (Amazon Linux 2 is 219) rather than failing unit load.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/drlink /var/log/drlink /etc/drlink

[Install]
WantedBy=multi-user.target
